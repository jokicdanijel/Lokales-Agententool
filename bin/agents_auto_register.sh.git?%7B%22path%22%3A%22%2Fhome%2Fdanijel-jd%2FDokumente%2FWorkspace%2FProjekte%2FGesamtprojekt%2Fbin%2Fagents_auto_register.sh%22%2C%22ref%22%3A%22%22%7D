#!/usr/bin/env bash
set -euo pipefail

# Auto-register all available agents with the dashboard
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Source token
if [[ ! -f "$ROOT/.env" ]]; then
    echo "Error: .env file not found. Run bin/env_bootstrap.sh first."
    exit 1
fi

TOK=$(cat "$ROOT/.env")

# Dashboard endpoint
DASHBOARD_URL="http://127.0.0.1:12349"

# Agent definitions
declare -A AGENTS=(
    ["opena1"]="12344"
    ["opena2"]="12345" 
    ["kordp"]="12346"
    ["opena3"]="8080"
)

echo "Auto-registering agents with dashboard..."

for agent_id in "${!AGENTS[@]}"; do
    port="${AGENTS[$agent_id]}"
    endpoint="http://127.0.0.1:$port"
    
    # Check if agent is running
    if ! curl -s --connect-timeout 2 "$endpoint/health" > /dev/null 2>&1; then
        echo "⚠️  $agent_id ($endpoint) - not running, skipping"
        continue
    fi
    
    # Register agent
    response=$(curl -s -w "%{http_code}" \
        -H "Authorization: Bearer $TOK" \
        -H "Content-Type: application/json" \
        -X POST \
        -d "{\"agent_id\":\"$agent_id\",\"endpoint\":\"$endpoint\"}" \
        "$DASHBOARD_URL/api/agent/register" \
        -o /tmp/register_response.json)
    
    http_code="${response: -3}"
    
    if [[ "$http_code" == "200" ]]; then
        echo "✅ $agent_id registered successfully"
    else
        echo "❌ $agent_id registration failed (HTTP $http_code)"
        if [[ -f /tmp/register_response.json ]]; then
            cat /tmp/register_response.json
            echo
        fi
    fi
done

echo "Registration complete. Use 'bin/ops.sh status' to verify."