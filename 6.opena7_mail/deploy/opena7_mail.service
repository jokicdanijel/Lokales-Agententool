[Unit]
Description=opena7 Mail Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/opena7
Environment="PATH=/opt/opena7/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="OPENA7_PORT=12350"
Environment="OPENA1_URL=http://127.0.0.1:12344"
Environment="OPENA2_URL=http://127.0.0.1:12345"
Environment="LOG_LEVEL=INFO"
ExecStart=/opt/opena7/venv/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 12350
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opena7

[Install]
WantedBy=multi-user.target
