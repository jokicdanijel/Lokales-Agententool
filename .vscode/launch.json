{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dashboard (main_dashboard.py)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/19.dashboard_agent/main_dashboard.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "LOG_LEVEL": "INFO"
      },
      "args": ["--port", "12349"]
    },
    {
      "name": "Agent opena1 (Coordinator)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/3.opena1_coordinator/main.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "AGENT_ID": "opena1",
        "PORT": "12344",
        "LOG_LEVEL": "INFO",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "cwd": "${workspaceFolder}/3.opena1_coordinator"
    },
    {
      "name": "Agent opena2 (Archivator)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/4.opena2_archivator/main.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "AGENT_ID": "opena2",
        "PORT": "12345",
        "LOG_LEVEL": "INFO",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "cwd": "${workspaceFolder}/4.opena2_archivator"
    },
    {
      "name": "Agent kordp (Scheduler)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/5.kordp_scheduler/main.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "AGENT_ID": "kordp",
        "PORT": "12346",
        "LOG_LEVEL": "INFO",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "cwd": "${workspaceFolder}/5.kordp_scheduler"
    },
    {
      "name": "OpenWebUI (Port 3000)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/2.openwebui/openwebui_server.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "OPENWEBUI_HOST": "0.0.0.0",
        "OPENWEBUI_PORT": "3000",
        "LOG_LEVEL": "INFO",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "cwd": "${workspaceFolder}/2.openwebui"
    }
  ],
  "compounds": [
    {
      "name": "Start: Alle Services",
      "configurations": [
        "Dashboard (main_dashboard.py)",
        "Agent opena1 (Coordinator)",
        "Agent opena2 (Archivator)",
        "Agent kordp (Scheduler)",
        "OpenWebUI (Port 3000)"
      ],
      "stopAll": true
    },
    {
      "name": "Start: Core Services Only",
      "configurations": [
        "Dashboard (main_dashboard.py)",
        "Agent opena1 (Coordinator)",
        "Agent opena2 (Archivator)",
        "Agent kordp (Scheduler)"
      ],
      "stopAll": true
    }
  ]
}
