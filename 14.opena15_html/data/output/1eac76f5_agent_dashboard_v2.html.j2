<!DOCTYPE html>

<html lang="de">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Homepage Creator Dashboard</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
<style>
        :root { --primary: #667eea; --secondary: #764ba2; }
        body {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            min-height: 100vh;
            padding: 40px 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .main-card {
            background: white;
            border-radius: 25px;
            box-shadow: 0 25px 70px rgba(0,0,0,0.35);
            padding: 50px;
            margin-bottom: 30px;
        }
        .agent-icon {
            font-size: 6em;
            margin-bottom: 20px;
            animation: float 3s ease-in-out infinite;
        }
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        .agent-title {
            color: var(--primary);
            font-size: 3.5em;
            font-weight: 900;
            margin-bottom: 15px;
            text-shadow: 3px 3px 6px rgba(0,0,0,0.1);
        }
        .section-card {
            background: linear-gradient(145deg, #f8f9fa, #ffffff);
            border-left: 6px solid var(--primary);
            padding: 30px;
            border-radius: 15px;
            margin: 25px 0;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }
        .section-card h3 {
            color: var(--primary);
            font-weight: bold;
            margin-bottom: 25px;
            font-size: 1.8em;
        }
        .feature-list {
            list-style: none;
            padding: 0;
        }
        .feature-list li {
            padding: 15px 0;
            border-bottom: 2px solid #e9ecef;
            font-size: 1.1em;
            display: flex;
            align-items: center;
        }
        .feature-list li:before {
            content: "✓";
            color: var(--primary);
            font-weight: bold;
            font-size: 1.8em;
            margin-right: 20px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .status-dot {
            display: inline-block;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            margin-right: 12px;
            animation: pulse-dot 2s infinite;
        }
        .status-online { background: #10b981; }
        .status-offline { background: #ef4444; }
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.6; transform: scale(1.1); }
        }
        .btn-primary-custom {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            color: white;
            padding: 18px 45px;
            border-radius: 50px;
            font-weight: bold;
            font-size: 1.2em;
            transition: all 0.4s ease;
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        }
        .btn-primary-custom:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 15px 35px rgba(102, 126, 234, 0.5);
            color: white;
        }
        .info-badge {
            background: var(--primary);
            color: white;
            padding: 10px 18px;
            border-radius: 25px;
            font-family: 'Courier New', monospace;
            font-size: 1em;
            font-weight: bold;
            margin: 8px 5px;
            display: inline-block;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
        .api-endpoint {
            background: #2d3748;
            color: #48bb78;
            padding: 12px 20px;
            border-radius: 10px;
            font-family: 'Courier New', monospace;
            margin: 10px 0;
            border-left: 4px solid #48bb78;
        }
        
        /* ===== OpenAI Key Panel Styles ===== */
        .api-key-card {
            background: linear-gradient(145deg, #fef3c7, #fde68a);
            border-left: 6px solid #f59e0b;
        }
        .api-key-card .card-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.5em;
        }
        .api-key-card .badge {
            padding: 8px 16px;
            font-size: 0.9em;
        }
        .api-key-card .badge[data-status="active"] {
            background: #10b981;
            color: white;
        }
        .api-key-card .badge[data-status="paused"] {
            background: #f59e0b;
            color: white;
        }
        .api-key-card .badge[data-status="none"] {
            background: #6b7280;
            color: white;
        }
        .settings-grid {
            display: grid;
            gap: 20px;
        }
        .field label {
            font-weight: 600;
            color: #374151;
            display: block;
            margin-bottom: 8px;
        }
        .field input, .field textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            font-family: 'Courier New', monospace;
        }
        .field input:focus, .field textarea:focus {
            outline: none;
            border-color: var(--primary);
        }
        .field small {
            display: block;
            margin-top: 6px;
            color: #6b7280;
        }
        .btn-icon {
            background: none;
            border: none;
            font-size: 1.2em;
            cursor: pointer;
            padding: 8px;
        }
        .settings-footer {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 2px solid #e5e7eb;
        }
        .mono {
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            color: #6b7280;
        }
    </style>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/></head>
