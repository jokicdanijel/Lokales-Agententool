<!DOCTYPE html>

<html lang="de">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Browser Agent Dashboard</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
<style>
        :root { --primary: #667eea; --secondary: #764ba2; }
        body {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            min-height: 100vh;
            padding: 40px 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .main-card {
            background: white;
            border-radius: 25px;
            box-shadow: 0 25px 70px rgba(0,0,0,0.35);
            padding: 50px;
            margin-bottom: 30px;
        }
        .agent-icon {
            font-size: 6em;
            margin-bottom: 20px;
            animation: float 3s ease-in-out infinite;
        }
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        .agent-title {
            color: var(--primary);
            font-size: 3.5em;
            font-weight: 900;
            margin-bottom: 15px;
            text-shadow: 3px 3px 6px rgba(0,0,0,0.1);
        }
        .section-card {
            background: linear-gradient(145deg, #f8f9fa, #ffffff);
            border-left: 6px solid var(--primary);
            padding: 30px;
            border-radius: 15px;
            margin: 25px 0;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }
        .section-card h3 {
            color: var(--primary);
            font-weight: bold;
            margin-bottom: 25px;
            font-size: 1.8em;
        }
        .feature-list {
            list-style: none;
            padding: 0;
        }
        .feature-list li {
            padding: 15px 0;
            border-bottom: 2px solid #e9ecef;
            font-size: 1.1em;
            display: flex;
            align-items: center;
        }
        .feature-list li:before {
            content: "✓";
            color: var(--primary);
            font-weight: bold;
            font-size: 1.8em;
            margin-right: 20px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .status-dot {
            display: inline-block;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            margin-right: 12px;
            animation: pulse-dot 2s infinite;
        }
        .status-online { background: #10b981; }
        .status-offline { background: #ef4444; }
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.6; transform: scale(1.1); }
        }
        .btn-primary-custom {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            color: white;
            padding: 18px 45px;
            border-radius: 50px;
            font-weight: bold;
            font-size: 1.2em;
            transition: all 0.4s ease;
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        }
        .btn-primary-custom:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 15px 35px rgba(102, 126, 234, 0.5);
            color: white;
        }
        .info-badge {
            background: var(--primary);
            color: white;
            padding: 10px 18px;
            border-radius: 25px;
            font-family: 'Courier New', monospace;
            font-size: 1em;
            font-weight: bold;
            margin: 8px 5px;
            display: inline-block;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
        .api-endpoint {
            background: #2d3748;
            color: #48bb78;
            padding: 12px 20px;
            border-radius: 10px;
            font-family: 'Courier New', monospace;
            margin: 10px 0;
            border-left: 4px solid #48bb78;
        }
    </style>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/></head>
<body>
<div class="container">
<div class="main-card text-center">
<div class="agent-icon">🤖</div>
<h1 class="agent-title">Browser Agent</h1>
<p class="lead text-muted fs-4">opena6 ist ein FastAPI-basierter Agent zur automatisierten Web-Automation. Er führt Browser-Playbooks deterministisch aus, archiviert alle Artefakte (Screenshots, HTML, HAR, PDFs) und unterliegt strikten Compliance-Kontrollen (Domain-Allowlist, robots.txt-Beachtung, Rate-Limiting).</p>
<div class="mt-4">
<span class="status-dot status-offline" id="statusDot"></span>
<span class="fw-bold fs-5" id="statusText">Status wird geprüft...</span>
</div>
</div>
<div class="row">
<div class="col-lg-6">
<div class="main-card">
<div class="section-card">
<h3>📋 Agent-Details</h3>
<table class="table table-borderless fs-5">
<tr>
<td class="fw-bold">Agent-ID:</td>
<td><code class="fs-5">opena6</code></td>
</tr>
<tr>
<td class="fw-bold">Kürzel:</td>
<td><code class="fs-5">browsep</code></td>
</tr>
<tr>
<td class="fw-bold">Port:</td>
<td><code class="fs-5">12352</code></td>
</tr>
<tr>
<td class="fw-bold">Health-URL:</td>
<td><code class="fs-6">http://127.0.0.1:12352/health</code></td>
</tr>
</table>
</div>
</div>
</div>
<div class="col-lg-6">
<div class="main-card">
<div class="section-card">
<h3>⚡ Kernfunktionen</h3>
<ul class="feature-list">
<li>- 🎬 Playwright-basierte Browser-Automation (Chromium, Firefox, WebKit)</li>
<li>🔐 Domain-Allowlist + robots.txt-Enforcement</li>
<li>📦 Artifact-Capture (Screenshots, HTML, HAR, PDFs)</li>
<li>♻️ Deterministische Playbook-Ausführung (wiederholbar)</li>
<li>Prometheus-Metriken + strukturierte JSONL-Logs</li>
</ul>
</div>
</div>
</div>
</div>
<div class="main-card">
<div class="section-card">
<h3>🔗 API-Endpoints</h3>
<div class="mt-3">
<span class="info-badge">GET /health</span>
<span class="info-badge">POST /command</span>
<span class="info-badge">GET /</span>
</div>
<div class="mt-4">
<div class="api-endpoint">
<strong>GET</strong> http://127.0.0.1:12352/health
                    </div>
<div class="api-endpoint">
<strong>POST</strong> http://127.0.0.1:12352/command
                    </div>
</div>
</div>
</div>
<div class="main-card">
<h3 class="mb-4">📊 Live Health Status</h3>
<div class="alert alert-info fs-5" id="healthOutput">
                Klicke auf "Status prüfen" um Live-Daten zu laden
            </div>
<button class="btn btn-primary-custom w-100" onclick="checkHealth()">
                🔄 Status prüfen
            </button>
</div>
<div class="text-center mt-5">
<a class="btn btn-secondary btn-lg px-5 py-3" href="http://127.0.0.1:12349/">
                ← Zurück zum Haupt-Dashboard
            </a>
</div>
</div>
<script>
        async function checkHealth() {
            const statusDot = document.getElementById('statusDot');
            const statusText = document.getElementById('statusText');
            const output = document.getElementById('healthOutput');

            statusText.textContent = 'Prüfe Status...';
            output.className = 'alert alert-warning fs-5';
            output.textContent = 'Verbinde mit Agent...';

            try {
                const response = await fetch('http://127.0.0.1:12352/health');

                if (response.ok) {
                    const data = await response.json();
                    statusDot.className = 'status-dot status-online';
                    statusText.textContent = '✅ Online & Erreichbar';
                    output.className = 'alert alert-success fs-5';
                    output.innerHTML = '<h5 class="mb-3">✅ Agent antwortet!</h5><pre class="bg-dark text-light p-3 rounded">' +
                                      JSON.stringify(data, null, 2) + '</pre>';
                } else {
                    throw new Error('HTTP ' + response.status);
                }
            } catch (error) {
                statusDot.className = 'status-dot status-offline';
                statusText.textContent = '❌ Offline / Nicht erreichbar';
                output.className = 'alert alert-danger fs-5';
                output.innerHTML = '<h5>❌ Agent antwortet nicht</h5><p class="mb-0">Fehler: ' + error.message + '</p>' +
                                  '<p class="mt-3 mb-0"><small>Stelle sicher dass der Agent läuft: <code>./bin/start_opena6.sh</code></small></p>';
            }
        }

        window.addEventListener('load', checkHealth);
    </script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
