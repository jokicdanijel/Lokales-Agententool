<script>
    (function () {
        "use strict";

        // ===== OpenAI API Key – State & Storage =====
        const agentSlug = document.body.dataset.agentSlug || "unknown";
        const KEY_STORAGE_KEY = `opena_${agentSlug}_openai_api_key`;
        const STATUS_STORAGE_KEY = `opena_${agentSlug}_openai_api_key_status`;

        const elsOpenAI = {
            input: document.getElementById("openaiKeyInput"),
            toggleVisibility: document.getElementById("openaiKeyToggleVisibility"),
            saveBtn: document.getElementById("openaiKeySaveBtn"),
            togglePauseBtn: document.getElementById("openaiKeyTogglePauseBtn"),
            deleteBtn: document.getElementById("openaiKeyDeleteBtn"),
            statusBadge: document.getElementById("openaiKeyStatusBadge"),
            info: document.getElementById("openaiKeyInfo"),
        };

        function loadOpenAIState() {
            let key = null;
            let status = "none";
            try {
                key = window.localStorage.getItem(KEY_STORAGE_KEY);
                status = window.localStorage.getItem(STATUS_STORAGE_KEY) || "none";
            } catch (e) {
                // localStorage disabled
            }
            if (!key) {
                status = "none";
            }
            return { key, status };
        }

        function saveOpenAIState(key, status) {
            try {
                if (key) {
                    window.localStorage.setItem(KEY_STORAGE_KEY, key);
                    window.localStorage.setItem(STATUS_STORAGE_KEY, status || "active");
                } else {
                    window.localStorage.removeItem(KEY_STORAGE_KEY);
                    window.localStorage.removeItem(STATUS_STORAGE_KEY);
                }
            } catch (e) {
                console.warn("localStorage not available for OpenAI key", e);
            }
        }

        function updateOpenAIUI() {
            const { key, status } = loadOpenAIState();
            if (!elsOpenAI.statusBadge) return;

            let label = "kein Key gesetzt";
            if (status === "active" && key) {
                label = "aktiv";
            } else if (status === "paused" && key) {
                label = "pausiert";
            }

            elsOpenAI.statusBadge.textContent = label;
            elsOpenAI.statusBadge.dataset.status = status;

            if (elsOpenAI.input) {
                elsOpenAI.input.value = key ? "••••••••••" : "";
            }

            if (elsOpenAI.togglePauseBtn) {
                elsOpenAI.togglePauseBtn.textContent = (status === "paused" ? "Fortsetzen" : "Pausieren");
            }

            if (elsOpenAI.info) {
                const ts = new Date().toLocaleTimeString();
                elsOpenAI.info.textContent = `Status: ${label} · Agent: ${agentSlug} · ${ts}`;
            }
        }

        function attachOpenAIEvents() {
            if (!elsOpenAI.input) return; // Panel existiert nicht

            elsOpenAI.toggleVisibility.addEventListener("click", function () {
                const currentType = elsOpenAI.input.type;
                elsOpenAI.input.type = currentType === "password" ? "text" : "password";
            });

            elsOpenAI.saveBtn.addEventListener("click", function () {
                const raw = elsOpenAI.input.value.trim();
                if (!raw || raw === "••••••••••") {
                    elsOpenAI.info.textContent = "Kein Key eingegeben oder Key bereits gespeichert.";
                    return;
                }
                saveOpenAIState(raw, "active");
                updateOpenAIUI();
                elsOpenAI.info.textContent = "✅ Key gespeichert!";
            });

            elsOpenAI.togglePauseBtn.addEventListener("click", function () {
                const current = loadOpenAIState();
                if (!current.key) {
                    elsOpenAI.info.textContent = "Kein Key vorhanden – nichts zu pausieren.";
                    return;
                }
                const newStatus = current.status === "paused" ? "active" : "paused";
                saveOpenAIState(current.key, newStatus);
                updateOpenAIUI();
            });

            elsOpenAI.deleteBtn.addEventListener("click", function () {
                if (confirm("OpenAI API Key wirklich löschen?")) {
                    saveOpenAIState(null, "none");
                    if (elsOpenAI.input) elsOpenAI.input.value = "";
                    updateOpenAIUI();
                    elsOpenAI.info.textContent = "🗑️ Key gelöscht";
                }
            });
        }

        // Helper, den du überall für OpenAI-Aufrufe verwendest
        window.withOpenAIKey = function (fnIfAvailable) {
            const { key, status } = loadOpenAIState();
            if (!key) {
                alert("Kein OpenAI API Key gesetzt. Bitte im OpenAI-Panel hinterlegen.");
                return;
            }
            if (status === "paused") {
                alert("OpenAI API Key ist pausiert. Bitte im Panel fortsetzen.");
                return;
            }
            return fnIfAvailable(key);
        };

        // ===== Health Check =====
        async function checkHealth() {
            const statusDot = document.getElementById('statusDot');
            const statusText = document.getElementById('statusText');
            const output = document.getElementById('healthOutput');

            if (!output) return; // Generic partial might not have healthOutput

            statusText.textContent = 'Prüfe Status...';
            output.className = 'alert alert-warning fs-5';
            output.textContent = 'Verbinde mit Agent...';

            try {
                const response = await fetch('http://127.0.0.1:/health');

                if (response.ok) {
                    const data = await response.json();
                    statusDot.className = 'status-dot status-online';
                    statusText.textContent = '✅ Online & Erreichbar';
                    output.className = 'alert alert-success fs-5';
                    output.innerHTML = '<h5 class="mb-3">✅ Agent antwortet!</h5><pre class="bg-dark text-light p-3 rounded">' +
                                      JSON.stringify(data, null, 2) + '</pre>';
                } else {
                    throw new Error('HTTP ' + response.status);
                }
            } catch (error) {
                statusDot.className = 'status-dot status-offline';
                statusText.textContent = '❌ Offline / Nicht erreichbar';
                output.className = 'alert alert-danger fs-5';
                output.innerHTML = '<h5>❌ Agent antwortet nicht</h5><p class="mb-0">Fehler: ' + error.message + '</p>' +
                                  '<p class="mt-3 mb-0"><small>Stelle sicher dass der Agent läuft: <code>./bin/start_.sh</code></small></p>';
            }
        }

        window.checkHealth = checkHealth;

        document.addEventListener("DOMContentLoaded", function () {
            attachOpenAIEvents();
            updateOpenAIUI();
            checkHealth();
        });
    })();
    </script>
