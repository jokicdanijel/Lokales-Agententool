<!-- ===== BROWSER AUTOMATION UI ===== -->
<div class="main-card">
    <div class="section-card" style="border-left: 6px solid #6f42c1;">
        <h3 style="color: #6f42c1;">🌐 Browser Automation</h3>
        <p class="text-muted">Playwright-basierte Web-Automation mit Screenshot, HAR & PDF Capture</p>
        <div class="row g-3">
            <div class="col-md-8">
                <label for="inputBrowserUrl" class="form-label fw-bold">URL</label>
                <input id="inputBrowserUrl" type="url" class="form-control form-control-lg" 
                       placeholder="https://example.com" />
            </div>
            <div class="col-md-4">
                <label for="selectEngine" class="form-label fw-bold">Engine</label>
                <select id="selectEngine" class="form-select form-select-lg">
                    <option value="chromium">Chromium</option>
                    <option value="firefox">Firefox</option>
                    <option value="webkit">WebKit</option>
                </select>
            </div>
        </div>
        <div class="row g-3 mt-2">
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkScreenshot" checked>
                    <label class="form-check-label fw-bold" for="chkScreenshot">Screenshot erstellen</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkHeadless" checked>
                    <label class="form-check-label fw-bold" for="chkHeadless">Headless Mode</label>
                </div>
            </div>
        </div>
        <button class="btn btn-primary btn-lg w-100 mt-4" id="btnRunPlaybook" type="button">
            ▶️ Playbook ausführen
        </button>
        <div id="playbookResult" class="mt-4"></div>
    </div>
</div>

<div class="main-card">
    <div class="section-card" style="border-left: 6px solid #6f42c1;">
        <h3 style="color: #6f42c1;">📸 Letzte Screenshots</h3>
        <div id="screenshotGallery" class="row g-3">
            <div class="col-12 text-muted text-center py-4">Keine Screenshots vorhanden</div>
        </div>
    </div>
</div>

<script>
(function() {
    const agentPort = "{{ port }}";
    const runEndpoint = "{{ endpoints.run or '/run' }}";

    document.getElementById("btnRunPlaybook")?.addEventListener("click", function() {
        const url = document.getElementById("inputBrowserUrl").value.trim();
        if (!url) {
            alert("❌ Bitte URL eingeben");
            return;
        }

        window.withOpenAIKey && window.withOpenAIKey(async function(apiKey) {
            const resultDiv = document.getElementById("playbookResult");
            resultDiv.innerHTML = '<div class="alert alert-info">⏳ Führe Playbook aus...</div>';

            try {
                const resp = await fetch(`http://127.0.0.1:${agentPort}${runEndpoint}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        url: url,
                        engine: document.getElementById("selectEngine").value,
                        screenshot: document.getElementById("chkScreenshot").checked,
                        headless: document.getElementById("chkHeadless").checked
                    })
                });

                if (resp.ok) {
                    const data = await resp.json();
                    resultDiv.innerHTML = `
                        <div class="alert alert-success">
                            <h5>✅ Playbook erfolgreich ausgeführt</h5>
                            <pre class="mt-3 bg-dark text-light p-3 rounded">${JSON.stringify(data, null, 2)}</pre>
                        </div>
                    `;
                } else {
                    resultDiv.innerHTML = `<div class="alert alert-danger">❌ Fehler: HTTP ${resp.status}</div>`;
                }
            } catch (e) {
                resultDiv.innerHTML = `<div class="alert alert-danger">❌ Fehler: ${e.message}</div>`;
            }
        });
    });
})();
</script>
