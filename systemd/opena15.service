[Unit]
Description=ELION opena15 - HTML Creator Agent
Documentation=https://github.com/elion/portier
After=network.target opena02.service

[Service]
Type=simple
User=danijel-jd
Group=danijel-jd
WorkingDirectory=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/14.opena15_html
Environment="PATH=/home/danijel-jd/.local/bin:/usr/local/bin:/usr/bin"
Environment="BEARER_TOKEN=c899b90d-faf8-485b-afa4-078357cf5313"
Environment="OPENA15_PORT=12361"
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/14.opena15_html/logs/opena15.log
StandardError=append:/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/14.opena15_html/logs/opena15.error.log

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/14.opena15_html/logs
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/14.opena15_html/data
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/14.opena15_html/html

[Install]
WantedBy=multi-user.target
