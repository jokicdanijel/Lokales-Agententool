[Unit]
Description=ELION opena9 - Telefonie Agent
Documentation=https://github.com/elion/portier
After=network.target opena02.service

[Service]
Type=simple
User=danijel-jd
Group=danijel-jd
WorkingDirectory=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/8.opena9_telephone
Environment="PATH=/home/danijel-jd/.local/bin:/usr/local/bin:/usr/bin"
Environment="BEARER_TOKEN=c899b90d-faf8-485b-afa4-078357cf5313"
Environment="OPENA9_PORT=12355"
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/8.opena9_telephone/logs/opena9.log
StandardError=append:/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/8.opena9_telephone/logs/opena9.error.log

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/8.opena9_telephone/logs
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/8.opena9_telephone/data

[Install]
WantedBy=multi-user.target
