[Unit]
Description=ELION opena20 - Dashboard Agent
Documentation=https://github.com/elion/portier
After=network.target opena02.service

[Service]
Type=simple
User=danijel-jd
Group=danijel-jd
WorkingDirectory=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent
Environment="PATH=/home/danijel-jd/.local/bin:/usr/local/bin:/usr/bin"
Environment="BEARER_TOKEN=c899b90d-faf8-485b-afa4-078357cf5313"
Environment="OPENA20_PORT=12349"
ExecStart=/usr/bin/python3 main_dashboard.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent/logs/opena20.log
StandardError=append:/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent/logs/opena20.error.log

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent/logs
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent/data

[Install]
WantedBy=multi-user.target
