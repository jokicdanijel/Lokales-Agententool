# opena6 Browser Agent Configuration
# Copy to .env and customize as needed

# Service Identity
OPENA6_PORT=12349

# Archivator & Coordinator Integration
OPENA2_URL=http://127.0.0.1:12345
OPENA1_URL=http://127.0.0.1:12344
ARCHIV_PATH=archivp

# Browser Settings
HEADLESS=true
BROWSER_TYPE=chromium
PLAYWRIGHT_TIMEOUT_MS=10000
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# Rate Limiting (requests per second per domain)
DEFAULT_RPS_LIMIT=1.0

# Artifact Management
MAX_ARTIFACT_SIZE_MB=50
ATTACH_HTML=true
ATTACH_HAR=false
ATTACH_PDF=false
ATTACH_SCREENSHOT=true

# Security & Compliance
OBEY_ROBOTS=true
ALLOWED_DOMAINS=localhost,127.0.0.1,example.org

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs/opena6

# Metrics
ENABLE_METRICS=true
METRICS_PORT=12349
