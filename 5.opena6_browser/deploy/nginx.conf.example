# Nginx Reverse Proxy Configuration for opena6 Browser Agent
# Install: sudo cp opena6_browser.conf /etc/nginx/sites-available/
# Enable:  sudo ln -s /etc/nginx/sites-available/opena6_browser.conf /etc/nginx/sites-enabled/
# Reload:  sudo systemctl reload nginx

upstream opena6_upstream {
    server 127.0.0.1:12349 max_fails=3 fail_timeout=10s;
    keepalive 64;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name opena6.internal;

    # SSL Configuration
    ssl_certificate /etc/letsencrypt/live/opena6.internal/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/opena6.internal/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    access_log /var/log/nginx/opena6_access.log combined;
    error_log /var/log/nginx/opena6_error.log warn;

    # Health check endpoint (allow internal only)
    location = /health {
        allow 127.0.0.1;
        allow 172.20.0.0/16;  # Docker network
        deny all;
        
        proxy_pass http://opena6_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Metrics endpoint (internal only)
    location = /metrics {
        allow 127.0.0.1;
        allow 172.20.0.0/16;
        deny all;
        
        proxy_pass http://opena6_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Main API endpoints
    location /run {
        # Require authentication
        auth_basic "opena6 Restricted Area";
        auth_basic_user_file /etc/nginx/.htpasswd_opena6;

        proxy_pass http://opena6_upstream;
        proxy_http_version 1.1;
        
        # Headers
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        
        # Buffer playbook requests
        client_max_body_size 10m;
    }

    # Cancel endpoint
    location /cancel {
        auth_basic "opena6 Restricted Area";
        auth_basic_user_file /etc/nginx/.htpasswd_opena6;
        
        proxy_pass http://opena6_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Admin endpoints (local only)
    location /api {
        allow 127.0.0.1;
        allow 172.20.0.0/16;
        deny all;
        
        proxy_pass http://opena6_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Documentation
    location /docs {
        proxy_pass http://opena6_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location /redoc {
        proxy_pass http://opena6_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Root
    location / {
        proxy_pass http://opena6_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name opena6.internal;

    location /.well-known/acme-challenge {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}
