[Unit]
Description=ELION opena19 - Stocks & Crypto Agent
Documentation=https://github.com/elion/portier
After=network.target

[Service]
Type=simple
User=danijel-jd
Group=danijel-jd
WorkingDirectory=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/18.opena19_Aktien&Crypto
Environment="PATH=/home/danijel-jd/.local/bin:/usr/local/bin:/usr/bin"
Environment="BEARER_TOKEN=c899b90d-faf8-485b-afa4-078357cf5313"
Environment="OPENA19_PORT=12365"
ExecStart=/usr/bin/python3 main_stocks_crypto_agent.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/18.opena19_Aktien&Crypto/logs/opena19.log
StandardError=append:/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/18.opena19_Aktien&Crypto/logs/opena19.error.log

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/18.opena19_Aktien&Crypto/logs
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/18.opena19_Aktien&Crypto/data

[Install]
WantedBy=multi-user.target
