# PORTIER 3.0 Environment Template
# Kopiere diese Datei nach .env und fülle die Werte aus

# OpenAI API Keys (NIEMALS committen!)
OPENAI_API_KEY_OPENA1=sk-proj-YOUR_KEY_HERE
OPENAI_API_KEY_OPENA2=sk-proj-YOUR_KEY_HERE
OPENAI_API_KEY=sk-proj-YOUR_DEFAULT_KEY_HERE

# Dashboard & Auth
DASHBOARD_ADMIN_TOKEN=YOUR_UUID_HERE
BEARER_TOKEN=YOUR_UUID_HERE

# Service Ports (Port-Policy: 12344-12399)
OPENA1_PORT=12344
OPENA2_PORT=12345
KORDP_PORT=12346
DASHBOARD_PORT=12349

# Agenten-Konfiguration
AGENT_ID=opena1
LOG_LEVEL=INFO

# Service URLs
DASHBOARD_URL=http://127.0.0.1:12349
ARCHIVATOR_URL=http://127.0.0.1:12345
