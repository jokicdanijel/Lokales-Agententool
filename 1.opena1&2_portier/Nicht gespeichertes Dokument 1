#!/usr/bin/env python3
# -*- coding: utf-8 -*-

from __future__ import annotations

import hashlib
import json
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Tuple

import yaml

AGENT_COUNT_EXPECTED = 21
AGENT_ID_PREFIX = "opena"
ALLOWED_PORT_MIN = 12344
ALLOWED_PORT_MAX = 12399
FORBIDDEN_PORTS = {8080, 3000}


@dataclass(frozen=True)
class ValidationResult:
    valid: bool
    errors: List[str]
    baseline_sha256: str
    agent_count: int
    baseline_path: str
    generated_at: str


def _utc_now_z() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def _sha256_bytes(data: bytes) -> str:
    h = hashlib.sha256()
    h.update(data)
    return h.hexdigest()


def _load_baseline_yaml(path: Path) -> Tuple[Dict[str, Any], bytes]:
    try:
        raw = path.read_bytes()
    except Exception as e:
        raise RuntimeError(f"Failed to read baseline file: {path}") from e

    try:
        data = yaml.safe_load(raw.decode("utf-8", errors="ignore"))
    except Exception as e:
        raise RuntimeError(f"Failed to parse YAML: {e}") from e

    if not isinstance(data, dict):
        raise RuntimeError("Baseline YAML root must be a mapping/dict")

    return data, raw


def _validate_agents_list(baseline: Dict[str, Any]) -> List[str]:
    errors: List[str] = []
    agents = baseline.get("agents")

    if not isinstance(agents, list):
        return ["Baseline must contain key 'agents' as list"]

    if len(agents) != AGENT_COUNT_EXPECTED:
        errors.append(f"Expected {AGENT_COUNT_EXPECTED} agents, found {len(agents)}")

    ids: List[str] = []
    ports: List[int] = []
    folders: List[str] = []

    for idx, a in enumerate(agents):
        if not isinstance(a, dict):
            errors.append(f"agents[{idx}] must be a dict")
            continue

        agent_id = str(a.get("id", "")).strip()
        if not agent_id:
            errors.append(f"agents[{idx}].id missing")
        ids.append(agent_id)

        try:
            port = int(a.get("port"))
            ports.append(port)
        except Exception:
            errors.append(f"{agent_id or f'agents[{idx}]'}: invalid or missing port")
            continue

        folder = str(a.get("folder", "")).strip()
        if not folder:
            errors.append(f"{agent_id or f'agents[{idx}]'}: missing folder")
        folders.append(folder)

    # ID set must be opena1..opena21
    expected_ids = {f"{AGENT_ID_PREFIX}{i}" for i in range(1, AGENT_COUNT_EXPECTED + 1)}
    present_ids = set(ids)

    missing = sorted(expected_ids - present_ids)
    extra = sorted(present_ids - expected_ids)

    if missing:
        errors.append(f"Missing agent IDs: {missing}")
    if extra:
        errors.append(f"Unexpected agent IDs: {extra}")

    # Unique IDs
    dup_ids = sorted({i for i in ids if ids.count(i) > 1})
    if dup_ids:
        errors.append(f"Duplicate agent IDs: {dup_ids}")

    # Unique ports
    dup_ports = sorted({p for p in ports if ports.count(p) > 1})
    if dup_ports:
        errors.append(f"Duplicate ports: {dup_ports}")

    # Port policy
    for agent_id, port in zip(ids, ports, strict=False):
        if port in FORBIDDEN_PORTS:
            errors.append(f"{agent_id}: forbidden port {port}")
        if not (ALLOWED_PORT_MIN <= port <= ALLOWED_PORT_MAX):
            errors.append(
                f"{agent_id}: port {port} outside allowed range {ALLOWED_PORT_MIN}-{ALLOWED_PORT_MAX}"
            )

    return errors


def _validate_folders_exist(root: Path, baseline: Dict[str, Any]) -> List[str]:
    errors: List[str] = []
    agents = baseline.get("agents")
    if not isinstance(agents, list):
        return ["Baseline must contain key 'agents' as list"]

    for a in agents:
        if not isinstance(a, dict):
            continue
        agent_id = str(a.get("id", "")).strip() or "<unknown>"
        folder = str(a.get("folder", "")).strip()
        if not folder:
            continue
        p = (root / folder).resolve()
        if not p.exists() or not p.is_dir():
            errors.append(f"{agent_id}: folder missing: {folder}")
    return errors


def validate_baseline(root: Path, baseline_path: Path) -> ValidationResult:
    baseline, raw = _load_baseline_yaml(baseline_path)
    digest = _sha256_bytes(raw)

    errors: List[str] = []
    errors.extend(_validate_agents_list(baseline))
    errors.extend(_validate_folders_exist(root, baseline))

    agents = baseline.get("agents")
    agent_count = len(agents) if isinstance(agents, list) else 0

    return ValidationResult(
        valid=len(errors) == 0,
        errors=sorted(set(errors)),
        baseline_sha256=digest,
        agent_count=agent_count,
        baseline_path=str(baseline_path.relative_to(root)),
        generated_at=_utc_now_z(),
    )


def _write_artifact(root: Path, result: ValidationResult) -> Path:
    artifacts_dir = root / "artifacts"
    artifacts_dir.mkdir(parents=True, exist_ok=True)

    out_path = artifacts_dir / "baseline_validation.json"
    payload = {
        "valid": result.valid,
        "errors": result.errors,
        "baseline_path": result.baseline_path,
        "baseline_sha256": result.baseline_sha256,
        "agent_count": result.agent_count,
        "generated_at": result.generated_at,
        "policy": {
            "allowed_port_range": [ALLOWED_PORT_MIN, ALLOWED_PORT_MAX],
            "forbidden_ports": sorted(FORBIDDEN_PORTS),
            "expected_agent_count": AGENT_COUNT_EXPECTED,
        },
    }
    out_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
    return out_path


def main() -> int:
    root = Path(__file__).resolve().parent.parent
    baseline_path = root / "system_baseline.yaml"

    result = validate_baseline(root=root, baseline_path=baseline_path)
    out_path = _write_artifact(root, result)

    if result.valid:
        print(f"✅ Baseline validation passed — {out_path.relative_to(root)} written")
        return 0

    print(f"❌ Baseline validation failed — {out_path.relative_to(root)} written")
    for e in result.errors:
        print(f" - {e}")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())

