cat > 22.opena22_new_agent/main.py << 'EOF'
#!/usr/bin/env python3
from fastapi import FastAPI
import uvicorn

PORT = 12369

app = FastAPI(title="opena22")

@app.get("/health")
async def health():
    return {"status": "ok", "agent":  "opena22", "port": PORT}

if __name__ == "__main__":
    uvicorn.run(app, host="127.0.0.1", port=PORT)
EOF

