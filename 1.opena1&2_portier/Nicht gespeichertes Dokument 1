#!/usr/bin/env python3
"""Compliance Scanner: Ports & Agent IDs

Scope:
 - system_baseline.yaml
 - artifacts/agent_inventory.json (if present)
 - repository files (searching for 'openaX' and port numbers)

Outputs:
 - artifacts/scans/ports_ids_scan.json
 - artifacts/scans/ports_ids_scan.md

Exit codes:
 - 0 on success
 - 1 if any compliance check fails
"""
from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple

ROOT = Path(__file__).parent.parent
SCANS = ROOT / "artifacts" / "scans"
SCANS.mkdir(parents=True, exist_ok=True)
OUT_JSON = SCANS / "ports_ids_scan.json"
OUT_MD = SCANS / "ports_ids_scan.md"

BASELINE_FILE = ROOT / "system_baseline.yaml"
INVENTORY_CANDIDATES = [
    ROOT / "artifacts" / "agent_inventory.json",
    ROOT / "artifacts" / "agent_discovery.json",
    ROOT / "artifacts" / "agent_discovery_summary.json",
]

FORBIDDEN_PORTS = {8080, 3000}
ALLOWED_MIN = 12344
ALLOWED_MAX = 12399

# regexes
RE_OPENA = re.compile(r"\b(opena)([0-9]{1,3})\b", flags=re.IGNORECASE)
RE_NUMBER = re.compile(r"\b(\d{3,5})\b")


def load_baseline(path: Path) -> Tuple[Dict[str, Any], List[str]]:
    """Attempt to load baseline YAML to extract agents and ports.
    If PyYAML is available we use it, otherwise fall back to simple parsing.
    Returns (agents_map, messages)
    agents_map: { 'opena1': { 'port': 12344, 'line': <line> }, ... }
    """
    msgs: List[str] = []
    if not path.exists():
        msgs.append(f"baseline file missing: {path}")
        return {}, msgs

    try:
        import yaml  # type: ignore

        data = yaml.safe_load(path.read_text()) or {}
        agents = data.get("agents") or []
        out = {}
        for a in agents:
            aid = str(a.get("id"))
            port = int(a.get("port")) if a.get("port") is not None else None
            out[aid] = {"port": port, "meta": a}
        return out, msgs
    except Exception:
        # Fallback simple parse
        text = path.read_text()
        agents: Dict[str, Dict[str, Any]] = {}
        current = None
        for i, line in enumerate(text.splitlines()):
            m = re.search(r"-\s*id:\s*(opena[0-9]+)", line)
            if m:
                current = m.group(1)
                agents[current] = {"port": None, "line": i + 1}
                continue
            if current and "port" in line:
                m2 = re.search(r"port:\s*([0-9]+)", line)
                if m2:
                    agents[current]["port"] = int(m2.group(1))
        msgs.append("used fallback YAML parser")
        return agents, msgs


def load_inventory() -> Tuple[Optional[List[str]], List[str]]:
    msgs: List[str] = []
    for p in INVENTORY_CANDIDATES:
        if p.exists():
            try:
                data = json.loads(p.read_text())
                # try to extract agent ids
                ids = []
                if isinstance(data, list):
                    for entry in data:
                        if isinstance(entry, dict) and entry.get("id"):
                            ids.append(entry.get("id"))
                elif isinstance(data, dict) and data.get("agents"):
                    for entry in data.get("agents"):
                        if isinstance(entry, dict) and entry.get("id"):
                            ids.append(entry.get("id"))
                msgs.append(f"loaded inventory from {p.name}")
                return ids, msgs
            except Exception as e:
                msgs.append(f"failed to parse {p.name}: {e}")
    msgs.append("no inventory file found")
    return None, msgs


def scan_repo_files(root: Path) -> Tuple[Dict[str, List[Tuple[str, int, str]]], Dict[int, List[Tuple[str, int, str]]]]:
    """Scan repository files and return:
    - opena_refs: { 'opena3': [(file, line, snippet), ...] }
    - ports_refs: { 12345: [(file, line, snippet), ...] }
    """
    opena_refs: Dict[str, List[Tuple[str, int, str]]] = {}
    ports_refs: Dict[int, List[Tuple[str, int, str]]] = {}

    skip_dirs = {".git", "venv", "node_modules", "__pycache__", "build", "dist"}

    for p in root.rglob("*"):
        if p.is_dir():
            if p.name in skip_dirs:
                # skip dir
                continue
            else:
                continue
        rel = p.relative_to(root)
        if any(part in skip_dirs for part in rel.parts):
            continue
        # Only scan text files
        try:
            text = p.read_text(encoding="utf-8")
        except Exception:
            continue
        for lineno, line in enumerate(text.splitlines(), start=1):
            for m in RE_OPENA.finditer(line):
                aid = m.group(1).lower() + m.group(2)
                opena_refs.setdefault(aid, []).append((str(rel), lineno, line.strip()))
            for m in RE_NUMBER.finditer(line):
                num = int(m.group(1))
                # only consider ports of interest (forbidden or in allowed range)
                if num in FORBIDDEN_PORTS or (ALLOWED_MIN <= num <= ALLOWED_MAX):
                    ports_refs.setdefault(num, []).append((str(rel), lineno, line.strip()))
    return opena_refs, ports_refs


def validate(baseline: Dict[str, Any], inventory_ids: Optional[List[str]], opena_refs: Dict[str, Any], ports_refs: Dict[int, Any]) -> Tuple[Dict[str, Any], bool]:
    results: Dict[str, Any] = {}
    ok = True

    # Check baseline IDs are exactly opena1..opena21
    expected_ids = {f"opena{i}" for i in range(1, 22)}
    baseline_ids = set(baseline.keys())
    results["baseline_ids"] = sorted(list(baseline_ids))
    if baseline_ids != expected_ids:
        ok = False
        results["baseline_id_mismatch"] = {
            "missing": sorted(list(expected_ids - baseline_ids)),
            "extra": sorted(list(baseline_ids - expected_ids)),
        }
    else:
        results["baseline_id_mismatch"] = {"missing": [], "extra": []}

    # Validate baseline ports unique and in range
    port_map: Dict[int, List[str]] = {}
    for aid, info in baseline.items():
        port = info.get("port")
        if port is None:
            ok = False
            results.setdefault("baseline_errors", []).append(f"{aid} missing port")
            continue
        if not (ALLOWED_MIN <= port <= ALLOWED_MAX):
            ok = False
            results.setdefault("baseline_errors", []).append(f"{aid} port {port} out of allowed range")
        port_map.setdefault(port, []).append(aid)
    dup_ports = {p: ids for p, ids in port_map.items() if len(ids) > 1}
    if dup_ports:
        ok = False
        results["duplicate_ports_in_baseline"] = dup_ports
    else:
        results["duplicate_ports_in_baseline"] = {}

    # Forbidden ports in repo
    forbidden_found = {}
    for p in FORBIDDEN_PORTS:
        if p in ports_refs:
            forbidden_found[p] = ports_refs[p]
    if forbidden_found:
        ok = False
    results["forbidden_ports_found"] = forbidden_found

    # Any openaX outside 1..21
    outside = {}
    for aid in opena_refs.keys():
        m = re.match(r"opena([0-9]{1,3})", aid)
        if not m:
            continue
        n = int(m.group(1))
        if not (1 <= n <= 21):
            outside[aid] = opena_refs[aid]
    if outside:
        ok = False
    results["opena_outside_range"] = outside

    # Check that ports in repo align with baseline mapping if possible
    # Heuristic: if a file contains both an opena id and a port, we verify they match baseline
    mismatches = []
    # Build quick reverse baseline mapping: port->id
    baseline_port_to_id = {info.get("port"): aid for aid, info in baseline.items() if info.get("port") is not None}

    # For each file where both appear, check
    # Build file->set of opena ids and ports
    file_map: Dict[str, Dict[str, Set]] = {}
    for aid, occ in opena_refs.items():
        for f, ln, line in occ:
            file_map.setdefault(f, {}).setdefault("ids", set()).add(aid)
    for port, occ in ports_refs.items():
        for f, ln, line in occ:
            file_map.setdefault(f, {}).setdefault("ports", set()).add(port)
    for f, info in file_map.items():
        ids = info.get("ids", set())
        ports = info.get("ports", set())
        if ids and ports:
            # for each combination check baseline mapping
            for aid in ids:
                expected_port = baseline.get(aid, {}).get("port")
                for p in ports:
                    if expected_port is not None and p != expected_port:
                        mismatches.append({"file": f, "id": aid, "found_port": p, "expected_port": expected_port})
    if mismatches:
        ok = False
    results["file_id_port_mismatches"] = mismatches

    # If inventory present, ensure it matches baseline set (no extra/missing)
    if inventory_ids is not None:
        inv_set = set(inventory_ids)
        results["inventory_ids"] = sorted(list(inv_set))
        if inv_set != expected_ids:
            ok = False
            results["inventory_mismatch"] = {
                "missing": sorted(list(expected_ids - inv_set)),
                "extra": sorted(list(inv_set - expected_ids)),
            }
    else:
        results["inventory_ids"] = None

    results["summary"] = {
        "ok": ok,
        "total_baseline_ids": len(baseline_ids),
        "total_opena_refs_found": len(opena_refs),
        "total_ports_found": len(ports_refs),
    }
    return results, ok


def render_md(results: Dict[str, Any]) -> str:
    lines: List[str] = []
    lines.append("# Ports & Agent IDs Compliance Scan")
    lines.append("")
    lines.append(f"**Result:** {'PASS' if results.get('summary', {}).get('ok') else 'FAIL'}")
    lines.append("")
    lines.append("## Baseline IDs")
    lines.append(f"Found {len(results.get('baseline_ids', []))} baseline agent IDs")
    if results.get("baseline_id_mismatch"):
        bm = results["baseline_id_mismatch"]
        lines.append(f"- Missing: {bm.get('missing')}\n- Extra: {bm.get('extra')}")
    lines.append("")
    lines.append("## Forbidden ports found")
    forbidden = results.get("forbidden_ports_found") or {}
    if forbidden:
        lines.append("⚠️ Forbidden ports were found in repository references:")
        for p, occ in forbidden.items():
            lines.append(f"- Port {p} in {len(occ)} locations")
    else:
        lines.append("No forbidden ports found.")
    lines.append("")

    lines.append("## File ID/Port mismatches")
    if results.get("file_id_port_mismatches"):
        for m in results["file_id_port_mismatches"]:
            lines.append(f"- File {m['file']}: {m['id']} found port {m['found_port']}, expected {m['expected_port']}")
    else:
        lines.append("No explicit ID->port mismatches detected in the same files.")
    lines.append("")

    if results.get("opena_outside_range"):
        lines.append("## opena IDs outside 1..21 found")
        for aid, occ in results["opena_outside_range"].items():
            lines.append(f"- {aid} referenced in {len(occ)} locations")
    lines.append("")

    if results.get("inventory_mismatch"):
        im = results["inventory_mismatch"]
        lines.append("## Inventory mismatch with baseline")
        lines.append(f"- Missing: {im.get('missing')}\n- Extra: {im.get('extra')}")
        lines.append("")

    lines.append("---")
    lines.append(f"Scan generated by scanner at {ROOT.name}")
    return "\n".join(lines)


def main(argv: List[str] | None = None) -> int:
    baseline, bmsgs = load_baseline(BASELINE_FILE)
    inventory, imsgs = load_inventory()
    opena_refs, ports_refs = scan_repo_files(ROOT)

    results_raw, ok = validate(baseline, inventory, opena_refs, ports_refs)
    results = {
        "meta": {
            "root": str(ROOT),
            "baseline_file": str(BASELINE_FILE),
            "inventory_candidates_checked": [str(p) for p in INVENTORY_CANDIDATES],
        },
        "messages": {
            "baseline_parse": bmsgs,
            "inventory_parse": imsgs,
        },
        "findings": results_raw,
    }

    OUT_JSON.write_text(json.dumps(results, indent=2))
    OUT_MD.write_text(render_md(results_raw))

    if ok:
        print("✅ Ports & IDs scan PASS — artifacts written to", SCANS)
        return 0
    else:
        print("❌ Ports & IDs scan FAIL — see artifacts in", SCANS)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
