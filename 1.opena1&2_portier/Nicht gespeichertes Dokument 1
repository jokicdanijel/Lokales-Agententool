#!/usr/bin/env python3
"""
Deterministic Agent Discovery (Read-only, auditierbar, fail-fast)

Zweck
- Lädt system_baseline.yaml als Single Source of Truth.
- Scannt jedes Agenten-Verzeichnis rekursiv (statisch, ohne Ausführung/Netzwerk).
- Extrahiert deterministische Metadaten:
  - Dateiliste + sha256 + size
  - Python: imports (AST), FastAPI/Flask-Endpunkte (Regex), Port-Literale, openaX-Referenzen
  - HTML: data-* Attribute, form/nav Indikatoren, Port-Literale, openaX-Referenzen
  - JSON/YAML/ENV/MD/TXT: Port-Literale, openaX-Referenzen
- Validiert hart:
  - Exactly opena1..opena21 exist in baseline
  - Agent folder exists and non-empty
  - Ports unique + match baseline
  - Forbidden ports (8080, 3000) dürfen nirgendwo als Port-Literal auftauchen
  - Any openaX reference outside 1..21 => FAIL
  - Any detected port literal that equals another agent's port but belongs to a different agent folder => flagged (optional fail)

Output
- artifacts/agent_inventory.json (deterministische Reihenfolge, keine Zeitstempel)

Usage
  python3 scripts/agent_discovery.py
  python3 scripts/agent_discovery.py --baseline system_baseline.yaml --root . --out artifacts/agent_inventory.json

Policy
- Keine Codeausführung (nur Lesen/Parsen).
- Keine Netzwerkaufrufe.
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import json
import os
import re
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Set, Tuple

try:
    import yaml  # type: ignore
except Exception as e:  # pragma: no cover
    print(f"[FATAL] PyYAML fehlt oder kann nicht importiert werden: {e}", file=sys.stderr)
    sys.exit(1)


# ------------------------------- Constants ------------------------------------

AGENT_ID_MIN = 1
AGENT_ID_MAX = 21

DEFAULT_BASELINE = "system_baseline.yaml"
DEFAULT_OUT = "artifacts/agent_inventory.json"

ALLOWED_PORT_MIN = 12344
ALLOWED_PORT_MAX = 12399
FORBIDDEN_PORTS = {8080, 3000}

# File types we statically inspect for port/opena references
TEXT_EXTS = {
    ".py",
    ".html", ".htm",
    ".json",
    ".yaml", ".yml",
    ".env", ".env.local", ".env.production", ".env.development",
    ".md", ".txt",
    ".toml", ".ini",
}

# Regex patterns
RE_OPENA = re.compile(r"\bopena(\d{1,2})\b", re.IGNORECASE)

# Ports: capture 4-5 digit numbers. We will filter to allowed range and forbidden ports.
RE_PORT_NUM = re.compile(r"(?<!\d)(\d{4,5})(?!\d)")

# FastAPI decorators: @app.get("/x"), @router.post("/x")
RE_FASTAPI_DECORATOR = re.compile(
    r"@(?:app|router)\.(get|post|put|delete|patch)\(\s*[\"']([^\"']+)",
    re.IGNORECASE,
)

# Flask: @app.route("/x", methods=[...])  (we record as ROUTE /x)
RE_FLASK_ROUTE = re.compile(r"@app\.route\(\s*[\"']([^\"']+)", re.IGNORECASE)

# HTML data- attributes
RE_DATA_ATTR = re.compile(r"\bdata-[a-zA-Z0-9_-]+\b")


# ------------------------------- Data models ----------------------------------

@dataclass(frozen=True)
class BaselineAgent:
    agent_id: str
    port: int
    role: str
    folder: str
    visibility: str
    description: str
    name: str


@dataclass
class FileRecord:
    path: str
    size: int
    sha256: str

    # optional static extraction
    imports: List[str]
    endpoints: List[str]
    ports_detected: List[int]
    agent_references: List[str]
    html_data_attrs: List[str]
    flags: Dict[str, Any]


# ------------------------------- Utilities ------------------------------------

def sha256_bytes(data: bytes) -> str:
    h = hashlib.sha256()
    h.update(data)
    return h.hexdigest()


def sha256_file(path: Path, chunk_size: int = 1024 * 1024) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        while True:
            chunk = f.read(chunk_size)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def read_text_best_effort(path: Path, limit_bytes: int = 2_000_000) -> str:
    """
    Read file as text without crashing on encoding issues.
    Hard cap to prevent huge memory usage.
    """
    raw = path.read_bytes()
    if len(raw) > limit_bytes:
        raw = raw[:limit_bytes]
    return raw.decode("utf-8", errors="ignore")


def stable_sorted(iterable: Iterable[str]) -> List[str]:
    return sorted(set(iterable), key=lambda s: (s.lower(), s))


def normalize_agent_id(agent_id: str) -> str:
    agent_id = agent_id.strip()
    if not agent_id.lower().startswith("opena"):
        return agent_id
    # Keep canonical lower-case openaX
    m = RE_OPENA.search(agent_id)
    if not m:
        return agent_id.lower()
    return f"opena{int(m.group(1))}"


def extract_opena_refs(text: str) -> List[str]:
    refs: List[str] = []
    for m in RE_OPENA.finditer(text):
        n = int(m.group(1))
        refs.append(f"opena{n}")
    return stable_sorted(refs)


def extract_ports(text: str) -> List[int]:
    found: Set[int] = set()
    for m in RE_PORT_NUM.finditer(text):
        try:
            val = int(m.group(1))
        except Exception:
            continue
        if val in FORBIDDEN_PORTS or (ALLOWED_PORT_MIN <= val <= ALLOWED_PORT_MAX):
            found.add(val)
    return sorted(found)


def extract_endpoints_from_python_text(text: str) -> List[str]:
    eps: Set[str] = set()
    for method, path in RE_FASTAPI_DECORATOR.findall(text):
        eps.add(f"{method.upper()} {path}")
    for path in RE_FLASK_ROUTE.findall(text):
        eps.add(f"ROUTE {path}")
    return sorted(eps)


def extract_html_data_attrs(text: str) -> List[str]:
    return stable_sorted(RE_DATA_ATTR.findall(text))


def extract_imports_from_python_ast(text: str) -> List[str]:
    imports: Set[str] = set()
    try:
        tree = ast.parse(text)
    except Exception:
        return []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name:
                    imports.add(alias.name.split(".")[0])
        elif isinstance(node, ast.ImportFrom):
            if node.module:
                imports.add(node.module.split(".")[0])
    return sorted(imports)


def is_text_candidate(path: Path) -> bool:
    """
    Determines if a file should be scanned as text by extension.
    Supports compound env names via suffix matching (.env, .env.local).
    """
    name = path.name.lower()
    if name.startswith(".env"):
        return True
    return path.suffix.lower() in TEXT_EXTS


# ------------------------------- Baseline -------------------------------------

def load_baseline(baseline_path: Path) -> Tuple[Dict[str, Any], List[BaselineAgent], str]:
    if not baseline_path.exists():
        raise FileNotFoundError(f"Baseline nicht gefunden: {baseline_path}")

    raw = baseline_path.read_bytes()
    baseline_hash = sha256_bytes(raw)

    data = yaml.safe_load(raw.decode("utf-8", errors="ignore"))
    if not isinstance(data, dict):
        raise ValueError("Baseline YAML hat kein dict-root Objekt.")

    agents_raw = data.get("agents")
    if not isinstance(agents_raw, list):
        raise ValueError("Baseline muss 'agents' als Liste enthalten.")

    agents: List[BaselineAgent] = []
    for a in agents_raw:
        if not isinstance(a, dict):
            raise ValueError("Baseline: Jeder agents[] Eintrag muss ein dict sein.")
        agent_id = normalize_agent_id(str(a.get("id", "")).strip())
        name = str(a.get("name", "")).strip()
        role = str(a.get("role", "")).strip()
        folder = str(a.get("folder", "")).strip()
        visibility = str(a.get("visibility", "")).strip()
        description = str(a.get("description", "")).strip()

        try:
            port = int(a.get("port"))
        except Exception:
            raise ValueError(f"Baseline: port fehlt/ungültig für agent id={agent_id}")

        agents.append(
            BaselineAgent(
                agent_id=agent_id,
                port=port,
                role=role,
                folder=folder,
                visibility=visibility,
                description=description,
                name=name,
            )
        )

    # Hard validation: exactly opena1..opena21
    expected_ids = {f"opena{i}" for i in range(AGENT_ID_MIN, AGENT_ID_MAX + 1)}
    present_ids = {a.agent_id for a in agents}
    missing = sorted(expected_ids - present_ids)
    extra = sorted(present_ids - expected_ids)

    errors: List[str] = []
    if missing:
        errors.append(f"Baseline: Missing agent IDs: {missing}")
    if extra:
        errors.append(f"Baseline: Extra/unknown agent IDs: {extra}")

    # Ports: unique
    ports = [a.port for a in agents]
    dup_ports = sorted({p for p in ports if ports.count(p) > 1})
    if dup_ports:
        errors.append(f"Baseline: Duplicate ports: {dup_ports}")

    # Ports: allowed range; forbidden ports not allowed for agents
    for a in agents:
        if a.port in FORBIDDEN_PORTS:
            errors.append(f"Baseline: Agent {a.agent_id} nutzt verbotenen Port {a.port}")
        if not (ALLOWED_PORT_MIN <= a.port <= ALLOWED_PORT_MAX):
            errors.append(f"Baseline: Agent {a.agent_id} Port {a.port} außerhalb {ALLOWED_PORT_MIN}-{ALLOWED_PORT_MAX}")

    if errors:
        raise ValueError(" | ".join(errors))

    return data, sorted(agents, key=lambda x: (int(x.agent_id.replace("opena", "")), x.agent_id)), baseline_hash


# ------------------------------- Discovery ------------------------------------

def discover_agent_folder(
    root: Path,
    agent: BaselineAgent,
    baseline_ports_to_agent: Dict[int, str],
) -> Tuple[Dict[str, Any], List[str]]:
    """
    Returns per-agent inventory dict + list of errors (non-empty => fail).
    """
    errors: List[str] = []
    agent_root = (root / agent.folder).resolve()

    if not agent_root.exists() or not agent_root.is_dir():
        errors.append(f"{agent.agent_id}: folder missing: {agent.folder}")
        return (
            {
                "id": agent.agent_id,
                "name": agent.name,
                "port": agent.port,
                "role": agent.role,
                "folder": agent.folder,
                "visibility": agent.visibility,
                "description": agent.description,
                "exists": False,
                "file_count": 0,
                "files": [],
                "totals": {
                    "bytes": 0,
                    "ports_detected": [],
                    "agent_references": [],
                    "endpoints": [],
                    "imports": [],
                },
                "flags": {"missing_folder": True},
            },
            errors,
        )

    # Enumerate files deterministically
    all_files: List[Path] = []
    for p in agent_root.rglob("*"):
        if p.is_file():
            all_files.append(p)

    all_files = sorted(all_files, key=lambda p: str(p.relative_to(root)).lower())

    if len(all_files) == 0:
        errors.append(f"{agent.agent_id}: folder empty: {agent.folder}")

    file_records: List[Dict[str, Any]] = []
    agg_ports: Set[int] = set()
    agg_refs: Set[str] = set()
    agg_endpoints: Set[str] = set()
    agg_imports: Set[str] = set()

    total_bytes = 0

    for file_path in all_files:
        rel = str(file_path.relative_to(root))
        size = file_path.stat().st_size
        total_bytes += size
        file_hash = sha256_file(file_path)

        imports: List[str] = []
        endpoints: List[str] = []
        ports_detected: List[int] = []
        agent_refs: List[str] = []
        html_attrs: List[str] = []
        flags: Dict[str, Any] = {}

        if is_text_candidate(file_path):
            text = read_text_best_effort(file_path)

            ports_detected = extract_ports(text)
            for p in ports_detected:
                agg_ports.add(p)

            agent_refs = extract_opena_refs(text)
            for r in agent_refs:
                agg_refs.add(r)

            if file_path.suffix.lower() == ".py":
                endpoints = extract_endpoints_from_python_text(text)
                for e in endpoints:
                    agg_endpoints.add(e)
                imports = extract_imports_from_python_ast(text)
                for i in imports:
                    agg_imports.add(i)

            if file_path.suffix.lower() in {".html", ".htm"}:
                html_attrs = extract_html_data_attrs(text)
                flags["has_form"] = "<form" in text.lower()
                flags["has_nav"] = "<nav" in text.lower()
                flags["has_main"] = "<main" in text.lower()

        # Flag forbidden ports anywhere in agent repo (literal)
        if any(p in FORBIDDEN_PORTS for p in ports_detected):
            errors.append(f"{agent.agent_id}: forbidden port literal found in {rel}: {sorted(set(ports_detected) & FORBIDDEN_PORTS)}")

        # Optional: detect cross-agent port usage (if the file mentions another agent's baseline port)
        cross_ports = [p for p in ports_detected if p in baseline_ports_to_agent and baseline_ports_to_agent[p] != agent.agent_id]
        if cross_ports:
            flags["cross_agent_ports"] = sorted(set(cross_ports))
            # In strict control-plane setups, direct port calls are forbidden.
            # We fail hard here to enforce "no direct per-agent calls" early.
            errors.append(
                f"{agent.agent_id}: references other agent port(s) in {rel}: "
                f"{[(p, baseline_ports_to_agent[p]) for p in sorted(set(cross_ports))]}"
            )

        file_records.append(
            {
                "path": rel,
                "size": size,
                "sha256": file_hash,
                "imports": imports,
                "endpoints": endpoints,
                "ports_detected": ports_detected,
                "agent_references": agent_refs,
                "html_data_attrs": html_attrs,
                "flags": flags,
            }
        )

    # Validate unknown opena refs
    for ref in sorted(agg_refs):
        n = int(ref.replace("opena", ""))
        if n < AGENT_ID_MIN or n > AGENT_ID_MAX:
            errors.append(f"{agent.agent_id}: unknown agent reference '{ref}'")

    per_agent = {
        "id": agent.agent_id,
        "name": agent.name,
        "port": agent.port,
        "role": agent.role,
        "folder": agent.folder,
        "visibility": agent.visibility,
        "description": agent.description,
        "exists": True,
        "file_count": len(file_records),
        "files": file_records,
        "totals": {
            "bytes": total_bytes,
            "ports_detected": sorted(agg_ports),
            "agent_references": sorted(agg_refs),
            "endpoints": sorted(agg_endpoints),
            "imports": sorted(agg_imports),
        },
        "flags": {
            "missing_folder": False,
            "empty_folder": len(file_records) == 0,
        },
    }

    return per_agent, errors


# ------------------------------- Main -----------------------------------------

def main() -> int:
    ap = argparse.ArgumentParser(description="Deterministic agent discovery (baseline-driven).")
    ap.add_argument("--root", default=".", help="Repository root (default: .)")
    ap.add_argument("--baseline", default=DEFAULT_BASELINE, help=f"Baseline YAML (default: {DEFAULT_BASELINE})")
    ap.add_argument("--out", default=DEFAULT_OUT, help=f"Output JSON (default: {DEFAULT_OUT})")
    ap.add_argument("--fail-on-cross-agent-ports", action="store_true", default=True,
                    help="Fail if files reference other agents' baseline ports (default: true).")
    ap.add_argument("--allow-cross-agent-ports", action="store_true", default=False,
                    help="Override and do NOT fail on cross-agent port literals (still reported).")
    args = ap.parse_args()

    root = Path(args.root).resolve()
    baseline_path = (root / args.baseline).resolve()
    out_path = (root / args.out).resolve()

    try:
        baseline_data, baseline_agents, baseline_hash = load_baseline(baseline_path)
    except Exception as e:
        print(f"[FATAL] Baseline-Load/Validation fehlgeschlagen: {e}", file=sys.stderr)
        return 1

    # Build port->agent map from baseline
    port_to_agent: Dict[int, str] = {}
    for a in baseline_agents:
        port_to_agent[a.port] = a.agent_id

    inventory_agents: List[Dict[str, Any]] = []
    all_errors: List[str] = []

    # Discover all agents
    for agent in baseline_agents:
        per_agent, errs = discover_agent_folder(root, agent, port_to_agent)
        inventory_agents.append(per_agent)
        all_errors.extend(errs)

    # Global checks: ensure every agent folder exists + non-empty
    # (already added to errors per agent)
    # Also ensure forbidden ports never appear anywhere as literals.
    # (already flagged per file)

    # Optional strictness: cross-agent port usage enforcement
    if args.allow_cross_agent_ports:
        # remove only cross-agent-port errors, keep forbidden port errors
        filtered: List[str] = []
        for e in all_errors:
            if "references other agent port(s)" in e:
                continue
            filtered.append(e)
        all_errors = filtered

    # Build deterministic output
    out: Dict[str, Any] = {
        "baseline": {
            "path": str(Path(args.baseline)),
            "sha256": baseline_hash,
            "agent_count": len(baseline_agents),
        },
        "port_policy": {
            "allowed_range": [ALLOWED_PORT_MIN, ALLOWED_PORT_MAX],
            "forbidden_ports": sorted(FORBIDDEN_PORTS),
        },
        "summary": {
            "total_agents": len(inventory_agents),
            "total_files": sum(a.get("file_count", 0) for a in inventory_agents),
            "total_bytes": sum((a.get("totals") or {}).get("bytes", 0) for a in inventory_agents),
            "agents_missing_folder": sorted([a["id"] for a in inventory_agents if (a.get("flags") or {}).get("missing_folder")]),
            "agents_empty_folder": sorted([a["id"] for a in inventory_agents if (a.get("flags") or {}).get("empty_folder")]),
            "errors": stable_sorted(all_errors),
        },
        "agents": sorted(inventory_agents, key=lambda a: int(str(a["id"]).replace("opena", ""))),
    }

    # Ensure output directory exists
    out_path.parent.mkdir(parents=True, exist_ok=True)

    # Write JSON with stable formatting
    with out_path.open("w", encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2, sort_keys=True)

    # Fail-fast if any errors
    if all_errors:
        print(f"[FAIL] Discovery completed with {len(all_errors)} error(s). Output written: {out_path}", file=sys.stderr)
        for e in stable_sorted(all_errors):
            print(f" - {e}", file=sys.stderr)
        return 1

    print(f"[OK] Discovery successful. Output written: {out_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

