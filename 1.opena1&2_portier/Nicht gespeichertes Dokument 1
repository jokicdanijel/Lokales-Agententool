# scripts/preflight_orchestrator.py
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]

STEPS = [
    ("validate_baseline", ["python3", "-m", "scripts.validate_baseline"]),
    ("agent_discovery", ["python3", "-m", "scripts.agent_discovery"]),
    ("build_entitlements", ["python3", "-m", "scripts.build_entitlements"]),
    ("validate_entitlements", ["python3", "-m", "scripts.validate_entitlements"]),
    ("generate_html", ["python3", "-m", "opena20.compiler.generate_html"]),
    ("tests", ["pytest", "-q"]),
]

def run_step(name: str, cmd: list[str]) -> int:
    print(f"\n== {name} ==")
    p = subprocess.run(cmd, cwd=REPO_ROOT)
    if p.returncode != 0:
        print(f"❌ step failed: {name} (rc={p.returncode})")
    else:
        print(f"✅ step ok: {name}")
    return p.returncode

def main() -> int:
    for name, cmd in STEPS:
        rc = run_step(name, cmd)
        if rc != 0:
            return rc
    print("\n🎯 preflight orchestrator: ALL GREEN")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())

