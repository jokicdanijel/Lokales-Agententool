def fail(msg: str) -> None:
    raise SystemExit(f"❌ {msg}")


def read_yaml(path: Path) -> Dict[str, Any]:
    if not path.exists():
        fail(f"Missing input: {path}")
    return yaml.safe_load(path.read_text(encoding="utf-8")) or {}


def read_json(path: Path) -> Any:
    if not path.exists():
        fail(f"Missing input: {path}")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        fail(f"Invalid JSON at {path}: {e}")


def esc(s: Any) -> str:
    s = "" if s is None else str(s)
    return (
        s.replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
        .replace("'", "&#39;")
    )


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def ensure_no_style_script(html: str, where: str) -> None:
    low = html.lower()
    if "<script" in low or "</script" in low:
        fail(f"Script tag found in {where}")
    if "<style" in low or "</style" in low:
        fail(f"Style tag found in {where}")
    if ".css" in low or ".js" in low:
        # rough, but catches accidental external refs
        if "data-api" not in low:
            fail(f"Suspicious .css/.js reference in {where}")


def write_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    ensure_no_style_script(content, str(path))
    path.write_text(content, encoding="utf-8")


def normalize_agents(agent_inventory: Any) -> List[Dict[str, Any]]:
    """
    Accepts common forms:
      - {"agents":[{...}]}
      - [{...}, {...}]
    Requires each agent to have id like "opena1".."opena21" or numeric index.
    """
    agents = agent_inventory.get("agents") if isinstance(agent_inventory, dict) else agent_inventory
    if not isinstance(agents, list):
        fail("agent_inventory.json must be a list or an object with key 'agents'")
    norm: List[Dict[str, Any]] = []
    for a in agents:
        if not isinstance(a, dict):
            continue
        aid = a.get("id") or a.get("agent_id") or a.get("name")
        if not aid:
            continue
        norm.append({**a, "id": str(aid)})
    # Sort by numeric suffix if present
    def key_fn(x: Dict[str, Any]) -> Tuple[int, str]:
        sid = x["id"]
        digits = "".join(ch for ch in sid if ch.isdigit())
        return (int(digits) if digits.isdigit() else 10**9, sid)
    norm.sort(key=key_fn)
    return norm


def normalize_entitlements(ent: Any) -> Dict[str, List[str]]:
    """
    Returns plan_id -> list of entitled agent_ids

    Supports shapes like:
      - {"plans":{"basic":{"agents":[...]}, ...}}
      - {"basic":{"agents":[...]},"pro":{"agents":[...]}}
      - {"entitlements":{"plans":{...}}}
      - {"plans":{"basic":{"agent_ids":[...]} } }
    """
    if not isinstance(ent, dict):
        fail("entitlements.json must be an object")

    root = ent
    if "entitlements" in root and isinstance(root["entitlements"], dict):
        root = root["entitlements"]

    plans = root.get("plans", root)
    if not isinstance(plans, dict):
        fail("entitlements.json: cannot find 'plans' object")

    out: Dict[str, List[str]] = {}
    for plan_id, pdata in plans.items():
        if not isinstance(pdata, dict):
            continue
        agents = pdata.get("agents") or pdata.get("agent_ids") or pdata.get("allowed_agents")
        if agents is None and isinstance(pdata.get("entitlements"), dict):
            agents = pdata["entitlements"].get("agents")
        if agents is None:
            continue
        if not isinstance(agents, list):
            continue
        out[str(plan_id)] = [str(x) for x in agents]
    # Ensure required plan keys exist (as per constraints)
    for pid in ["basic", "pro", "premium", "ultimum"]:
        out.setdefault(pid, [])
    return out


