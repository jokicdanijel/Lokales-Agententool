  "trial_enabled": true,
  "trial_started_at": "2025-01-01T10:00:00Z",
  "trial_day": 3,
  "subscription_status":  "trial"
}



### Berechnung (automatisch)

python
def calculate_trial_day(user: User) -> int:
    started = datetime.fromisoformat(user. trial_started_at)
    now = datetime.now()
    delta = now - started
    return min(delta.days + 1, TRIAL_DAYS + 1)



