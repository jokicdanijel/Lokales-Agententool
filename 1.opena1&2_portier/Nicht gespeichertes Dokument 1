#!/usr/bin/env python3
# -*- coding: utf-8 -*-

from __future__ import annotations

from dataclasses import dataclass
from functools import lru_cache
from pathlib import Path
from typing import Any, Dict, List, Optional


ROOT = Path(__file__).resolve().parent
BASELINE_PATH = ROOT / "system_baseline.yaml"


@dataclass(frozen=True)
class AgentInfo:
    id: str
    name: str
    port: int
    role: str
    folder: str
    visibility: str
    description: str


def _load_yaml(path: Path) -> Dict[str, Any]:
    if not path.exists():
        raise FileNotFoundError(f"Baseline not found: {path}")
    try:
        import yaml  # type: ignore
    except Exception as e:  # pragma: no cover
        raise RuntimeError("PyYAML is required to load system_baseline.yaml") from e

    data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    if not isinstance(data, dict):
        raise ValueError("Baseline YAML root must be a mapping/dict")
    return data


@lru_cache(maxsize=1)
def load_agents_from_baseline(baseline_path: Path = BASELINE_PATH) -> List[AgentInfo]:
    """
    Single source of truth: system_baseline.yaml
    This eliminates hardcoded ports and prevents drift between UI and baseline.
    """
    data = _load_yaml(baseline_path)
    agents = data.get("agents")
    if not isinstance(agents, list):
        raise ValueError("Baseline must contain 'agents' as list")

    out: List[AgentInfo] = []
    for a in agents:
        if not isinstance(a, dict):
            continue
        agent_id = str(a.get("id", "")).strip()
        if not agent_id:
            continue
        out.append(
            AgentInfo(
                id=agent_id,
                name=str(a.get("name", "")).strip(),
                port=int(a.get("port")),
                role=str(a.get("role", "")).strip(),
                folder=str(a.get("folder", "")).strip(),
                visibility=str(a.get("visibility", "")).strip(),
                description=str(a.get("description", "")).strip(),
            )
        )

    out.sort(key=lambda x: int(x.id.replace("opena", "")) if x.id.startswith("opena") else x.id)
    return out


@lru_cache(maxsize=1)
def agent_ports() -> Dict[str, int]:
    return {a.id: a.port for a in load_agents_from_baseline()}


def get_agent_port(agent_id: str) -> int:
    ports = agent_ports()
    if agent_id not in ports:
        raise KeyError(f"Unknown agent id: {agent_id}")
    return ports[agent_id]


def build_dashboard_model() -> List[Dict[str, Any]]:
    """
    Returns a baseline-driven model that a UI layer can render.
    No direct port literals exist in this file; ports come from baseline only.
    """
    agents = load_agents_from_baseline()
    return [
        {
            "id": a.id,
            "name": a.name,
            "port": a.port,
            "role": a.role,
            "folder": a.folder,
            "visibility": a.visibility,
            "description": a.description,
        }
        for a in agents
    ]


def find_agent(agent_id: str) -> Optional[AgentInfo]:
    for a in load_agents_from_baseline():
        if a.id == agent_id:
            return a
    return None


def main() -> int:
    # Intentionally no prints/logging here to keep tooling hooks clean.
    # Consumers should import build_dashboard_model() and render it.
    _ = build_dashboard_model()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

