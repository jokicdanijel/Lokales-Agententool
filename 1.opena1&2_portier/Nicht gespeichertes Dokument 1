# ✅ CORRECT (Redis)
import redis. asyncio as redis

redis_client = redis.from_url(
    f"redis://:{os.getenv('REDIS_PASSWORD')}@{os.getenv('REDIS_HOST')}:6379"
)

async def create_session(user_id: str, session_id: str):
    await redis_client.setex(
        f"session:{session_id}",
        30 * 24 * 3600,  # 30 days
        user_id
    )

async def get_session(session_id: str) -> Optional[str]:
    user_id = await redis_client. get(f"session:{session_id}")
    return user_id. decode() if user_id else None



