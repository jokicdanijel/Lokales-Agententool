def scan_repo_files(
    root: Path,
) -> Tuple[
    Dict[str, List[Tuple[str, int, str]]],
    Dict[int, List[Tuple[str, int, str, dict]]],
]:
    """Scan repository files and return:
    - opena_refs: { 'opena3': [(file, line, snippet), ...] }
    - ports_refs: { 12345: [(file, line, snippet, ctx), ...] }

    Improvements:
    - Only scan policy-relevant runtime/config file types to reduce noise
    - Record ports with context (host_binding True/False)
    - Keep per-line granularity to enable line-based mismatch checks
    """
    opena_refs: Dict[str, List[Tuple[str, int, str]]] = {}
    ports_refs: Dict[int, List[Tuple[str, int, str, dict]]] = {}

    # Skip dirs that often contain examples/deps which would create false positives
    skip_dirs = {
        ".git",
        ".venv",
        "venv",
        "node_modules",
        "__pycache__",
        "build",
        "dist",
        "artifacts",
        "tests",
        "archive",
    }

    # Keep this tight: policy-relevant runtime/config only (avoid docs/html noise)
    allowed_suffixes = {
        ".py",
        ".yml",
        ".yaml",
        ".env",
        ".toml",
        ".json",
        ".ini",
        ".sh",
        ".conf",
        ".service",
    }
    allowed_names = {"Dockerfile", "docker-compose.yml", "docker-compose.yaml"}

    for p in root.rglob("*"):
        if p.is_dir():
            continue

        rel = p.relative_to(root)
        if any(part in skip_dirs for part in rel.parts):
            continue

        if not (p.suffix in allowed_suffixes or p.name in allowed_names):
            continue

        try:
            text = p.read_text(encoding="utf-8")
        except Exception:
            continue

        for lineno, line in enumerate(text.splitlines(), start=1):
            for m in RE_OPENA.finditer(line):
                aid = m.group(1).lower() + m.group(2)
                opena_refs.setdefault(aid, []).append((str(rel), lineno, line.strip()))

            for m in RE_NUMBER.finditer(line):
                num = int(m.group(1))
                if not (num in FORBIDDEN_PORTS or (ALLOWED_MIN <= num <= ALLOWED_MAX)):
                    continue

                ctx = {"host_binding": False}

                # Docker port mapping host:container -> host is LEFT side
                # Only treat as host binding when THIS num is on the LEFT.
                for mm in re.finditer(r"(?<!\d)(\d{1,5})\s*:\s*(\d{1,5})(?!\d)", line):
                    try:
                        host_p = int(mm.group(1))
                        if host_p == num:
                            ctx["host_binding"] = True
                            break
                    except Exception:
                        pass

                # host:port patterns
                if not ctx["host_binding"] and re.search(
                    rf"\b(?:0\.0\.0\.0|localhost|127\.0\.0\.1):{num}\b", line
                ):
                    ctx["host_binding"] = True

                # nginx-style listen
                if not ctx["host_binding"] and re.search(
                    rf"\blisten\b\s+{num}\b", line, flags=re.IGNORECASE
                ):
                    ctx["host_binding"] = True

                # explicit env/assignments (avoid matching random text like "Port 8080 is forbidden")
                if not ctx["host_binding"] and (
                    re.search(rf"\bPORT\b\s*=\s*{num}\b", line)
                    or re.search(rf"\bport\b\s*[:=]\s*{num}\b", line)
                ):
                    ctx["host_binding"] = True

                ports_refs.setdefault(num, []).append((str(rel), lineno, line.strip(), ctx))

    return opena_refs, ports_refs

