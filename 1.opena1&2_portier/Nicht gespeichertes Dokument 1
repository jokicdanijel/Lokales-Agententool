def is_agent_allowed(user_plan: str, agent_id: str) -> bool:
    with open('config/plan_entitlements.json') as f:
        entitlements = json.load(f)

    plan = entitlements['plans']. get(user_plan, {})
    allowed_agents = plan.get('agents', [])

    # Check core/system agents (always allowed)
    core_agents = entitlements['plans']['core']['agents']
    system_agents = entitlements['plans']['system']['agents']

    return agent_id in (allowed_agents + core_agents + system_agents)



