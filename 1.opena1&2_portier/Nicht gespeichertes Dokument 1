#!/usr/bin/env python3
"""
Entitlements Validator (Prompt 3)

Inputs:
  - system_baseline.yaml
  - build/entitlements.json

Outputs:
  - artifacts/entitlements_validation.json

Validations:
  - no agent outside baseline
  - every baseline agent exists in every plan
  - inclusion ordering: ultimum ⊇ premium ⊇ pro ⊇ basic (visible/clickable & limits monotonic)
  - basic: exactly 4 clickable NON-CORE agents: opena3, opena4, opena7, opena11
Deterministic:
  - stable JSON
  - exit code 1 on any error
"""

from __future__ import annotations

import hashlib
import json
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Tuple

try:
    import yaml  # type: ignore
except Exception:
    print("ERROR: PyYAML is required. Install with: pip install pyyaml", file=sys.stderr)
    raise

REPO_ROOT = Path(__file__).resolve().parents[1]

BASELINE_PATH = REPO_ROOT / "system_baseline.yaml"
ENTITLEMENTS_PATH = REPO_ROOT / "build" / "entitlements.json"
OUT_REPORT = REPO_ROOT / "artifacts" / "entitlements_validation.json"

PLANS_ORDER = ["basic", "pro", "premium", "ultimum"]

CORE_AGENTS = {"opena1", "opena2"}
SYSTEM_AGENTS = {"opena20", "opena21"}
BASIC_CLICKABLE_NON_CORE = {"opena3", "opena4", "opena7", "opena11"}

LOGS_ORDER = {
    "read-only": 0,
    "read-write": 1,
}


def sha256_bytes(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def sha256_file(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def stable_agent_sort_key(agent_id: str) -> Tuple[int, str]:
    try:
        n = int(agent_id.replace("opena", ""))
    except Exception:
        n = 10_000
    return (n, agent_id)


def load_yaml(path: Path) -> Any:
    if not path.exists():
        raise FileNotFoundError(str(path))
    return yaml.safe_load(path.read_text(encoding="utf-8"))


def load_json(path: Path) -> Any:
    if not path.exists():
        raise FileNotFoundError(str(path))
    return json.loads(path.read_text(encoding="utf-8"))


def write_json_deterministic(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = json.dumps(obj, sort_keys=True, ensure_ascii=False, indent=2)
    path.write_text(text + "\n", encoding="utf-8")


def baseline_agent_ids(baseline: Dict[str, Any]) -> List[str]:
    agents = baseline.get("agents")
    if not isinstance(agents, list):
        return []
    out: List[str] = []
    for a in agents:
        if isinstance(a, dict) and "id" in a:
            out.append(str(a["id"]))
    return sorted(out, key=stable_agent_sort_key)


def compare_limits(lower: Dict[str, Any], higher: Dict[str, Any], errors: List[str], ctx: str) -> None:
    # numeric monotonic checks for known keys
    lower_limits = lower.get("limits") or {}
    higher_limits = higher.get("limits") or {}

    for key in ["workflow_limit"]:
        lv = lower_limits.get(key)
        hv = higher_limits.get(key)
        if isinstance(lv, int) and isinstance(hv, int):
            if hv < lv:
                errors.append(f"{ctx}: limit '{key}' decreased ({lv} -> {hv})")


def compare_gates(lower: Dict[str, Any], higher: Dict[str, Any], errors: List[str], ctx: str) -> None:
    lg = lower.get("gates") or {}
    hg = higher.get("gates") or {}

    # logs gate: higher must be >= lower if both present
    lv = lg.get("logs")
    hv = hg.get("logs")
    if isinstance(lv, str) and isinstance(hv, str) and lv in LOGS_ORDER and hv in LOGS_ORDER:
        if LOGS_ORDER[hv] < LOGS_ORDER[lv]:
            errors.append(f"{ctx}: gate 'logs' became more restrictive ({lv} -> {hv})")


def main() -> int:
    errors: List[str] = []
    now = datetime.now(timezone.utc).isoformat()

    try:
        baseline = load_yaml(BASELINE_PATH)
    except Exception as e:
        errors.append(f"Cannot load baseline: {e}")
        baseline = {}

    try:
        entitlements = load_json(ENTITLEMENTS_PATH)
    except Exception as e:
        errors.append(f"Cannot load entitlements: {e}")
        entitlements = {}

    b_ids = baseline_agent_ids(baseline) if isinstance(baseline, dict) else []
    b_set = set(b_ids)

    # top-level plans check
    if not isinstance(entitlements, dict):
        errors.append("entitlements.json must be a JSON object")
    else:
        missing_plans = [p for p in PLANS_ORDER if p not in entitlements]
        extra_plans = [p for p in entitlements.keys() if p not in PLANS_ORDER]
        if missing_plans:
            errors.append(f"Missing plans in entitlements.json: {missing_plans}")
        if extra_plans:
            errors.append(f"Unexpected top-level keys (only plans allowed): {extra_plans}")

    # per-plan agent key checks
    for plan in PLANS_ORDER:
        plan_map = entitlements.get(plan)
        if not isinstance(plan_map, dict):
            errors.append(f"Plan '{plan}' must map to object of agent_id -> entitlement")
            continue

        plan_agents = set(plan_map.keys())

        extras = sorted(plan_agents - b_set, key=stable_agent_sort_key)
        missing = sorted(b_set - plan_agents, key=stable_agent_sort_key)
        if extras:
            errors.append(f"Plan '{plan}' contains agents not in baseline: {extras}")
        if missing:
            errors.append(f"Plan '{plan}' missing baseline agents: {missing}")

    # basic clickable policy (NON-CORE)
    basic = entitlements.get("basic", {}) if isinstance(entitlements, dict) else {}
    if isinstance(basic, dict):
        clickable_non_core = set()
        for aid, row in basic.items():
            if aid in CORE_AGENTS or aid in SYSTEM_AGENTS:
                continue
            if isinstance(row, dict) and row.get("clickable") is True:
                clickable_non_core.add(aid)

        if clickable_non_core != BASIC_CLICKABLE_NON_CORE:
            errors.append(
                f"Basic NON-CORE clickable set must equal {sorted(BASIC_CLICKABLE_NON_CORE, key=stable_agent_sort_key)} "
                f"but got {sorted(clickable_non_core, key=stable_agent_sort_key)}"
            )

        # also ensure core is clickable
        for core in CORE_AGENTS:
            row = basic.get(core)
            if not (isinstance(row, dict) and row.get("clickable") is True and row.get("visible") is True):
                errors.append(f"Core agent '{core}' must be visible & clickable in Basic")
    else:
        errors.append("Basic plan object missing or invalid")

    # inclusion ordering: ultimum ⊇ premium ⊇ pro ⊇ basic
    def plan_obj(p: str) -> Dict[str, Any]:
        v = entitlements.get(p, {})
        return v if isinstance(v, dict) else {}

    basic_o = plan_obj("basic")
    pro_o = plan_obj("pro")
    prem_o = plan_obj("premium")
    ulti_o = plan_obj("ultimum")

    chain = [("basic", basic_o, "pro", pro_o), ("pro", pro_o, "premium", prem_o), ("premium", prem_o, "ultimum", ulti_o)]
    for lower_name, lower_map, higher_name, higher_map in chain:
        for aid in b_ids:
            lrow = lower_map.get(aid)
            hrow = higher_map.get(aid)
            if not isinstance(lrow, dict) or not isinstance(hrow, dict):
                continue

            ctx = f"{aid} ({lower_name} -> {higher_name})"

            # visible monotonic
            if lrow.get("visible") is True and hrow.get("visible") is not True:
                errors.append(f"{ctx}: visible became false")

            # clickable monotonic
            if lrow.get("clickable") is True and hrow.get("clickable") is not True:
                errors.append(f"{ctx}: clickable became false")

            compare_limits(lrow, hrow, errors, ctx)
            compare_gates(lrow, hrow, errors, ctx)

    report = {
        "timestamp_utc": now,
        "success": len(errors) == 0,
        "baseline_sha256": sha256_file(BASELINE_PATH) if BASELINE_PATH.exists() else None,
        "entitlements_sha256": sha256_file(ENTITLEMENTS_PATH) if ENTITLEMENTS_PATH.exists() else None,
        "errors": errors,
    }

    write_json_deterministic(OUT_REPORT, report)

    if errors:
        print("Entitlements validation FAILED:", file=sys.stderr)
        for e in errors:
            print(f"- {e}", file=sys.stderr)
        return 1

    print("Entitlements validation OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

