    """Agent-Informationen für Registry"""

    id: str = Field(..., description="Agent ID (z.B. opena3)")
    name: str = Field(..., description="Human-readable Name")
    kuerzel: str = Field(..., description="PORTIER Kürzel")
    port: int = Field(..., description="Service Port")
    enabled: bool = Field(default=True, description="Agent aktiviert")

    class Config:
        extra = "forbid"


def build_agent_registry_from_baseline() -> List[AgentInfo]:
    try:
        from scripts.baseline_utils import build_agent_info_list  # type: ignore
    except Exception:
        return AGENT_REGISTRY_FALLBACK()

    out: List[AgentInfo] = []
    for item in build_agent_info_list():
        out.append(
