                id=item.get("id", ""),
                name=item.get("name", ""),
                kuerzel=item.get("kuerzel", ""),
                port=item.get("port") or 0,
                enabled=item.get("enabled", True),
            )
        )
    return out


def AGENT_REGISTRY_FALLBACK() -> List[AgentInfo]:
    # minimal fallback to preserve runtime if baseline not available
    return [
