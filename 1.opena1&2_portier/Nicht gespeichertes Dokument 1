    ]


AGENT_REGISTRY: List[AgentInfo] = build_agent_registry_from_baseline()


# ==================== SSE Configuration ====================

class SSEConfig(BaseModel):
    """SSE Bus Konfiguration"""

    max_connections: int = Field(default=100, description="Max. gleichzeitige SSE-Verbindungen")
