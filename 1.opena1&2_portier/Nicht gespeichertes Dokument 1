def scan_repo_files(root: Path) -> Tuple[Dict[str, List[Tuple[str, int, str]]], Dict[int, List[Tuple[str, int, str, dict]]]]:
    """Scan repository files and return:
    - opena_refs: { 'opena3': [(file, line, snippet), ...] }
    - ports_refs: { 12345: [(file, line, snippet, ctx), ...] }

    Improvements:
    - Only scan relevant file types to reduce noise
    - Record ports with context (host_binding True/False)
    - Keep per-line granularity to enable line-based mismatch checks
    """
    opena_refs: Dict[str, List[Tuple[str, int, str]]] = {}
    ports_refs: Dict[int, List[Tuple[str, int, str, dict]]] = {}

    skip_dirs = {".git", "venv", "node_modules", "__pycache__", "build", "dist", "artifacts"}

    # Only scan files with these extensions or specific filenames
    allowed_suffixes = {".py", ".yml", ".yaml", ".env", ".toml", ".json", ".ini", ".sh"}
    allowed_names = {"Dockerfile", "docker-compose.yml", "docker-compose.yaml"}

    for p in root.rglob("*"):
        # skip directories explicitly
        if p.is_dir():
            continue

        rel = p.relative_to(root)
        if any(part in skip_dirs for part in rel.parts):
            continue

        # filter by extension or special filenames
        if not (p.suffix in allowed_suffixes or p.name in allowed_names):
            # tiny heuristic: skip large binary-like files
            try:
                if p.stat().st_size > 200_000:  # >200kB
                    continue
            except Exception:
                continue

        # Only scan text files
        try:
            text = p.read_text(encoding="utf-8")
        except Exception:
            continue

        for lineno, line in enumerate(text.splitlines(), start=1):
            found_ids = []
            for m in RE_OPENA.finditer(line):
                aid = m.group(1).lower() + m.group(2)
                found_ids.append(aid)
                opena_refs.setdefault(aid, []).append((str(rel), lineno, line.strip()))

            # For ports, also determine simple "host binding" context
            for m in RE_NUMBER.finditer(line):
                num = int(m.group(1))
                if not (num in FORBIDDEN_PORTS or (ALLOWED_MIN <= num <= ALLOWED_MAX)):
                    continue

                ctx = {"host_binding": False}
                # Docker port mapping like "12390:3000" or "3000:3000" -> left side is host
                if re.search(rf"\b\d{{1,5}}:{num}\b", line):
                    ctx["host_binding"] = True
                # host:port or 0.0.0.0:port or localhost:port
                elif re.search(rf"\b(?:0\.0\.0\.0|localhost|127\.0\.0\.1):{num}\b", line):
                    ctx["host_binding"] = True
                # explicit listen or port assignment is suspicious
                elif re.search(rf"\blisten\b.*\b{num}\b", line, flags=re.IGNORECASE) or re.search(rf"\bport\b.*\b{num}\b", line, flags=re.IGNORECASE):
                    ctx["host_binding"] = True

                ports_refs.setdefault(num, []).append((str(rel), lineno, line.strip(), ctx))
    return opena_refs, ports_refs


def validate(baseline: Dict[str, Any], inventory_ids: Optional[List[str]], opena_refs: Dict[str, Any], ports_refs: Dict[int, Any]) -> Tuple[Dict[str, Any], bool]:
    results: Dict[str, Any] = {}
    ok = True

    # Check baseline IDs are exactly opena1..opena21
    expected_ids = {f"opena{i}" for i in range(1, 22)}
    baseline_ids = set(baseline.keys())
    results["baseline_ids"] = sorted(list(baseline_ids))
    if baseline_ids != expected_ids:
        ok = False
        results["baseline_id_mismatch"] = {
            "missing": sorted(list(expected_ids - baseline_ids)),
            "extra": sorted(list(baseline_ids - expected_ids)),
        }
    else:
        results["baseline_id_mismatch"] = {"missing": [], "extra": []}

    # Validate baseline ports unique and in range
    port_map: Dict[int, List[str]] = {}
    for aid, info in baseline.items():
        port = info.get("port")
        if port is None:
            ok = False
            results.setdefault("baseline_errors", []).append(f"{aid} missing port")
            continue
        if not (ALLOWED_MIN <= port <= ALLOWED_MAX):
            ok = False
            results.setdefault("baseline_errors", []).append(f"{aid} port {port} out of allowed range")
        port_map.setdefault(port, []).append(aid)
    dup_ports = {p: ids for p, ids in port_map.items() if len(ids) > 1}
    if dup_ports:
        ok = False
        results["duplicate_ports_in_baseline"] = dup_ports
    else:
        results["duplicate_ports_in_baseline"] = {}

    # Forbidden ports in repo: only consider host_binding contexts (we don't want to flag container/internal ports)
    forbidden_found = {}
    for p in FORBIDDEN_PORTS:
        occ = ports_refs.get(p, [])
        host_occ = [o for o in occ if isinstance(o, tuple) and o[3].get("host_binding")]
        if host_occ:
            forbidden_found[p] = host_occ
    if forbidden_found:
        ok = False
    results["forbidden_ports_found"] = forbidden_found

    # Any openaX outside 1..21
    outside = {}
    for aid in opena_refs.keys():
        m = re.match(r"opena([0-9]{1,3})", aid)
        if not m:
            continue
        n = int(m.group(1))
        if not (1 <= n <= 21):
            outside[aid] = opena_refs[aid]
    if outside:
        ok = False
    results["opena_outside_range"] = outside

    # Check that ports in repo align with baseline mapping only when the mapping is local
    # (same line or within a small window). This avoids file-level false positives.
    mismatches: List[Dict[str, Any]] = []

    # Build per-file lines once
    file_lines: Dict[str, List[str]] = {}

    def _get_lines(relpath: str) -> List[str]:
        if relpath not in file_lines:
            try:
                file_lines[relpath] = (ROOT / relpath).read_text(encoding="utf-8").splitlines()
            except Exception:
                file_lines[relpath] = []
        return file_lines[relpath]

    # Pattern: capture opena id and a port in nearby context (JSON/YAML-ish)
    re_id = re.compile(r"\b(opena[0-9]{1,3})\b", re.IGNORECASE)
    re_port_kv = re.compile(r"\bport\b\s*[:=]\s*['\"]?([0-9]{3,5})\b")

    # Build a set of files that contain ids (from opena_refs)
    files_with_ids = set()
    for aid, occ in opena_refs.items():
        for f, ln, line in occ:
            files_with_ids.add(f)

    for f in sorted(files_with_ids):
        lines = _get_lines(f)
        if not lines:
            continue

        for i, line in enumerate(lines):
            m_id = re_id.search(line)
            if not m_id:
                continue
            aid = m_id.group(1).lower()

            expected_port = baseline.get(aid, {}).get("port")
            if expected_port is None:
                continue

            # Look for "port: N" on same line or within next 5 lines
            window = lines[i : i + 6]
            found_ports: List[int] = []
            for wline in window:
                m_port = re_port_kv.search(wline)
                if m_port:
                    found_ports.append(int(m_port.group(1)))

            for p in found_ports:
                if p != expected_port:
                    mismatches.append(
                        {"file": f, "id": aid, "found_port": p, "expected_port": expected_port, "line": i + 1}
                    )

    if mismatches:
        ok = False
    results["file_id_port_mismatches"] = mismatches

    # If inventory present, ensure it matches baseline set (no extra/missing)
    if inventory_ids is not None:
        inv_set = set(inventory_ids)
        results["inventory_ids"] = sorted(list(inv_set))
        if inv_set != expected_ids:
            ok = False
            results["inventory_mismatch"] = {
                "missing": sorted(list(expected_ids - inv_set)),
                "extra": sorted(list(inv_set - expected_ids)),
            }
    else:
        results["inventory_ids"] = None

    results["summary"] = {
        "ok": ok,
        "total_baseline_ids": len(baseline_ids),
        "total_opena_refs_found": len(opena_refs),
        "total_ports_found": len(ports_refs),
    }
    return results, ok


def render_md(results: Dict[str, Any]) -> str:
    lines: List[str] = []
    lines.append("# Ports & Agent IDs Compliance Scan")
    lines.append("")
    lines.append(f"**Result:** {'PASS' if results.get('summary', {}).get('ok') else 'FAIL'}")
    lines.append("")
    lines.append("## Baseline IDs")
    lines.append(f"Found {len(results.get('baseline_ids', []))} baseline agent IDs")
    if results.get("baseline_id_mismatch"):
        bm = results["baseline_id_mismatch"]
        lines.append(f"- Missing: {bm.get('missing')}\n- Extra: {bm.get('extra')}")
    lines.append("")
    lines.append("## Forbidden ports found")
    forbidden = results.get("forbidden_ports_found") or {}
    if forbidden:
        lines.append("⚠️ Forbidden ports were found in repository references:")
        for p, occ in forbidden.items():
            lines.append(f"- Port {p} in {len(occ)} locations")
    else:
        lines.append("No forbidden ports found.")
    lines.append("")

    lines.append("## File ID/Port mismatches")
    if results.get("file_id_port_mismatches"):
        for m in results["file_id_port_mismatches"]:
            lines.append(f"- File {m['file']}: {m['id']} found port {m['found_port']}, expected {m['expected_port']}")
    else:
        lines.append("No explicit ID->port mismatches detected in the same files.")
    lines.append("")

    if results.get("opena_outside_range"):
        lines.append("## opena IDs outside 1..21 found")
        for aid, occ in results["opena_outside_range"].items():
            lines.append(f"- {aid} referenced in {len(occ)} locations")
    lines.append("")

    if results.get("inventory_mismatch"):
        im = results["inventory_mismatch"]
        lines.append("## Inventory mismatch with baseline")
        lines.append(f"- Missing: {im.get('missing')}\n- Extra: {im.get('extra')}")
        lines.append("")

    lines.append("---")
    lines.append(f"Scan generated by scanner at {ROOT.name}")
    return "\n".join(lines)


def main(argv: List[str] | None = None) -> int:
    baseline, bmsgs = load_baseline(BASELINE_FILE)
    inventory, imsgs = load_inventory()
    opena_refs, ports_refs = scan_repo_files(ROOT)

    results_raw, ok = validate(baseline, inventory, opena_refs, ports_refs)
    results = {
        "meta": {
            "root": str(ROOT),
            "baseline_file": str(BASELINE_FILE),
            "inventory_candidates_checked": [str(p) for p in INVENTORY_CANDIDATES],
        },
        "messages": {
            "baseline_parse": bmsgs,
            "inventory_parse": imsgs,
        },
        "findings": results_raw,
    }

    OUT_JSON.write_text(json.dumps(results, indent=2))
    OUT_MD.write_text(render_md(results_raw))

    if ok:
        print("✅ Ports & IDs scan PASS — artifacts written to", SCANS)
        return 0
    else:
        print("❌ Ports & IDs scan FAIL — see artifacts in", SCANS)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
