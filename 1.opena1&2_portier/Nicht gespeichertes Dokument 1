#!/usr/bin/env python3
"""
Entitlements Compiler (Prompt 3)

Inputs:
  - system_baseline.yaml
  - artifacts/agent_inventory.json

Outputs:
  - build/entitlements.json  (top-level: plan_id -> agent_id -> {visible, clickable, limits, gates})

Hard constraints:
  - plans: basic, pro, premium, ultimum
  - higher plan includes all lower plan entitlements
  - core agents opena1, opena2 are always visible & clickable (never gated)
  - system agents opena20, opena21 are visible but not necessarily clickable
  - basic: exactly 4 clickable NON-CORE agents: opena3, opena4, opena7, opena11
  - basic: gates include logs read-only
  - basic: workflow limit 4 per agent
Deterministic:
  - stable ordering
  - stable JSON formatting
  - hashes over input files (used by validator artifact, not embedded into entitlements.json to keep schema strict)
"""

from __future__ import annotations

import hashlib
import json
import os
import sys
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Tuple

try:
    import yaml  # type: ignore
except Exception as e:  # pragma: no cover
    print("ERROR: PyYAML is required. Install with: pip install pyyaml", file=sys.stderr)
    raise

REPO_ROOT = Path(__file__).resolve().parents[1]

BASELINE_PATH = REPO_ROOT / "system_baseline.yaml"
INVENTORY_PATH = REPO_ROOT / "artifacts" / "agent_inventory.json"
OUT_PATH = REPO_ROOT / "build" / "entitlements.json"


PLANS_ORDER = ["basic", "pro", "premium", "ultimum"]
PLAN_RANK = {p: i for i, p in enumerate(PLANS_ORDER)}

CORE_AGENTS = {"opena1", "opena2"}
SYSTEM_AGENTS = {"opena20", "opena21"}

# Policy: clickable sets (NON-CORE). This is the only place with plan policy.
BASIC_CLICKABLE_NON_CORE = {"opena3", "opena4", "opena7", "opena11"}
PRO_CLICKABLE_NON_CORE = BASIC_CLICKABLE_NON_CORE | {"opena5", "opena6", "opena8", "opena9"}  # 8 total
PREMIUM_CLICKABLE_NON_CORE = PRO_CLICKABLE_NON_CORE | {"opena10", "opena12", "opena13", "opena14"}  # 12 total
ULTIMUM_CLICKABLE_NON_CORE = {f"opena{i}" for i in range(3, 20)}  # opena3..opena19 = 17 total

CLICKABLE_BY_PLAN_NON_CORE = {
    "basic": BASIC_CLICKABLE_NON_CORE,
    "pro": PRO_CLICKABLE_NON_CORE,
    "premium": PREMIUM_CLICKABLE_NON_CORE,
    "ultimum": ULTIMUM_CLICKABLE_NON_CORE,
}

# Limits (fallback defaults; can be made baseline-driven later, but deterministic either way)
WORKFLOW_LIMIT_BY_PLAN = {
    "basic": 4,
    "pro": 8,
    "premium": 16,
    "ultimum": 32,
}

LOGS_MODE_BY_PLAN = {
    "basic": "read-only",
    "pro": "read-write",
    "premium": "read-write",
    "ultimum": "read-write",
}


def sha256_bytes(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def sha256_file(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def die(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    raise SystemExit(1)


def load_yaml(path: Path) -> Any:
    if not path.exists():
        die(f"Missing file: {path}")
    return yaml.safe_load(path.read_text(encoding="utf-8"))


def load_json(path: Path) -> Any:
    if not path.exists():
        die(f"Missing file: {path}")
    return json.loads(path.read_text(encoding="utf-8"))


def stable_agent_sort_key(agent_id: str) -> Tuple[int, str]:
    # opena12 -> 12
    try:
        n = int(agent_id.replace("opena", ""))
    except Exception:
        n = 10_000
    return (n, agent_id)


def ensure_dirs() -> None:
    OUT_PATH.parent.mkdir(parents=True, exist_ok=True)


def baseline_agent_ids(baseline: Dict[str, Any]) -> List[str]:
    agents = baseline.get("agents")
    if not isinstance(agents, list):
        die("system_baseline.yaml must contain 'agents' as a list")
    ids: List[str] = []
    for a in agents:
        if not isinstance(a, dict) or "id" not in a:
            die("Each baseline agent must be a dict with key 'id'")
        ids.append(str(a["id"]))
    return ids


def inventory_agent_ids(inv: Dict[str, Any]) -> List[str]:
    per_agent = inv.get("agents") or inv.get("per_agent") or inv.get("inventory")  # tolerate schema drift
    if isinstance(per_agent, dict):
        return sorted([str(k) for k in per_agent.keys()], key=stable_agent_sort_key)
    if isinstance(per_agent, list):
        out: List[str] = []
        for row in per_agent:
            if isinstance(row, dict) and "id" in row:
                out.append(str(row["id"]))
        return sorted(out, key=stable_agent_sort_key)
    die("agent_inventory.json must contain 'agents' (dict or list with id)")
    return []


def build_entitlements(baseline: Dict[str, Any], inv: Dict[str, Any]) -> Dict[str, Dict[str, Dict[str, Any]]]:
    b_ids = sorted(set(baseline_agent_ids(baseline)), key=stable_agent_sort_key)
    i_ids = set(inventory_agent_ids(inv))

    missing_in_inventory = [x for x in b_ids if x not in i_ids]
    if missing_in_inventory:
        die(f"Inventory missing agents present in baseline: {missing_in_inventory}")

    # visible: we choose "always visible" across plans (locked agents show but not clickable)
    # clickable: core always true; system default false; others per plan mapping
    entitlements: Dict[str, Dict[str, Dict[str, Any]]] = {}

    for plan in PLANS_ORDER:
        plan_map: Dict[str, Dict[str, Any]] = {}
        clickable_non_core = CLICKABLE_BY_PLAN_NON_CORE[plan]
        wf_limit = WORKFLOW_LIMIT_BY_PLAN[plan]
        logs_mode = LOGS_MODE_BY_PLAN[plan]

        for agent_id in b_ids:
            is_core = agent_id in CORE_AGENTS
            is_system = agent_id in SYSTEM_AGENTS

            visible = True

            if is_core:
                clickable = True
            elif is_system:
                clickable = False  # visible but not necessarily clickable
            else:
                clickable = agent_id in clickable_non_core

            limits = {
                "workflow_limit": wf_limit,
            }

            gates = {
                "logs": logs_mode,
            }

            # Basic must explicitly enforce read-only logs gate; others are read-write
            # (kept in gates above)

            plan_map[agent_id] = {
                "visible": bool(visible),
                "clickable": bool(clickable),
                "limits": limits,
                "gates": gates,
            }

        # Extra enforcement (hard constraint): in basic, only the 4 specified non-core are clickable
        if plan == "basic":
            for agent_id in b_ids:
                if agent_id in CORE_AGENTS:
                    continue
                if agent_id in SYSTEM_AGENTS:
                    # allow not clickable
                    continue
                should_click = agent_id in BASIC_CLICKABLE_NON_CORE
                plan_map[agent_id]["clickable"] = bool(should_click)

            # lock in basic gates/limits
            for agent_id in b_ids:
                plan_map[agent_id]["limits"]["workflow_limit"] = 4
                plan_map[agent_id]["gates"]["logs"] = "read-only"

        entitlements[plan] = plan_map

    # Ensure monotonic inclusion ordering by construction (each plan set is a superset)
    # We'll still validate separately in validate_entitlements.py.
    return entitlements


def write_json_deterministic(path: Path, obj: Any) -> None:
    # Stable formatting for deterministic diffs
    text = json.dumps(obj, sort_keys=True, ensure_ascii=False, indent=2)
    path.write_text(text + "\n", encoding="utf-8")


def main() -> int:
    baseline = load_yaml(BASELINE_PATH)
    inv = load_json(INVENTORY_PATH)

    ensure_dirs()

    entitlements = build_entitlements(baseline, inv)

    # Schema strict: only plan keys at top-level (no meta wrapper)
    write_json_deterministic(OUT_PATH, entitlements)

    print(f"Wrote {OUT_PATH.relative_to(REPO_ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

