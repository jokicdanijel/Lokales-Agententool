def main() -> None:
    baseline = read_yaml(INPUT_BASELINE)
    company = baseline.get("company") if isinstance(baseline.get("company"), dict) else baseline

    agent_inventory = read_json(INPUT_AGENT_INVENTORY)
    agents = normalize_agents(agent_inventory)

    entitlements = read_json(INPUT_ENTITLEMENTS)
    ent_map = normalize_entitlements(entitlements)

    # Ensure 21 agents (opena1..opena21) exist – if inventory is richer, we still require at least these.
    ids = {a["id"] for a in agents}
    missing = [f"opena{i}" for i in range(1, AGENT_COUNT_REQUIRED + 1) if f"opena{i}" not in ids]
    if missing:
        fail(f"agent_inventory missing required agent ids: {', '.join(missing)}")

    manifest: List[Dict[str, Any]] = []

    # Public pages
    write_text(
        OUT_PUBLIC / "index.html",
        doc_shell(
            title="Start – HyperDashboard One",
            page_id="public.index",
            plan_id=None,
            access="public",
            body=landing_page(company),
            description="Landing Page: Eden, Agents, Workflows, Governance.",
        ),
    )

    for pid in ["basic", "pro", "premium", "ultimum"]:
        write_text(
            OUT_PUBLIC / f"{pid}.html",
            doc_shell(
                title=f"{pid.capitalize()} – Plan",
                page_id=f"public.plan.{pid}",
                plan_id=pid,
                access="public",
                body=plan_page(company, pid, ent_map),
                description=f"Planseite: {pid}",
            ),
        )

    for kind in ["privacy", "terms", "imprint"]:
        title, desc, body = legal_page(company, kind)
        write_text(
            OUT_PUBLIC / "legal" / f"{kind}.html",
            doc_shell(
                title=f"{title} – Rechtliches",
                page_id=f"public.legal.{kind}",
                plan_id=None,
                access="public",
                body=body,
                description=desc,
            ),
        )

    # App pages
    write_text(
        OUT_APP / "dashboard.html",
        doc_shell(
            title="Dashboard",
            page_id="app.dashboard",
            plan_id=None,
            access="app",
            body=dashboard_page(company, agents, ent_map),
            description="Dashboard: Agents & Entitlements.",
        ),
    )

    for code in [403, 404, 500]:
        write_text(
            OUT_APP / "errors" / f"{code}.html",
            doc_shell(
                title=f"{code}",
                page_id=f"app.error.{code}",
                plan_id=None,
                access="app",
                body=error_page(code),
                description=f"Fehlerseite {code}",
            ),
        )

    # Agent pages opena1..opena21
    agent_by_id = {a["id"]: a for a in agents}
    for i in range(1, AGENT_COUNT_REQUIRED + 1):
        aid = f"opena{i}"
        write_text(
            OUT_APP / "agents" / f"{aid}.html",
            doc_shell(
                title=f"Agent {aid}",
                page_id=f"app.agent.{aid}",
                plan_id=None,
                access="app",
                body=agent_page(company, agent_by_id[aid]),
                description=f"Agent detail page: {aid}",
            ),
        )

    # Auth pages
    write_text(
        OUT_AUTH / "login.html",
        doc_shell(
            title="Login",
            page_id="auth.login",
            plan_id=None,
            access="auth",
            body=auth_login(company),
            description="Login Page",
        ),
    )
    write_text(
        OUT_AUTH / "regist.html",
        doc_shell(
            title="Registrierung",
            page_id="auth.regist",
            plan_id=None,
            access="auth",
            body=auth_regist(company),
            description="Registration Page",
        ),
    )
    write_text(
        OUT_AUTH / "forgot-password.html",
        doc_shell(
            title="Passwort vergessen",
            page_id="auth.forgot",
            plan_id=None,
            access="auth",
            body=auth_forgot(company),
            description="Forgot password Page",
        ),
    )

