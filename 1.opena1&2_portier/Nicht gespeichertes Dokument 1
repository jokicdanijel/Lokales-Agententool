#!/usr/bin/env python3
# -*- coding: utf-8 -*-

from __future__ import annotations

import json
import re
from dataclasses import dataclass, field, asdict
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Tuple

import yaml


# -----------------------------
# Policy / Defaults
# -----------------------------

DEFAULT_BASELINE = "system_baseline.yaml"
DEFAULT_OUT_JSON = "artifacts/agent_discovery.json"
DEFAULT_OUT_SUMMARY = "artifacts/agent_discovery_summary.json"

DEFAULT_IGNORE_DIRS = {
    ".git",
    ".idea",
    ".vscode",
    ".mypy_cache",
    ".pytest_cache",
    "__pycache__",
    ".venv",
    "venv",
    "venv313",
    "node_modules",
    "build",
    "dist",
    ".ruff_cache",
    ".cache",
}

MAIN_CANDIDATES = (
    "main.py",
    "app.py",
    "server.py",
    "run.py",
    "wsgi.py",
    "asgi.py",
    "app/main.py",
    "src/main.py",
    "__init__.py",
)

README_CANDIDATES = ("README.md", "README.rst", "README.txt")

TEST_GLOBS = (
    "tests/**/*.py",
    "test/**/*.py",
    "**/*_test.py",
    "**/test_*.py",
)

FASTAPI_PATTERN = re.compile(
    r"@(?:app|router)\.(get|post|put|delete|patch)\(\s*[\"']([^\"']+)",
    re.IGNORECASE,
)
FLASK_PATTERN = re.compile(r"@app\.route\(\s*[\"']([^\"']+)", re.IGNORECASE)


# -----------------------------
# Data Model
# -----------------------------

@dataclass
class AgentMetadata:
    """Vollständige Agent-Metadaten (Baseline + Discovery)"""

    # Baseline
    id: str
    name: str
    port: int
    role: str
    folder: str
    visibility: str
    description: str

    # Discovery flags
    has_main: bool = False
    has_requirements: bool = False
    has_readme: bool = False
    has_tests: bool = False
    has_dockerfile: bool = False

    # Discovery details
    main_file_path: Optional[str] = None
    requirements_count: int = 0
    readme_lines: int = 0
    test_files: List[str] = field(default_factory=list)

    # Extracted from code / docs
    endpoints: List[str] = field(default_factory=list)
    dependencies: List[str] = field(default_factory=list)
    readme_excerpt: Optional[str] = None

    # Diagnostics
    exists: bool = True
    errors: List[str] = field(default_factory=list)


# -----------------------------
# Helpers
# -----------------------------

def _contains_ignored_dir(path: Path, ignored: set[str]) -> bool:
    parts = {p for p in path.parts}
    return any(d in parts for d in ignored)


def _iter_files(root: Path, ignored_dirs: set[str]) -> Iterable[Path]:
    for p in root.rglob("*"):
        if _contains_ignored_dir(p, ignored_dirs):
            continue
        yield p


def _read_text_safe(path: Path, max_bytes: int = 512_000) -> str:
    try:
        raw = path.read_bytes()
    except Exception:
        return ""
    if len(raw) > max_bytes:
        raw = raw[:max_bytes]
    return raw.decode("utf-8", errors="ignore")


def _rel_to_root(path: Path, root: Path) -> str:
    try:
        return str(path.relative_to(root))
    except Exception:
        return str(path)


def _unique_sorted(items: Iterable[str]) -> List[str]:
    return sorted(set(items), key=lambda s: (s.lower(), s))


# -----------------------------
# Discovery Engine
# -----------------------------

class AgentDiscovery:
    """Agent-Discovery-Engine (deterministisch, statisch, fail-fast)"""

    def __init__(self, root_path: Path, baseline_path: Path, ignored_dirs: Optional[set[str]] = None):
        self.root = root_path.resolve()
        self.baseline_path = baseline_path.resolve()
        self.ignored_dirs = set(DEFAULT_IGNORE_DIRS) if ignored_dirs is None else set(ignored_dirs)
        self.baseline = self._load_baseline()
        self.discovered_agents: List[AgentMetadata] = []

    def _load_baseline(self) -> Dict[str, Any]:
        """Load system_baseline.yaml"""
        if not self.baseline_path.exists():
            raise FileNotFoundError(f"Baseline not found: {self.baseline_path}")
        with self.baseline_path.open("r", encoding="utf-8") as f:
            data = yaml.safe_load(f)
        if not isinstance(data, dict) or "agents" not in data or not isinstance(data["agents"], list):
            raise ValueError("Baseline invalid: expected dict with key 'agents' as list")
        self._validate_baseline(data)
        return data

    def _validate_baseline(self, baseline: Dict[str, Any]) -> None:
        """Fail-fast baseline sanity checks"""
        agents = baseline["agents"]
        ids = [str(a.get("id", "")).strip() for a in agents]
        ports = []
        for a in agents:
            try:
                ports.append(int(a["port"]))
            except Exception as e:
                raise ValueError(f"Baseline invalid: agent port missing/invalid for {a.get('id')}: {e}") from e

        dup_ports = sorted({p for p in ports if ports.count(p) > 1})
        if dup_ports:
            raise ValueError(f"Baseline invalid: duplicate ports: {dup_ports}")

        dup_ids = sorted({i for i in ids if ids.count(i) > 1})
        if dup_ids:
            raise ValueError(f"Baseline invalid: duplicate ids: {dup_ids}")

    def discover_all(self) -> List[AgentMetadata]:
        """Discover all agents from baseline"""
        self.discovered_agents = []
        for agent_def in self.baseline["agents"]:
            metadata = self._discover_agent(agent_def)
            self.discovered_agents.append(metadata)
        return self.discovered_agents

    def _discover_agent(self, agent_def: Dict[str, Any]) -> AgentMetadata:
        """Discover single agent"""
        agent_path = (self.root / str(agent_def["folder"])).resolve()

        metadata = AgentMetadata(
            id=str(agent_def["id"]),
            name=str(agent_def.get("name", "")),
            port=int(agent_def["port"]),
            role=str(agent_def.get("role", "")),
            folder=str(agent_def["folder"]),
            visibility=str(agent_def.get("visibility", "")),
            description=str(agent_def.get("description", "")),
        )

        if not agent_path.exists() or not agent_path.is_dir():
            metadata.exists = False
            metadata.errors.append(f"missing folder: {metadata.folder}")
            return metadata

        # Discover files
        metadata.has_main, metadata.main_file_path = self._find_main_file(agent_path)
        metadata.has_requirements = (agent_path / "requirements.txt").exists()
        metadata.has_readme = self._has_readme(agent_path)
        metadata.has_tests = (agent_path / "tests").exists() or (agent_path / "test").exists()
        metadata.has_dockerfile = (agent_path / "Dockerfile").exists()

        # Extract details
        if metadata.has_requirements:
            req_path = agent_path / "requirements.txt"
            metadata.dependencies = self._extract_dependencies(req_path)
            metadata.requirements_count = len(metadata.dependencies)

        if metadata.has_readme:
            readme_path = self._get_readme_path(agent_path)
            if readme_path:
                metadata.readme_excerpt = self._extract_readme_excerpt(readme_path, max_lines=10)
                try:
                    metadata.readme_lines = sum(1 for _ in readme_path.open("r", encoding="utf-8", errors="ignore"))
                except Exception:
                    metadata.readme_lines = 0

        if metadata.has_main and metadata.main_file_path:
            abs_main = (self.root / metadata.main_file_path).resolve()
            metadata.endpoints = self._extract_endpoints(abs_main)

        if metadata.has_tests:
            metadata.test_files = self._find_test_files(agent_path)

        return metadata

    def _find_main_file(self, agent_path: Path) -> Tuple[bool, Optional[str]]:
        """Find main entry point (main.py, app.py, server.py, etc.)"""
        for candidate in MAIN_CANDIDATES:
            p = agent_path / candidate
            if p.exists() and p.is_file():
                return True, _rel_to_root(p, self.root)

        # Fallback: deterministic search for common names at top-level only
        top_level = [p for p in agent_path.iterdir() if p.is_file() and p.suffix.lower() == ".py"]
        top_level = sorted(top_level, key=lambda x: x.name.lower())
        for p in top_level:
            if p.name.lower() in {"main.py", "app.py", "server.py", "run.py"}:
                return True, _rel_to_root(p, self.root)

        return False, None

    def _has_readme(self, agent_path: Path) -> bool:
        """Check if README exists"""
        for name in README_CANDIDATES:
            if (agent_path / name).exists():
                return True
        return False

    def _get_readme_path(self, agent_path: Path) -> Optional[Path]:
        """Get README path"""
        for name in README_CANDIDATES:
            p = agent_path / name
            if p.exists() and p.is_file():
                return p
        return None

    def _extract_dependencies(self, req_path: Path) -> List[str]:
        """Extract dependencies from requirements.txt"""
        deps: List[str] = []
        try:
            with req_path.open("r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    # Remove inline comments
                    if " #" in line:
                        line = line.split(" #", 1)[0].strip()
                    if line.startswith("-r ") or line.startswith("--requirement"):
                        continue
                    if line.startswith("-e ") or line.startswith("--editable"):
                        # editable install: try to keep a stable marker
                        deps.append("editable")
                        continue
                    # Extract package name before version specifiers / extras / markers
                    pkg = re.split(r"[=<>!~ \[\];]", line, maxsplit=1)[0].strip()
                    if pkg:
                        deps.append(pkg)
        except Exception as e:
            deps.append(f"__ERROR__:{e.__class__.__name__}")
        return _unique_sorted(deps)

    def _extract_readme_excerpt(self, readme_path: Path, max_lines: int = 10) -> str:
        """Extract first N non-empty lines from README"""
        lines: List[str] = []
        try:
            with readme_path.open("r", encoding="utf-8", errors="ignore") as f:
                for _ in range(max_lines * 3):  # allow skipping empties
                    if len(lines) >= max_lines:
                        break
                    s = f.readline()
                    if not s:
                        break
                    s = s.rstrip("\n").strip()
                    if s:
                        lines.append(s)
        except Exception:
            return ""
        return "\n".join(lines)

    def _extract_endpoints(self, main_file: Path) -> List[str]:
        """Extract FastAPI/Flask endpoints from main file (regex, static)"""
        content = _read_text_safe(main_file)
        endpoints: List[str] = []

        for method, path in FASTAPI_PATTERN.findall(content):
            endpoints.append(f"{method.upper()} {path}")

        for path in FLASK_PATTERN.findall(content):
            # Flask decorator doesn't encode method here reliably; keep deterministic label
            endpoints.append(f"ROUTE {path}")

        return _unique_sorted(endpoints)

    def _find_test_files(self, agent_path: Path) -> List[str]:
        """Find all test files (excluding ignored dirs)"""
        out: List[str] = []
        for pattern in TEST_GLOBS:
            for f in agent_path.glob(pattern):
                if not f.is_file():
                    continue
                if _contains_ignored_dir(f, self.ignored_dirs):
                    continue
                out.append(_rel_to_root(f, self.root))
        return sorted(set(out), key=lambda s: (s.lower(), s))

    def export_json(self, output_path: Path) -> None:
        """Export discovered metadata as JSON (deterministic, no timestamps)"""
        data = {
            "baseline_path": _rel_to_root(self.baseline_path, self.root),
            "agent_count": len(self.discovered_agents),
            "agents": [asdict(agent) for agent in self.discovered_agents],
        }
        output_path.parent.mkdir(parents=True, exist_ok=True)
        with output_path.open("w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2, sort_keys=True)

    def export_summary(self, output_path: Path) -> None:
        """Export discovery summary (deterministic)"""
        summary = {
            "total_agents": len(self.discovered_agents),
            "agents_existing": sum(1 for a in self.discovered_agents if a.exists),
            "agents_with_main": sum(1 for a in self.discovered_agents if a.has_main),
            "agents_with_requirements": sum(1 for a in self.discovered_agents if a.has_requirements),
            "agents_with_readme": sum(1 for a in self.discovered_agents if a.has_readme),
            "agents_with_tests": sum(1 for a in self.discovered_agents if a.has_tests),
            "total_endpoints": sum(len(a.endpoints) for a in self.discovered_agents),
            "total_dependencies": sum(a.requirements_count for a in self.discovered_agents),
            "total_test_files": sum(len(a.test_files) for a in self.discovered_agents),
            "missing_folders": _unique_sorted([a.id for a in self.discovered_agents if not a.exists]),
            "agents_with_errors": _unique_sorted([a.id for a in self.discovered_agents if a.errors]),
        }
        output_path.parent.mkdir(parents=True, exist_ok=True)
        with output_path.open("w", encoding="utf-8") as f:
            json.dump(summary, f, ensure_ascii=False, indent=2, sort_keys=True)


# -----------------------------
# CLI
# -----------------------------

def _parse_args() -> Any:
    import argparse

    p = argparse.ArgumentParser(description="Discover agents from system_baseline.yaml (static, deterministic).")
    p.add_argument("--root", type=str, default=".", help="Repo root (default: .)")
    p.add_argument("--baseline", type=str, default=DEFAULT_BASELINE, help=f"Baseline yaml (default: {DEFAULT_BASELINE})")
    p.add_argument("--out", type=str, default=DEFAULT_OUT_JSON, help=f"Output json (default: {DEFAULT_OUT_JSON})")
    p.add_argument("--summary", type=str, default=DEFAULT_OUT_SUMMARY, help=f"Output summary json (default: {DEFAULT_OUT_SUMMARY})")
    p.add_argument(
        "--ignore-dirs",
        type=str,
        default=",".join(sorted(DEFAULT_IGNORE_DIRS)),
        help="Comma-separated dir names to ignore (default includes caches/build/venv/node_modules).",
    )
    p.add_argument("--fail-on-missing", action="store_true", default=True, help="Exit non-zero if agent folders missing.")
    return p.parse_args()


def main() -> int:
    args = _parse_args()
    root = Path(args.root).resolve()
    baseline_path = (root / args.baseline).resolve()
    out_path = (root / args.out).resolve()
    summary_path = (root / args.summary).resolve()

    ignored_dirs = {x.strip() for x in str(args.ignore_dirs).split(",") if x.strip()}

    discovery = AgentDiscovery(root_path=root, baseline_path=baseline_path, ignored_dirs=ignored_dirs)
    agents = discovery.discover_all()
    discovery.export_json(out_path)
    discovery.export_summary(summary_path)

    missing = [a for a in agents if not a.exists]
    if missing and args.fail_on_missing:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

