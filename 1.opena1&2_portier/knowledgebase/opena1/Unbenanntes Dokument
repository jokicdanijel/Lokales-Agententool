"""
Security-Modul für ELION Dashboard / opena1 / opena2 / kordp
- Einheitliche Token-Validierung (gemeinsame .env im jeweiligen Dienst-Ordner)
- Rate-Limiting pro Token
- Helper: _read_env_token() erzeugt .env automatisch, wenn nicht vorhanden
"""

from __future__ import annotations

import logging
import time
from pathlib import Path
from typing import Dict, List

from fastapi import HTTPException
from fastapi.security import HTTPAuthorizationCredentials

logger = logging.getLogger("security")
if not logger.handlers:
    fh = logging.FileHandler("logs/security.log")
    fmt = logging.Formatter("%(asctime)s - %(levelname)s - %(message)s")
    fh.setFormatter(fmt)
    logger.setLevel(logging.INFO)
    logger.addHandler(fh)


# --------------------------------------------------------------------
# Token
# --------------------------------------------------------------------
def _read_env_token() -> str:
    """
    Liest den Bearer-Token aus .env (gleicher Ordner wie der Dienst).
    Falls .env fehlt, wird ein neuer Token erzeugt und gespeichert.
    """
    env_path = Path(".env")
    if not env_path.exists():
        import secrets
        token = secrets.token_urlsafe(32)
        env_path.write_text(token, encoding="utf-8")
        logger.info("Neuer Token generiert und in .env gespeichert.")
        return token
    token = env_path.read_text(encoding="utf-8").strip()
    if not token:
        raise RuntimeError(".env existiert, ist aber leer – bitte Token eintragen.")
    return token


def verify_token(token: str) -> bool:
    """Vergleicht übergebenen Token mit .env"""
    try:
        valid = _read_env_token()
        ok = token == valid
        logger.info("Tokenprüfung ok=%s", ok)
        return ok
    except Exception as e:
        logger.error("Fehler bei Token-Validierung: %s", e)
        return False


# --------------------------------------------------------------------
# Rate Limiter
# --------------------------------------------------------------------
class RateLimiter:
    """Einfaches Token-basiertes Rate-Limiting (requests/minute)."""

    def __init__(self, requests_per_minute: int = 60):
        self.rate_limit = requests_per_minute
        self.window = 60.0
        self._reqs: Dict[str, List[float]] = {}

    def _clean(self, t: str) -> None:
        now = time.time()
        if t in self._reqs:
            self._reqs[t] = [ts for ts in self._reqs[t] if now - ts < self.window]

    def is_allowed(self, token: str) -> bool:
        self._clean(token)
        if token not in self._reqs:
            self._reqs[token] = []
        if len(self._reqs[token]) >= self.rate_limit:
            return False
        self._reqs[token].append(time.time())
        return True

    def limit(self):
        """
        FastAPI-Decorator. Erwartet, dass die Endpunkte
        einen Parameter 'token: HTTPAuthorizationCredentials = Security(HTTPBearer())' haben.
        """
        from functools import wraps
        from fastapi import Security
        from fastapi.security import HTTPBearer

        security = HTTPBearer()

        def decorator(func):
            @wraps(func)
            async def wrapper(*args, **kwargs):
                creds = kwargs.get("token")
                if not creds or not isinstance(creds, HTTPAuthorizationCredentials):
                    raise HTTPException(status_code=401, detail="Token erforderlich")

                tok = creds.credentials
                if not self.is_allowed(tok):
                    raise HTTPException(status_code=429, detail="Rate limit überschritten")
                return await func(*args, **kwargs)
            return wrapper
        return decorator

