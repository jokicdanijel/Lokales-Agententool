    echo "opena1 läuft bereits auf :$PORT_OPENA1"
  else
    echo "Starte opena1 auf :$PORT_OPENA1 ..."
    nohup $PY "$ROOT_DIR/main_opena1.py" \
      >"$LOG_DIR/opena1.nohup.log" 2>&1 &
    sleep 1
