#!/usr/bin/env python3
"""
ELION Hyper-Dashboard 2.0 – FastAPI Backend
Fixes:
  • Dedizierter Endpoint: POST /api/agent/register
  • SSE-Route: request-Param gefixt
  • CORS: erlaubt 127.0.0.1:8080 (OpenWebUI)
  • Health/Status/Command bleiben wie gehabt
"""

import asyncio
import logging
from pathlib import Path
from typing import Dict, Optional, Any
from datetime import datetime

from fastapi import FastAPI, HTTPException, Security, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import HTMLResponse
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
from sse_starlette.sse import EventSourceResponse

from agent_registry import AgentRegistry
from sse_bus import SSEBus
from safepoints import SafepointManager
from security import verify_token, RateLimiter

# Logging
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    handlers=[logging.FileHandler("logs/dashboard_runtime.log"), logging.StreamHandler()]
)
logger = logging.getLogger("dashboard")

# App
app = FastAPI(title="ELION Hyper-Dashboard 2.0", description="Dashboard-Backend", version="1.1")

# CORS – OpenWebUI auf 127.0.0.1:8080 erlauben
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://127.0.0.1:8080", "http://localhost:8080"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Security
security = HTTPBearer()
rate_limiter = RateLimiter(requests_per_minute=120)

# Komponenten
agent_registry = AgentRegistry()
sse_bus = SSEBus()
safepoint_manager = SafepointManager()

# Port-Policy
@app.middleware("http")
async def validate_port_policy(request: Request, call_next):
    port = request.url.port
    if port == 8080:
        logger.error("Port 8080 ist verboten!")
        return HTMLResponse('{"detail":"Port 8080 ist verboten"}', status_code=403)
    if not (12344 <= port <= 12399):
        logger.error(f"Port {port} außerhalb des erlaubten Bereichs")
        return HTMLResponse('{"detail":"Port muss zwischen 12344 und 12399 liegen"}', status_code=403)
    return await call_next(request)

# --- API ---
@app.get("/health")
async def health_check():
    return {"service": "opena19", "status": "healthy", "strict": True, "timestamp": datetime.utcnow().isoformat()}

@app.get("/api/status/all")
@rate_limiter.limit()
async def get_all_status(token: HTTPAuthorizationCredentials = Security(security)):
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Not authenticated")
    return {"strict": True, "agents": await agent_registry.get_all_status()}

@app.get("/api/status/{agent_id}")
@rate_limiter.limit()
async def get_agent_status(agent_id: str, token: HTTPAuthorizationCredentials = Security(security)):
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Not authenticated")
    status = await agent_registry.get_agent_status(agent_id)
    if not status:
        raise HTTPException(status_code=404, detail=f"Agent {agent_id} nicht gefunden")
    return {"strict": True, "agent": agent_id, "status": status}

# NEU: dedizierter Register-Endpoint
@app.post("/api/agent/register")
@rate_limiter.limit()
async def api_agent_register(payload: Dict[str, Any], token: HTTPAuthorizationCredentials = Security(security)):
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Not authenticated")
    agent_id = str(payload.get("agent_id") or "").strip()
    endpoint = str(payload.get("endpoint") or "").strip()
    meta = payload.get("meta") or {}
    if not agent_id or not endpoint:
        raise HTTPException(status_code=400, detail="agent_id/endpoint erforderlich")
    reg = await agent_registry.register(agent_id, endpoint, meta)
    await sse_bus.publish({"event": "agent_registered", "data": {"agent": agent_id, "endpoint": endpoint}})
    return reg

# Bestehen bleibender Befehl-Endpunkt (für echte Agenten, nicht fürs Registrieren)
@app.post("/api/command/{agent_id}")
@rate_limiter.limit()
async def execute_command(agent_id: str, command: Dict[str, Any], token: HTTPAuthorizationCredentials = Security(security)):
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Not authenticated")
    try:
        result = await agent_registry.execute_command(agent_id, command)
        await sse_bus.publish({"event": "command_executed", "data": {"agent": agent_id, "command": command.get("action")}})
        return {"strict": True, "status": "accepted", "result": result}
    except Exception as e:
        logger.error(f"Fehler bei Befehlsausführung: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/events/live")
async def event_stream(request: Request):
    async def event_generator():
        async for event in sse_bus.subscribe():
            if await request.is_disconnected():
                break
            yield {"event": event["event"], "data": event["data"], "retry": 3000}
    return EventSourceResponse(event_generator())

# Safepoints-APIs (falls genutzt)
@app.post("/api/safepoints/query")
@rate_limiter.limit()
async def query_safepoints(query: Dict[str, Any], token: HTTPAuthorizationCredentials = Security(security)):
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Not authenticated")
    try:
        safepoints = await safepoint_manager.query(query)
        return {"strict": True, "safepoints": safepoints}
    except Exception as e:
        logger.error(f"Fehler bei Safepoint-Suche: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/safepoints/download")
@rate_limiter.limit()
async def download_safepoint(path: str, token: HTTPAuthorizationCredentials = Security(security)):
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Not authenticated")
    try:
        content = await safepoint_manager.get_content(path)
        return {"strict": True, "content": content}
    except Exception as e:
        logger.error(f"Fehler beim Safepoint-Download: {e}")
        raise HTTPException(status_code=500, detail=str(e))

# Minimale UI
def render_template(name: str, ctx: Optional[Dict[str, Any]] = None) -> str:
    if name == "ui_index.html":
        return "<!doctype html><html><body><h1>ELION Dashboard</h1><p>OK</p></body></html>"
    if name == "ui_agent.html":
        agent = (ctx or {}).get("agent") or {}
        return f"<!doctype html><html><body><h1>Agent {agent.get('id','?')}</h1></body></html>"
    return "<!doctype html><html><body>Not Found</body></html>"

@app.get("/ui/")
async def dashboard_ui():
    return HTMLResponse(render_template("ui_index.html"))

@app.get("/agent/{agent_id}")
async def agent_ui(agent_id: str):
    if not await agent_registry.exists(agent_id):
        raise HTTPException(status_code=404, detail=f"Agent {agent_id} nicht gefunden")
    details = await agent_registry.get_agent_details(agent_id)
    return HTMLResponse(render_template("ui_agent.html", {"agent": {"id": agent_id, **(details or {})}}))

