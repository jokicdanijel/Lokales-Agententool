"""
AgentRegistry – Registry für das Dashboard (opena19)
- Verwalten registrierter Agenten (agent_id, endpoint)
- Status-Abfrage via /health der Agenten
- Command-Relay: POST /api/command/{agent} an den Ziel-Agent
"""

from __future__ import annotations

import logging
from typing import Dict, Any, Optional

import httpx

logger = logging.getLogger("dashboard.registry")
if not logger.handlers:
    import logging as _logging
    fh = _logging.FileHandler("logs/registry.log")
    fmt = _logging.Formatter("%(asctime)s - %(levelname)s - %(message)s")
    fh.setFormatter(fmt)
    logger.setLevel(_logging.INFO)
    logger.addHandler(fh)


class AgentRegistry:
    def __init__(self) -> None:
        self._agents: Dict[str, Dict[str, Any]] = {}
        self._client = httpx.AsyncClient(timeout=10)

    # --------------------------- CRUD ---------------------------

    async def register_agent(self, agent_id: str, endpoint: str) -> Dict[str, Any]:
        self._agents[agent_id] = {
            "id": agent_id,
            "endpoint": endpoint,
        }
        logger.info("Agent registriert: %s @ %s", agent_id, endpoint)
        return self._agents[agent_id]

    async def exists(self, agent_id: str) -> bool:
        return agent_id in self._agents

    async def get_agent_details(self, agent_id: str) -> Optional[Dict[str, Any]]:
        return self._agents.get(agent_id)

    # --------------------------- Status ---------------------------

    async def get_all_status(self) -> Dict[str, Any]:
        out: Dict[str, Any] = {}
        for aid, info in self._agents.items():
            out[aid] = await self._status_of(info)
        return out

    async def get_agent_status(self, agent_id: str) -> Optional[Dict[str, Any]]:
        info = self._agents.get(agent_id)
        if not info:
            return None
        return await self._status_of(info)

    async def _status_of(self, info: Dict[str, Any]) -> Dict[str, Any]:
        url = f"{info['endpoint'].rstrip('/')}/health"
        try:
            r = await self._client.get(url)
            if r.status_code == 200:
                return {"status": "online", "details": r.json()}
            return {"status": "unreachable", "code": r.status_code}
        except Exception as e:
            return {"status": "offline", "error": str(e)}

    # --------------------------- Command Relay -------------------

    async def execute_command(self, agent_id: str, command: Dict[str, Any]) -> Dict[str, Any]:
        info = self._agents.get(agent_id)
        if not info:
            raise RuntimeError(f"Agent {agent_id} nicht registriert")
        url = f"{info['endpoint'].rstrip('/')}/api/command/{agent_id}"
        try:
            r = await self._client.post(url, json=command)
            return r.json() if r.status_code == 200 else {"error": f"{r.status_code}", "body": r.text}
        except Exception as e:
            return {"error": str(e)}

