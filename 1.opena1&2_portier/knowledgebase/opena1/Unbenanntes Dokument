"""
Einfache Agent-Registry für das Dashboard.
Hält agent_id -> info (endpoint, registered_at, last_health).
Persistiert optional in state/agents.json
"""

import json
import logging
from pathlib import Path
from typing import Dict, Optional
from datetime import datetime

logger = logging.getLogger("agent_registry")

class AgentRegistry:
    def __init__(self, state_path: Path | None = None):
        self._agents: Dict[str, Dict] = {}
        self._path = state_path
        if self._path:
            self._path.parent.mkdir(parents=True, exist_ok=True)
            self._load()

    # Persistenz
    def _load(self):
        if self._path and self._path.exists():
            try:
                self._agents = json.loads(self._path.read_text("utf-8")) or {}
            except Exception as e:
                logger.error(f"Konnte Registry nicht laden: {e}")
                self._agents = {}

    def _save(self):
        if not self._path:
            return
        try:
            self._path.write_text(json.dumps(self._agents, ensure_ascii=False, indent=2))
        except Exception as e:
            logger.error(f"Konnte Registry nicht speichern: {e}")

    # API
    def register(self, agent_id: str, endpoint: str):
        self._agents[agent_id] = {
            "endpoint": endpoint,
            "registered_at": datetime.utcnow().isoformat() + "Z",
            "last_health": None
        }
        self._save()
        logger.info(f"Agent registriert: {agent_id} -> {endpoint}")

    def exists(self, agent_id: str) -> bool:
        return agent_id in self._agents

    def get_agent_status(self, agent_id: str) -> Optional[Dict]:
        return self._agents.get(agent_id)

    def get_all_status(self) -> Dict[str, Dict]:
        return dict(self._agents)

    def update_health(self, agent_id: str, healthy: bool):
        if agent_id in self._agents:
            self._agents[agent_id]["last_health"] = {
                "healthy": bool(healthy),
                "timestamp": datetime.utcnow().isoformat() + "Z"
            }
            self._save()

