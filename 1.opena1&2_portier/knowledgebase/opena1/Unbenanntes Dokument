"""
OpenA1Registry – Registry/Client des Koordinators (opena1)
- lokale Agentenverwaltung
- Handshake zum Dashboard (opena19)
- Status-Sync & Command-Relay
"""

import logging
from datetime import datetime
from pathlib import Path
from typing import Dict, Any

import httpx

logger = logging.getLogger("opena1.registry")
fh = logging.FileHandler("logs/opena1_registry.log")
fh.setFormatter(logging.Formatter("%(asctime)s - %(levelname)s - %(message)s"))
logger.setLevel(logging.INFO)
logger.addHandler(fh)


class OpenA1Registry:
    def __init__(self, dashboard_url: str, self_id: str, self_endpoint: str):
        self.dashboard_url = dashboard_url.rstrip("/")
        self.self_id = self_id
        self.self_endpoint = self_endpoint
        self._agents: Dict[str, Dict[str, Any]] = {}
        self._client = httpx.AsyncClient(timeout=10)

    # --------------------------- Local registry ---------------------------

    async def register_local(self, agent_id: str, endpoint: str) -> Dict[str, Any]:
        self._agents[agent_id] = {
            "id": agent_id,
            "endpoint": endpoint,
            "status": "registered",
            "last_seen": datetime.utcnow().isoformat()
        }
        logger.info(f"Lokal registriert: {agent_id} @ {endpoint}")
        return self._agents[agent_id]

    async def get_all_status(self) -> Dict[str, Any]:
        out: Dict[str, Any] = {}
        for aid, info in self._agents.items():
            try:
                r = await self._client.get(f"{info['endpoint'].rstrip('/')}/health")
                out[aid] = {"status": "online" if r.status_code == 200 else "unreachable", "details": r.json() if r.status_code == 200 else {}}
            except Exception as e:
                out[aid] = {"status": "offline", "error": str(e)}
        return out

    async def execute_on(self, agent_id: str, command: Dict[str, Any]) -> Dict[str, Any]:
        info = self._agents.get(agent_id)
        if not info:
            return {"error": f"Agent {agent_id} nicht registriert"}
        try:
            r = await self._client.post(f"{info['endpoint'].rstrip('/')}/api/command/{agent_id}", json=command)
            return r.json()
        except Exception as e:
            logger.error(f"Befehl fehlgeschlagen ({agent_id}): {e}")
            return {"error": str(e)}

    # ------------------------- Dashboard handshake ------------------------

    def _read_token(self) -> str:
        # Der Koordinator nutzt denselben Token wie das Dashboard (gemeinsame .env im Ordner)
        token_path = Path(".env")
        if not token_path.exists():
            raise RuntimeError(".env (Token) nicht gefunden – bitte Dashboard starten oder .env anlegen")
        return token_path.read_text(encoding="utf-8").strip()

    async def handshake_with_dashboard(self) -> None:
        token = self._read_token()
        try:
            r = await self._client.post(
                f"{self.dashboard_url}/api/command/register",
                headers={"Authorization": f"Bearer {token}"},
                json={"agent_id": self.self_id, "endpoint": self.self_endpoint}
            )
            if r.status_code == 200:
                logger.info("Handshake mit Dashboard erfolgreich.")
            else:
                logger.warning(f"Handshake Dashboard Status {r.status_code}: {r.text}")
        except Exception as e:
            logger.error(f"Handshake-Fehler: {e}")

    async def periodic_sync(self, interval_seconds: int = 30) -> None:
        token = self._read_token()
        while True:
            try:
                r = await self._client.get(
                    f"{self.dashboard_url}/api/status/all",
                    headers={"Authorization": f"Bearer {token}"}
                )
                if r.status_code == 200:
                    logger.info("Status-Sync mit Dashboard ok.")
                else:
                    logger.warning(f"Status-Sync Dashboard {r.status_code}")
            except Exception as e:
                logger.error(f"Status-Sync-Fehler: {e}")
            finally:
                import asyncio
                await asyncio.sleep(interval_seconds)

