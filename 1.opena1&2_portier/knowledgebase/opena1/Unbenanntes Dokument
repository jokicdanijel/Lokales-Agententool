#!/usr/bin/env python3
"""
opena2 – Archivator (FastAPI)
Schreibt Safepoints streng ins Archiv unter 1.portier_openai/archivp/YYYY/MM/DD/
Erlaubte Operationen:
  POST /store/archivp   -> JSON annehmen und als Safepoint-Datei ablegen (CMD/RESP)
  GET  /health          -> Health-Status
  GET  /archiv/last     -> letzte N Safepoints (Dateinamen)
Port-Policy: Nur Loopback, Port im Bereich 12344–12399 (Startskript setzt 12345).
"""

from __future__ import annotations
import os
import json
import hashlib
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Union

from fastapi import FastAPI, HTTPException, Request
from fastapi.responses import JSONResponse

# --- Pfade/Policy ---
PROJECT_ROOT = Path("/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt").resolve()
DEFAULT_ARCHIVP = PROJECT_ROOT / "1.portier_openai" / "archivp"
ARCHIVP_ROOT = Path(os.getenv("ARCHIVP_ROOT", str(DEFAULT_ARCHIVP))).resolve()

ALLOWED_MIN_PORT = 12344
ALLOWED_MAX_PORT = 12399
FORBIDDEN_PORTS = {8080}

app = FastAPI(title="opena2-archivator", version="1.0.0", description="Safepoint Archivator")

# --- Helpers ---
def _today_dir() -> Path:
    d = datetime.now(timezone.utc)
    p = ARCHIVP_ROOT / f"{d:%Y/%m/%d}"
    p.mkdir(parents=True, exist_ok=True)
    return p

def _safe_join(base: Path, rel: str) -> Path:
    p = (base / rel.lstrip("/")).resolve()
    if not str(p).startswith(str(base)):
        raise HTTPException(status_code=400, detail="Path traversal abgelehnt")
    return p

def _is_strict_true(payload: Dict[str, Any]) -> bool:
    return bool(payload.get("strict") is True)

def _ensure_strict(payload: Dict[str, Any]) -> Dict[str, Any]:
    payload = dict(payload)
    payload.setdefault("strict", True)
    return payload

def _sp_name(src: str, dst: str, kind: str) -> str:
    # Beispiel: SP<unix>_opena1→opena2_CMD.json
    ts = int(datetime.now(timezone.utc).timestamp())
    arrow = "→"
    return f"SP{ts}_{src}{arrow}{dst}_{kind.upper()}.json"

def _write_json(path: Path, data: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")

# --- Middleware: simple Port-Policy-Check (nur informativ hier, Bind liegt bei uvicorn) ---
@app.middleware("http")
async def policy_mw(request: Request, call_next):
    port = request.url.port or 0
    if port in FORBIDDEN_PORTS:
        return JSONResponse({"detail": "Port 8080 ist verboten"}, status_code=403)
    if not (ALLOWED_MIN_PORT <= port <= ALLOWED_MAX_PORT):
        return JSONResponse({"detail": f"Port muss zwischen {ALLOWED_MIN_PORT} und {ALLOWED_MAX_PORT} liegen"}, status_code=403)
    return await call_next(request)

# --- API ---
@app.get("/health")
async def health():
    return {
        "service": "opena2",
        "status": "healthy",
        "strict": True,
        "timestamp": datetime.utcnow().isoformat() + "Z",
        "archivp": str(ARCHIVP_ROOT),
    }

@app.get("/archiv/last")
async def last(n: int = 10):
    base = ARCHIVP_ROOT
    if not base.exists():
        return {"strict": True, "files": []}
    files: List[Path] = sorted(base.rglob("SP*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
    return {"strict": True, "files": [str(p.relative_to(ARCHIVP_ROOT)) for p in files[:max(0, n)]]}

@app.post("/store/archivp")
async def store_archivp(body: Dict[str, Any]):
    """
    Zwei akzeptierte Formen:

    (A) Automatischer Safepoint-Write (empfohlen)
    {
      "src": "kordp",
      "dst": "opena2",
      "kind": "CMD",      # oder "RESP"
      "payload": {...},   # wird als JSON-Inhalt gespeichert
      "notes": "optional"
    }

    (B) Expliziter Pfad-Write (kompatibel)
    {
      "op": "WRITE",
      "path": "2025/11/06/SP1762_opena1→opena2_CMD.json",
      "content": {...}
    }
    """
    try:
        # (B) Kompatibler Modus mit op/path/content
        if body.get("op") == "WRITE":
            rel_path = body.get("path")
            content = body.get("content")
            if not isinstance(rel_path, str) or not rel_path:
                raise HTTPException(400, "path fehlt/leer")
            if not isinstance(content, dict):
                raise HTTPException(400, "content muss JSON-Objekt sein")
            if not _is_strict_true(content):
                content = _ensure_strict(content)
            out = _safe_join(ARCHIVP_ROOT, rel_path)
            _write_json(out, content)
            return {"strict": True, "written": True, "path": str(out.relative_to(ARCHIVP_ROOT))}

        # (A) Automodus
        src = str(body.get("src") or "unknown")
        dst = str(body.get("dst") or "opena2")
        kind = str(body.get("kind") or "CMD").upper()
        payload = body.get("payload") or {}
        if not isinstance(payload, dict):
            raise HTTPException(400, "payload muss JSON-Objekt sein")
        if kind not in {"CMD", "RESP"}:
            raise HTTPException(400, "kind muss CMD oder RESP sein")
        if not _is_strict_true(payload):
            payload = _ensure_strict(payload)

        day = _today_dir()
        name = _sp_name(src, dst, kind)
        out = day / name
        _write_json(out, payload)
        return {"strict": True, "written": True, "path": str(out.relative_to(ARCHIVP_ROOT))}
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

