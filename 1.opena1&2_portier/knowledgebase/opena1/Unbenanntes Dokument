#!/usr/bin/env bash
set -euo pipefail

# Basisverzeichnis = Verzeichnis dieser Datei
BASE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$BASE"

DASH="http://127.0.0.1:12349"
OPENA1="http://127.0.0.1:12344"
OPENA2="http://127.0.0.1:12345"
OPENA3="http://127.0.0.1:8080"  # optional (OpenWebUI)

TOK="$(cat .env 2>/dev/null || true)"

need_token() {
  if [[ -z "${TOK:-}" ]]; then
    echo "FEHLER: .env fehlt oder ist leer. Starte das Dashboard einmal mit 'python3 main_dashboard.py', dann wird .env erzeugt."
    exit 1
  fi
}

case "${1:-}" in
  health)
    curl -s "$DASH/health" | jq .
    ;;

  status)
    need_token
    curl -s -H "Authorization: Bearer $TOK" "$DASH/api/status/all" | jq .
    ;;

  agents:register)
    need_token
    # opena1 registrieren
    curl -s -X POST "$DASH/api/agent/register" \
      -H "Authorization: Bearer $TOK" -H "Content-Type: application/json" \
      -d "{\"agent_id\":\"opena1\",\"endpoint\":\"$OPENA1\"}" | jq .

    # opena2 registrieren
    curl -s -X POST "$DASH/api/agent/register" \
      -H "Authorization: Bearer $TOK" -H "Content-Type: application/json" \
      -d "{\"agent_id\":\"opena2\",\"endpoint\":\"$OPENA2\"}" | jq .

    # opena3 (OpenWebUI) nur, wenn gewünscht & erreichbar
    if curl -fsS "$OPENA3" >/dev/null 2>&1; then
      curl -s -X POST "$DASH/api/agent/register" \
        -H "Authorization: Bearer $TOK" -H "Content-Type: application/json" \
        -d "{\"agent_id\":\"opena3\",\"endpoint\":\"$OPENA3\"}" | jq .
    else
      echo "(Hinweis) OpenWebUI auf $OPENA3 nicht erreichbar – überspringe Registrierung."
    fi
    ;;

  agents:check)
    # reine Reachability der Endpunkte (ohne Token)
    echo "# opena1"; curl -s "$OPENA1/health" | jq . || true
    echo "# opena2"; curl -s "$OPENA2/health" | jq . || true
    echo "# opena3"; curl -s "$OPENA3" | head -n1 || true
    ;;

  write:test)
    # schreibt zwei Safepoints in opena2 (Archivator) und listet die letzten 5
    nowsp="SP$(( $(date +%s) ))_kordp→opena2_CMD.json"
    curl -s -X POST "$OPENA2/store/archivp" \
      -H 'Content-Type: application/json' \
      -d "{
            \"op\":\"WRITE\",
            \"path\":\"$(date +%Y/%m/%d)/$nowsp\",
            \"content\":{\"strict\":true, \"ts\":\"$(date -u +%FT%TZ)\", \"payload\":{\"ping\":\"ok\"}}
          }" | jq .

    curl -s -X POST "$OPENA2/store/archivp" \
      -H 'Content-Type: application/json' \
      -d '{"src":"kordp","dst":"opena2","kind":"CMD","payload":{"msg":"hello","strict":true}}' | jq .

    curl -s "$OPENA2/archiv/last?n=5" | jq .
    ;;

  logs)
    tail -n 150 logs/dashboard_runtime.log || true
    tail -n 150 logs/opena1_runtime.log || true
    tail -n 150 logs/opena1_registry.log || true
    tail -n 150 logs/opena2.nohup.log || true
    tail -n 150 logs/kordp.nohup.log || true
    ;;

  start)
    chmod +x bin/*.sh || true
    ./bin/start_all.sh
    ;;

  stop)
    ./bin/stop_all.sh
    ;;

  verify)
    ./bin/verify_stack.sh
    ;;

  *)
    cat <<'USAGE'
Nutzung: bin/ops.sh <command>

Befehle:
  start             - alle Services starten (Dashboard, opena1, opena2, kordp)
  stop              - alle Services stoppen
  health            - Dashboard /health ohne Token
  status            - Dashboard /api/status/all mit Token (aus .env)
  agents:register   - opena1/opena2 (optional opena3) im Dashboard registrieren
  agents:check      - direkte Health/Reachability der Agent-Endpunkte prüfen
  write:test        - zwei Test-Safepoints in opena2 schreiben + auflisten
  logs              - wichtige Logs anzeigen
  verify            - integrierter Verifikationslauf (Health, Status, Write-Checks)

Hinweise:
- Niemals JavaScript "fetch(...)" in der Bash ausführen. Das gehört in die Browser-Konsole (F12).
- Niemals Python-Quelltext in die Bash einfügen. Dateien bearbeiten (z.B. sse_bus.py) und dann den Dienst neu starten.
USAGE
    ;;
esac

