#!/usr/bin/env python3
"""
Security-Modul – Token-Validierung und Rate-Limiting (fix).
"""

from __future__ import annotations
import logging
import time
from datetime import datetime
from pathlib import Path
from typing import Dict, Optional

from fastapi import HTTPException
from fastapi.security import HTTPAuthorizationCredentials

logger = logging.getLogger("security")

class RateLimiter:
    def __init__(self, requests_per_minute: int = 60) -> None:
        self.rate = requests_per_minute
        self.window = 60.0
        self._reqs: Dict[str, list[float]] = {}

    def _clean(self, token: str) -> None:
        now = time.time()
        if token in self._reqs:
            self._reqs[token] = [t for t in self._reqs[token] if (now - t) < self.window]

    def is_allowed(self, token: str) -> bool:
        token = str(token)
        self._clean(token)
        lst = self._reqs.setdefault(token, [])
        if len(lst) >= self.rate:
            return False
        lst.append(time.time())
        return True

    def limit(self):
        from functools import wraps

        def decorator(func):
            @wraps(func)
            async def wrapper(*args, **kwargs):
                token_obj = kwargs.get("token")
                token_str: Optional[str] = None
                if isinstance(token_obj, HTTPAuthorizationCredentials):
                    token_str = token_obj.credentials
                elif isinstance(token_obj, str):
                    token_str = token_obj
                if not token_str:
                    raise HTTPException(status_code=401, detail="Not authenticated")
                if not self.is_allowed(token_str):
                    raise HTTPException(status_code=429, detail="Rate limit überschritten")
                return await func(*args, **kwargs)
            return wrapper
        return decorator

def _gen_token() -> str:
    import secrets
    return secrets.token_urlsafe(32)

def verify_token(token: str) -> bool:
    try:
        env = Path(".env")
        if not env.exists():
            tok = _gen_token()
            env.write_text(tok, encoding="utf-8")
            logger.info("Neuer Token generiert und in .env gespeichert.")
        valid = env.read_text(encoding="utf-8").strip()
        ok = (token == valid)
        logger.info(f"Tokenprüfung ok={ok}")
        return ok
    except Exception as e:
        logger.error(f"Fehler bei Token-Validierung: {e}")
        return False

