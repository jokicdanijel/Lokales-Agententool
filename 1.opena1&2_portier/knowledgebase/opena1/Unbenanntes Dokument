app = FastAPI(title="Kordinatport (kordp)", version="1.0", description="Dispatch-Port für Befehle")
security = HTTPBearer()
rate_limiter = RateLimiter(requests_per_minute=90)

# HTTP-Client
_client = httpx.AsyncClient(timeout=10)

