        logging.StreamHandler()
    ],
)
logger = logging.getLogger("opena2")

ARCHIV_ROOT = Path(os.environ.get("ARCHIV_ROOT", "archiv"))
ARCHIV_ROOT.mkdir(parents=True, exist_ok=True)

app = FastAPI(title="Archivator (opena2)", version="1.0")

@app.get("/health")
def health():
    return {"service": "opena2", "status": "ok", "ts": datetime.utcnow().isoformat() + "Z"}

def _ensure_day_dir(day_path: Path):
    day_path.mkdir(parents=True, exist_ok=True)

def _write_json(path: Path, content: Dict[str, Any]):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(content, ensure_ascii=False), encoding="utf-8")

def _list_last_json(root: Path, n: int) -> List[Dict[str, Any]]:
    files = list(root.rglob("*.json"))
    files.sort(key=lambda p: p.stat().st_mtime, reverse=True)
    out = []
    for p in files[:n]:
        st = p.stat()
        rel = p.relative_to(root).as_posix()
        out.append({
            "path": rel,
            "size": st.st_size,
            "mtime": datetime.fromtimestamp(st.st_mtime).isoformat()
        })
    return out

@app.post("/store/archivp")
def store_archivp(payload: Dict[str, Any]):
    """
    Modus A (explizit): {"op":"WRITE","path":"YYYY/MM/DD/SPxxxx.json","content":{...}}
    Modus B (kordp-like): {"src":"kordp","dst":"opena2","kind":"CMD","payload":{...}}
    """
    # Modus A
    if payload.get("op") == "WRITE":
        rel_path = payload.get("path")
        content = payload.get("content")
        if not rel_path or content is None:
            raise HTTPException(status_code=400, detail="path und content erforderlich")
        full = ARCHIV_ROOT / rel_path
        _write_json(full, content)
        return {"strict": True, "written": True, "path": rel_path}

    # Modus B
    src = payload.get("src")
    dst = payload.get("dst")
    kind = payload.get("kind")
    pl = payload.get("payload")
    if src and dst and kind and pl is not None:
        ts = int(datetime.utcnow().timestamp())
        ymd = datetime.utcnow().strftime("%Y/%m/%d")
        fname = f"SP{ts}_{src}→{dst}_{kind}.json"
        rel_path = f"{ymd}/{fname}"
        full = ARCHIV_ROOT / rel_path
        _write_json(full, {"strict": True, "ts": datetime.utcnow().isoformat() + "Z", "payload": pl})
        return {"strict": True, "written": True, "path": rel_path}

    raise HTTPException(status_code=404, detail="Not Found")

@app.get("/archiv/last")
def list_last(n: int = Query(default=5, ge=1, le=100)):
    items = _list_last_json(ARCHIV_ROOT, n)
    return {"strict": True, "count": len(items), "items": items}

