  if is_listening "$PORT_KORDP"; then
    echo "kordp läuft bereits auf :$PORT_KORDP"
  else
    echo "Starte kordp auf :$PORT_KORDP ..."
    nohup $PY "$ROOT_DIR/main_kordp.py" \
      >"$LOG_DIR/kordp.nohup.log" 2>&1 &
    sleep 1
  fi
}

stop_port() {
  local port="$1"
  local pids
  pids="$(lsof -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
  if [[ -n "$pids" ]]; then
    echo "Stoppe Port :$port (PIDs: $pids)"
    kill $pids 2>/dev/null || true
    sleep 0.5
  fi
}

stop_all() {
  stop_port "$PORT_KORDP"
  stop_port "$PORT_OPENA2"
  stop_port "$PORT_OPENA1"
  stop_port "$PORT_DASHBOARD"
