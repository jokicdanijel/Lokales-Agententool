#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOG_DIR="$ROOT_DIR/logs"
RUNTIME_DIR="$ROOT_DIR/.runtime"
mkdir -p "$LOG_DIR" "$RUNTIME_DIR"

PORT_DASHBOARD="$(cat "$RUNTIME_DIR/port" 2>/dev/null || echo "12349")"
PORT_OPENA1="${PORT_OPENA1:-12344}"
PORT_OPENA2="${PORT_OPENA2:-12345}"
PORT_KORDP="${PORT_KORDP:-12346}"

PY="${PYTHON_BIN:-python3}"
ENV_FILE="$ROOT_DIR/.env"

get_token() {
  if [[ -f "$ENV_FILE" ]]; then cat "$ENV_FILE"; else echo ""; fi
}

is_listening() {
  local port="$1"
  ss -ltnp "sport = :$port" >/dev/null 2>&1
}

start_dashboard() {
  if is_listening "$PORT_DASHBOARD"; then
    echo "Dashboard läuft bereits auf :$PORT_DASHBOARD"
  else
    echo "Starte Dashboard auf :$PORT_DASHBOARD ..."
    nohup $PY "$ROOT_DIR/main_dashboard.py" \
      >"$LOG_DIR/dashboard.nohup.log" 2>&1 &
    sleep 1
  fi
}

start_opena1() {
  if is_listening "$PORT_OPENA1"; then
    echo "opena1 läuft bereits auf :$PORT_OPENA1"
  else
    echo "Starte opena1 auf :$PORT_OPENA1 ..."
    nohup $PY "$ROOT_DIR/main_opena1.py" \
      >"$LOG_DIR/opena1.nohup.log" 2>&1 &
    sleep 1
  fi
}

start_opena2() {
  if is_listening "$PORT_OPENA2"; then
    echo "opena2 läuft bereits auf :$PORT_OPENA2"
  else
    echo "Starte opena2 (Archivator) auf :$PORT_OPENA2 ..."
    nohup $PY "$ROOT_DIR/main_opena2.py" \
      >"$LOG_DIR/opena2.nohup.log" 2>&1 &
    sleep 1
  fi
}

start_kordp() {
  if is_listening "$PORT_KORDP"; then
    echo "kordp läuft bereits auf :$PORT_KORDP"
  else
    echo "Starte kordp auf :$PORT_KORDP ..."
    nohup $PY "$ROOT_DIR/main_kordp.py" \
      >"$LOG_DIR/kordp.nohup.log" 2>&1 &
    sleep 1
  fi
}

stop_port() {
  local port="$1"
  local pids
  pids="$(lsof -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
  if [[ -n "$pids" ]]; then
    echo "Stoppe Port :$port (PIDs: $pids)"
    kill $pids 2>/dev/null || true
    sleep 0.5
  fi
}

stop_all() {
  stop_port "$PORT_KORDP"
  stop_port "$PORT_OPENA2"
  stop_port "$PORT_OPENA1"
  stop_port "$PORT_DASHBOARD"
}

health() {
  curl -s "http://127.0.0.1:$PORT_DASHBOARD/health" || echo "{}"
}

status() {
  local tok="$(get_token)"
  if [[ -z "$tok" ]]; then
    echo '{"detail":"No token (.env)"}'
    return 1
  fi
  curl -s -H "Authorization: Bearer $tok" "http://127.0.0.1:$PORT_DASHBOARD/api/status/all" || echo "{}"
}

agents_register() {
  local tok="$(get_token)"
  if [[ -z "$tok" ]]; then echo "Kein Token (.env)"; return 1; fi
  echo "# Register opena1"
  curl -s -X POST "http://127.0.0.1:$PORT_DASHBOARD/api/agent/register" \
    -H "Authorization: Bearer $tok" -H "Content-Type: application/json" \
    -d "{\"agent_id\":\"opena1\",\"endpoint\":\"http://127.0.0.1:$PORT_OPENA1\"}" | jq . || true
  echo "# Register opena2"
  curl -s -X POST "http://127.0.0.1:$PORT_DASHBOARD/api/agent/register" \
    -H "Authorization: Bearer $tok" -H "Content-Type: application/json" \
    -d "{\"agent_id\":\"opena2\",\"endpoint\":\"http://127.0.0.1:$PORT_OPENA2\"}" | jq . || true
  if ss -ltnp "sport = :8080" >/dev/null 2>&1; then
    echo "# Register opena3 (OpenWebUI)"
    curl -s -X POST "http://127.0.0.1:$PORT_DASHBOARD/api/agent/register" \
      -H "Authorization: Bearer $tok" -H "Content-Type: application/json" \
      -d "{\"agent_id\":\"opena3\",\"endpoint\":\"http://127.0.0.1:8080\"}" | jq . || true
  fi
}

write_test() {
  echo "# Write: generic archivp"
  curl -s -X POST "http://127.0.0.1:$PORT_OPENA2/store/archivp" \
    -H "Content-Type: application/json" \
    -d '{"op":"WRITE","path":"'"$(date +%Y/%m/%d)"'/SP'"$(date +%s)"'_kordp→opena2_CMD.json","content":{"strict":true,"ts":"'"$(date -u +%FT%TZ)"'","payload":{"ping":"ok"}}}' | jq .
  echo "# Kordp-Format"
  curl -s -X POST "http://127.0.0.1:$PORT_OPENA2/store/archivp" \
    -H "Content-Type: application/json" \
    -d '{"src":"kordp","dst":"opena2","kind":"CMD","payload":{"msg":"hello","strict":true}}' | jq .
  echo "# last 5"
  curl -s "http://127.0.0.1:$PORT_OPENA2/archiv/last?n=5" | jq .
}

logs() {
  for f in dashboard.nohup.log opena1.nohup.log opena2.nohup.log kordp.nohup.log; do
    echo "---- $f"; tail -n 120 "$LOG_DIR/$f" 2>/dev/null || true
  done
}

verify() {
  echo "# Start"
  "$0" start
  echo "# Health"
  "$0" health | jq .
  echo "# Agents register"
  "$0" agents:register
  echo "# Status"
  "$0" status | jq .
  echo "# Write test"
  "$0" write:test
}

case "${1:-}" in
  start) start_dashboard; start_opena1; start_opena2; start_kordp ;;
  stop) stop_all ;;
  health) health ;;
  status) status ;;
  agents:register) agents_register ;;
  write:test) write_test ;;
  logs) logs ;;
  verify) verify ;;
  *) echo "Usage: $0 {start|stop|health|status|agents:register|write:test|logs|verify}"; exit 1 ;;
esac

