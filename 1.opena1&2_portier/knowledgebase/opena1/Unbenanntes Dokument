# Middleware: Port-Policy
# -----------------------------------------------------------------------------
@app.middleware("http")
async def validate_port_policy(request: Request, call_next):
    port = request.url.port
    if port == 8080:
        logger.error("Port 8080 ist verboten!")
        raise HTTPException(status_code=403, detail="Port 8080 ist verboten")
    if not (12344 <= port <= 12399):
        logger.error(f"Port {port} außerhalb des erlaubten Bereichs")
        raise HTTPException(
            status_code=403,
            detail="Port muss zwischen 12344 und 12399 liegen"
        )
    return await call_next(request)

# -----------------------------------------------------------------------------
# Lifecycle
# -----------------------------------------------------------------------------
@app.on_event("startup")
async def on_startup():
    # Stelle sicher, dass .env existiert
    _ = _read_env_token()
    Path("logs").mkdir(parents=True, exist_ok=True)

# -----------------------------------------------------------------------------
# API: Health
# -----------------------------------------------------------------------------
@app.get("/health")
async def health_check():
    """Health-Check Endpoint gemäß Spezifikation."""
    return {
        "service": "opena19",
        "status": "healthy",
        "strict": True,
        "timestamp": datetime.utcnow().isoformat()
    }

# -----------------------------------------------------------------------------
# API: Agent-Registrierung (FIX – neu)
# -----------------------------------------------------------------------------
@app.post("/api/command/register")
@rate_limiter.limit()
async def register_agent_api(
    payload: Dict[str, Any] = Body(...),
    token: HTTPAuthorizationCredentials = Security(security)
):
    """
    Registriert einen Agenten im Dashboard.
    Erwartet JSON: { "agent_id": "...", "endpoint": "http://127.0.0.1:PORT" }
    """
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Ungültiger Token")

    agent_id = (payload or {}).get("agent_id")
    endpoint = (payload or {}).get("endpoint")
    if not agent_id or not endpoint:
        raise HTTPException(status_code=400, detail="agent_id/endpoint fehlen")

    info = await agent_registry.register_agent(agent_id, endpoint)
    await sse_bus.publish({
        "event": "agent_registered",
        "data": {"agent": agent_id, "endpoint": endpoint, "ts": datetime.utcnow().isoformat()}
    })
    return {"strict": True, "status": "registered", "agent": info}

# -----------------------------------------------------------------------------
# API: Status
# -----------------------------------------------------------------------------
@app.get("/api/status/all")
@rate_limiter.limit()
async def get_all_status(
    token: HTTPAuthorizationCredentials = Security(security)
):
    """Status aller registrierten Agenten."""
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Ungültiger Token")
    return {"strict": True, "agents": await agent_registry.get_all_status()}

@app.get("/api/status/{agent}")
@rate_limiter.limit()
async def get_agent_status(
    agent: str,
    token: HTTPAuthorizationCredentials = Security(security)
):
    """Status eines spezifischen Agenten."""
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Ungültiger Token")

    status = await agent_registry.get_agent_status(agent)
    if not status:
        raise HTTPException(status_code=404, detail=f"Agent {agent} nicht gefunden")
    return {"strict": True, "agent": agent, "status": status}

# -----------------------------------------------------------------------------
# API: Commands (Relay an Agent)
# -----------------------------------------------------------------------------
@app.post("/api/command/{agent}")
@rate_limiter.limit()
async def execute_command(
    agent: str,
    command: Dict[str, Any],
    token: HTTPAuthorizationCredentials = Security(security)
):
    """Befehlsausführung mit Token-Validierung."""
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Ungültiger Token")

    try:
        result = await agent_registry.execute_command(agent, command)
        await sse_bus.publish({
            "event": "command_executed",
            "data": {"agent": agent, "command": command.get("action", "unknown")}
        })
        return {"strict": True, "status": "accepted", "result": result}
    except Exception as e:
        logger.error(f"Fehler bei Befehlsausführung: {e}")
        raise HTTPException(status_code=500, detail=str(e))

# -----------------------------------------------------------------------------
# API: SSE
# -----------------------------------------------------------------------------
@app.get("/api/events/live")
async def event_stream(request: Request):
    """SSE-Stream für Live-Events."""
    async def event_generator():
        async for event in sse_bus.subscribe():
            if await request.is_disconnected():
                break
            # EventSourceResponse erwartet (event, data)-Felder
            yield {
                "event": event.get("event", "message"),
                "data": event.get("data", {}),
                "retry": 3000,
            }
    return EventSourceResponse(event_generator())

# -----------------------------------------------------------------------------
# API: Safepoints
# -----------------------------------------------------------------------------
@app.post("/api/safepoints/query")
@rate_limiter.limit()
async def query_safepoints(
    query: Dict[str, Any],
    token: HTTPAuthorizationCredentials = Security(security)
):
    """Safepoint-Suche mit Token-Validierung."""
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Ungültiger Token")
    safepoints = await safepoint_manager.query(query)
    return {"strict": True, "safepoints": safepoints}

@app.get("/api/safepoints/download")
@rate_limiter.limit()
async def download_safepoint(
    path: str,
    token: HTTPAuthorizationCredentials = Security(security)
):
    """Safepoint-Download mit Token-Validierung."""
    if not verify_token(token.credentials):
        raise HTTPException(status_code=401, detail="Ungültiger Token")
    content = await safepoint_manager.get_content(path)
    return {"strict": True, "content": content}

