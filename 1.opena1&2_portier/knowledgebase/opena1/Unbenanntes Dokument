    entry = {
        "sp": sp_name,
        "ts": datetime.now().isoformat(),
        "src": src,
        "dst": dst,
        "kind": kind,
        "path": path,
        "strict": True
    }
    with INDEX_FILE.open("a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")

