def _read_html(name: str) -> str:
    p = Path(name)
    if not p.exists():
        return f"<html><body><h1>{name} fehlt</h1></body></html>"
    return p.read_text(encoding="utf-8")

@app.get("/ui/")
async def dashboard_ui():
    """Dashboard-Hauptseite"""
    return HTMLResponse(_read_html("ui_index.html"))

@app.get("/agent/{agent}")
async def agent_ui(agent: str):
    """Agent-Detailseite (Minimal-Stub)"""
    return HTMLResponse(_read_html("ui_agent.html"))

