#!/usr/bin/env bash
#
# Portier/ELION – Projektbereinigung (Dry-Run standard)
# Ziel: nur Müll weg, Produktivcode & venv bleiben.
#
# Verwendung:
#   ./skripte/portier_clean.sh             # Dry-Run (zeigt nur, was passieren würde)
#   ./skripte/portier_clean.sh --really    # führt Löschungen wirklich aus
#
# Sicherungen:
# - venv-Verzeichnisse werden nicht entfernt (nur Cache-Dateien darin).
# - Safepoint-JSONs in archivp/* werden NUR nach Bestätigung bei --really gelöscht.
# - Ports/Code, die du produktiv nutzt, bleiben unberührt.

set -Eeuo pipefail

# --- Basisverzeichnis: Projektwurzel (Ordner mit diesem Skript) ---
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"

cd "$BASE_DIR"

DRY_RUN=true
if [[ "${1:-}" == "--really" ]]; then
  DRY_RUN=false
elif [[ -n "${1:-}" ]]; then
  echo "Ungültiger Parameter: $1"
  echo "Verwendung: $(basename "$0") [--really]"
  exit 1
fi

# --- Helfer ---
have_cmd() { command -v "$1" >/dev/null 2>&1; }
DO() {
  if "$DRY_RUN"; then
    printf 'DRY-RUN: %s\n' "$*"
  else
    eval "$@"
  fi
}
REMOVE_DIR() {
  local path="$1"
  if "$DRY_RUN"; then
    printf 'DRY-RUN: rm -rf -- %q\n' "$path"
  else
    if have_cmd trash-put; then trash-put "$path"; else rm -rf -- "$path"; fi
  fi
}
REMOVE_FILE() {
  local path="$1"
  if "$DRY_RUN"; then
    printf 'DRY-RUN: rm -f -- %q\n' "$path"
  else
    if have_cmd trash-put; then trash-put "$path"; else rm -f -- "$path"; fi
  fi
}

echo "Projekt: $BASE_DIR"
echo "Modus : $([[ "$DRY_RUN" == true ]] && echo 'Dry-Run' || echo 'AUSFÜHRUNG')"
echo

# --- Whitelist/Schutz ---
# Diese Ordner werden niemals entfernt:
PROTECT_DIRS=(
  "opena1" "opena2" "kordp" "connector" "archivp" "logs" "docs"
  "bin" "skripte" "tests" "venv313" ".venv" "fullstack_app"
)

is_protected_dir() {
  local rel="$1"
  for d in "${PROTECT_DIRS[@]}"; do
    [[ "$rel" == "$d" ]] && return 0
  done
  return 1
}

# --- 1) Leere Ordner + offensichtliche Müllordner entfernen ---
echo "1) Entferne leere Ordner & offensichtliche Cache-Ordner …"
# a) __pycache__, .pytest_cache, .mypy_cache, .ruff_cache
while IFS= read -r -d '' d; do
  REMOVE_DIR "$d"
done < <(find . -type d \( -name "__pycache__" -o -name ".pytest_cache" -o -name ".mypy_cache" -o -name ".ruff_cache" \) -print0)

# b) Leere Ordner (außer geschützte Top-Level)
while IFS= read -r -d '' d; do
  rel="${d#./}"
  top="${rel%%/*}"
  if [[ -z "$top" ]]; then top="$rel"; fi
  if is_protected_dir "$top"; then
    continue
  fi
  REMOVE_DIR "$d"
done < <(find . -type d -empty -print0)

echo

# --- 2) Temporäre/unnötige Dateien löschen ---
echo "2) Entferne temporäre/unnötige Dateien …"
# a) „Unbenanntes Dokument*“ – mehrfach im Projekt gefunden
while IFS= read -r -d '' f; do
  REMOVE_FILE "$f"
done < <(find . -type f \( -name "Unbenanntes Dokument" -o -name "Unbenanntes Dokument "* \) -print0)

# b) Editor/Backup/OS-Müll
while IFS= read -r -d '' f; do
  REMOVE_FILE "$f"
done < <(find . -type f \( -name "*.swp" -o -name "*.swo" -o -name "*~" -o -name "*.bak" -o -name ".DS_Store" -o -name "Thumbs.db" \) -print0)

# c) Kompilierte Python-Dateien (lassen sich jederzeit neu erzeugen)
while IFS= read -r -d '' f; do
  REMOVE_FILE "$f"
done < <(find . -type f -name "*.pyc" -print0)

echo

# --- 3) Venv-Caches aufräumen (nur Dateien, venv bleibt!) ---
echo "3) Räume venv-Caches auf (Dateien), venv-Verzeichnisse bleiben …"
for VENV in "venv313" ".venv"; do
  if [[ -d "$VENV" ]]; then
    # Nur pyc in venv
    while IFS= read -r -d '' f; do
      REMOVE_FILE "$f"
    done < <(find "$VENV" -type f -name "*.pyc" -print0)
    # Leere Ordner in venv
    while IFS= read -r -d '' d; do
      REMOVE_DIR "$d"
    done < <(find "$VENV" -type d -empty -print0)
  fi
done

echo

# --- 4) Logs leeren (Ordner bleiben bestehen) ---
echo "4) Leere Logs-Verzeichnisse …"
for L in "logs" "fullstack_app/logs"; do
  if [[ -d "$L" ]]; then
    while IFS= read -r -d '' f; do
      REMOVE_FILE "$f"
    done < <(find "$L" -type f -print0)
    # leere Log-Unterordner entfernen
    while IFS= read -r -d '' d; do
      REMOVE_DIR "$d"
    done < <(find "$L" -type d -empty -print0)
  fi
done

echo

# --- 5) Safepoint-JSONs (archivp) optional nach Bestätigung löschen ---
echo "5) Safepoint-JSONs optional löschen …"
SAFE_JSONS=()
while IFS= read -r -d '' j; do
  SAFE_JSONS+=("$j")
done < <(find "archivp" -type f -name "SP*_CMD.json" -print0 || true)

if ((${#SAFE_JSONS[@]})); then
  echo "Gefunden: ${#SAFE_JSONS[@]} Safepoint-JSON(s) unter archivp/ …"
  if "$DRY_RUN"; then
    printf 'DRY-RUN zeigt nur an. Zum Löschen: %s --really\n' "$0"
  else
    echo -n "Wirklich ALLE Safepoint-JSONs löschen? [y/N]: "
    read -r ans
    if [[ "$ans" == "y" || "$ans" == "Y" ]]; then
      for j in "${SAFE_JSONS[@]}"; do
        REMOVE_FILE "$j"
      done
    else
      echo "Übersprungen."
    fi
  fi
else
  echo "Keine Safepoint-JSONs gefunden."
fi

echo
echo "✓ Bereinigung abgeschlossen. Modus: $([[ "$DRY_RUN" == true ]] && echo 'Dry-Run' || echo 'AUSFÜHRUNG')"

