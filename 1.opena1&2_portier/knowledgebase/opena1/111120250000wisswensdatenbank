from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import requests
import os

OPENWEBUI_URL = os.getenv("OPENWEBUI_URL") # z. B. http://localhost:8080
TELEGRAM_SERVICE_URL = os.getenv("TELEGRAM_SERVICE_URL") # http://localhost:12346

app = FastAPI(title="OpenWebUI-Telegram Bridge")

class AnalyseRequest(BaseModel):
file: str

@app.post("/analyse")
def analyse(req: AnalyseRequest):
# Beispiel: Relay zur OpenWebUI
resp = requests.post(f"{OPENWEBUI_URL}/api/analyse", json={"file": req.file})
if resp.status_code != 200:
raise HTTPException(status_code=500, detail="Analyse Fehler")
result = resp.json()
# Option: Nachricht an Telegram Agent senden
requests.post(f"{TELEGRAM_SERVICE_URL}/notify", json={"message": f"Analyse abgeschlossen: {req.file}"})
return {"status": "ok", "result": result}

@app.post("/github/webhook")
def github_webhook(payload: dict):
# z. B. nur push Ereignisse
if payload.get("ref", "").endswith("/main"):
# Nachricht an Telegram
requests.post(f"{TELEGRAM_SERVICE_URL}/notify", json={"message": "Neuer Commit auf main: " + payload.get("head_commit", {}).get("message", "")})
return {"status": "received"}

