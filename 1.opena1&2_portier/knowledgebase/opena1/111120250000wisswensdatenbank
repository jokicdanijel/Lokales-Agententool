import os
import logging
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes

OPENWEBUI_API = os.getenv("OPENWEBUI_API_URL") # z. B. http://localhost:12345/api
BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
CHAT_ID = int(os.getenv("TELEGRAM_CHAT_ID", "0"))

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(name)

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
await update.message.reply_text("Hallo! send /analyse <dateiname>")

async def analyse(update: Update, context: ContextTypes.DEFAULT_TYPE):
if not context.args:
await update.message.reply_text("Bitte Dateiname angeben.")
return
filename = context.args[0]
# Beispiel: Anfrage an OpenWebUI API
import requests
payload = {"action": "analyse_file", "file": filename}
resp = requests.post(f"{OPENWEBUI_API}/analyse", json=payload)
if resp.status_code == 200:
result = resp.json().get("result", "Keine Daten")
await update.message.reply_text(f"Analyse Ergebnis:\n{result}")
else:
await update.message.reply_text("Fehler bei Analyse.")

if name == "main":
app = ApplicationBuilder().token(BOT_TOKEN).build()
app.add_handler(CommandHandler("start", start))
app.add_handler(CommandHandler("analyse", analyse))
logger.info("Bot gestartet")
app.run_polling()

