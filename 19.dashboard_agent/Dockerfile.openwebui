FROM python:3.12-slim

WORKDIR /app

# Kopiere Projektordner
COPY 19.dashboard_agent /app

# Installiere Abhängigkeiten
RUN pip install --no-cache-dir -r requirements.txt

# Exponiere Ports
EXPOSE 12349 8080

# Hauptbefehl
CMD ["uvicorn", "main_dashboard:app", "--host", "0.0.0.0", "--port", "12349"]
