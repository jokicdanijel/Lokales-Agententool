# opena8 (WhatsApp Agent) Configuration

# Service
OPENA8_PORT=12351

# Meta API
META_API_VERSION=v20.0
META_PHONE_NUMBER_ID=123456789012345
META_BUSINESS_ACCOUNT_ID=123456789012345
META_ACCESS_TOKEN=EAAxxxxxxxxxx...YOUR_LONG_TOKEN_HERE
META_WEBHOOK_VERIFY_TOKEN=webhook_secret_32chars_min_12345

# Message Processing
MESSAGE_MAX_LENGTH=4096
MEDIA_MAX_SIZE_MB=100

# Classification
ENABLE_CLASSIFICATION=true
ENABLE_SENTIMENT=true

# Security
WHATSAPP_ALLOWLIST=
WHATSAPP_BLOCKLIST=

# Auto-Reply
AUTOREPLY_ENABLED=false

# Archivator & Coordinator
OPENA2_URL=http://127.0.0.1:12345
OPENA1_URL=http://127.0.0.1:12344

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs/opena8

# Metrics
ENABLE_METRICS=true
METRICS_PORT=12351
