# opena7 Mail Agent Configuration
# Copy to .env and customize for your mail server

# Service Identity
OPENA7_PORT=12350

# Archivator & Coordinator Integration
OPENA2_URL=http://127.0.0.1:12345
OPENA1_URL=http://127.0.0.1:12344
ARCHIV_PATH=archivp

# Mail Server — IMAP (Inbound)
MAIL_IMAP_HOST=imap.provider.at
MAIL_IMAP_PORT=993
MAIL_IMAP_SSL=true

# Mail Server — SMTP (Outbound)
MAIL_SMTP_HOST=smtp.provider.at
MAIL_SMTP_PORT=587
MAIL_SMTP_TLS=true

# Credentials (IMPORTANT: Use secret store, never in .env!)
MAIL_USER=bot@example.org
MAIL_PASS_ENVKEY=ENV:MAIL_PASS_TOKEN

# Mail Processing
MAIL_CHECK_INTERVAL=PT5M
MAIL_ATTACHMENT_LIMIT_MB=25
MAIL_BODY_PREVIEW_CHARS=500

# Security & Filtering
MAIL_ALLOWLIST=localhost,127.0.0.1,@example.org,@partners.de
MAIL_BLOCKLIST=spam@badactor.com,noreply@

# Classification & Analysis
ENABLE_SENTIMENT=true
ENABLE_LANGUAGE_DETECTION=true

# Auto-Reply Configuration
AUTOREPLY_ENABLED=false
AUTOREPLY_TEMPLATE=templates/auto_reply.md

# Attachment Handling
SCAN_ATTACHMENTS=true

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs/opena7

# Metrics
ENABLE_METRICS=true
METRICS_PORT=12350
