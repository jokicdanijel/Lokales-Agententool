# .copilot-ignore
# PORTIER 3.0 – CoPilot Ausschlussliste
# Verhindert, dass Copilot sensible oder irrelevante Dateien in Suggestions einbezieht
# Version: 3.0.0 | Stand: 2025-01-19 | Status: GESCHÜTZT

# ============================================================
# ⚠️  WARNUNG: Diese Datei ist Teil des PORTIER 3.0 Systems
# ⚠️  NICHT MODIFIZIEREN ohne Freigabe vom Systemarchitekten
# ============================================================

# Secrets & Environment
.env
.env.*
*.key
*.pem
*.crt
*.pfx
secrets/
credentials/

# Runtime & Temp
runtime/
.runtime/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.log

# Logs
logs/
*.log
*.nohup.log

# Databases
finances.db
*.sqlite
*.sqlite3
*.db

# Archives & Safepoints (zu groß, nicht für Suggestions relevant)
archivp/**/*.json
archivp_store/**/*.json
archivp_store.backup*/**

# Process IDs
*.pid
pids/

# OS-spezifisch
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Backup & Conflicts
_conflicts/
*.backup
*.bak
*.old

# Virtual Environments (bereits im Code, nicht für Suggestions)
venv/
venv*/
.venv/
env/
ENV/

# Git-intern (nicht relevant)
.git/
.gitignore

# Large Data Files
*.csv
*.xlsx
*.json.gz
*.tar.gz
*.zip

# Node Modules (falls vorhanden)
node_modules/

# Docker Build Context (nicht relevant für Code-Suggestions)
.dockerignore
Dockerfile.*

# Test Coverage Reports (analysiert, nicht editierbar)
htmlcov/
.coverage
.pytest_cache/

# System Cache
.mypy_cache/
.ruff_cache/
.tox/

# ============================================================
# PORTIER 3.0 – Zusätzliche Ausschlüsse
# ============================================================

# HTML-Dateien (geschützt, nicht auto-generieren)
**/html/**/*.html
**/html/**/*.css
**/html/**/*.js
hyper_dashboard_ultimate.html

# Systemd Service-Definitionen (nicht modifizieren)
systemd/**/*.service

# Docker Konfigurationen (produktionsstabil)
docker/
docker-compose*.yml
Dockerfile*

# Dokumentation (wird manuell gepflegt)
docs/**/*.md
OPERATIONS.md
TROUBLESHOOTING.md

# Agent-Konfigurationen (strikt geschützt)
**/config.py
**/agent_config.py

# Governance Files (NIEMALS auto-ändern)
.copilot-*
.github/copilot-*.md

# Test-Daten (nicht als Beispiel verwenden)
tests/fixtures/
tests/data/

# Prod-Scripts (nicht vorschlagen)
bin/*.sh
scripts/*.sh
scripts/*.py

# Enterprise Features
enterprise_config.json
MASTER_PROMPTS_*.json

# Session Logs (sensibel)
*_SESSION_*.md
*_REPORT_*.md

# Backup-Ordner
*.backup/
*_backup/
archivp_store.backup*/
