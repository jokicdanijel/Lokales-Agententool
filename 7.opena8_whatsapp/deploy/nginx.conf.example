upstream opena8_backend {
    server 127.0.0.1:12351;
}

server {
    listen 443 ssl http2;
    server_name whatsapp.example.com;

    ssl_certificate /etc/letsencrypt/live/whatsapp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/whatsapp.example.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Webhook endpoint (allow unauthenticated for Meta)
    location = /webhook {
        proxy_pass http://opena8_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }

    # Health check (allow all)
    location = /health {
        proxy_pass http://opena8_backend;
        access_log off;
    }

    # All other endpoints require auth
    location / {
        auth_request /auth;
        proxy_pass http://opena8_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Auth endpoint (validate bearer token)
    location /auth {
        if ($http_authorization ~* "Bearer (.+)") {
            set $auth_token $1;
            return 200;
        }
        return 401;
    }
}

server {
    listen 80;
    server_name whatsapp.example.com;
    return 301 https://$server_name$request_uri;
}
