# opena4 Telegram Agent – Configuration Template
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────────────────────────────────────────
# Telegram Configuration
# ──────────────────────────────────────────────────────────────────────────────

# Telegram Bot Token (get from @BotFather)
# Example: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567890
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram User IDs (comma-separated)
# Get your user ID: send /start to @userinfobot
# Leave empty to allow all users (not recommended)
# Example: 123456789,987654321,555666777
TELEGRAM_ALLOWED_USERS=

# Telegram Webhook URL (optional, for webhook mode)
# If set, Telegram will send updates to this URL
# Example: https://yourdomain.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────────────────────────
# Port & Service Configuration
# ──────────────────────────────────────────────────────────────────────────────

# HTTP Server Port (default: 12347, must be in PORTIER_ALLOWED_PORTS)
PORTIER_PORT=12347

# HTTP Server Host (default: 127.0.0.1, loopback only)
PORTIER_HOST=127.0.0.1

# Base directory for opena4 (default: current working directory)
# Example: /home/user/Gesamtprojekt/6.opena4_telegram
PORTIER_BASE_DIR=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/6.opena4_telegram

# Allowed ports in governance policy (comma-separated)
# Must include PORTIER_PORT
PORTIER_ALLOWED_PORTS=12344,12345,12346,12347,12348,12349

# Forbidden ports (comma-separated) – must NOT include PORTIER_PORT
# 8080 is exclusive for opena3 (OpenWebUI)
PORTIER_FORBIDDEN_PORTS=8080

# ──────────────────────────────────────────────────────────────────────────────
# Integration URLs
# ──────────────────────────────────────────────────────────────────────────────

# Archivator (opena2) endpoint for storing safepoints
# Default: http://127.0.0.1:12348/store/archivp
OPENA2_URL=http://127.0.0.1:12348/store/archivp

# Koordinator (opena1) endpoint for invoking commands
# Default: http://127.0.0.1:12344/invoke
OPENA1_URL=http://127.0.0.1:12344/invoke

# ──────────────────────────────────────────────────────────────────────────────
# Logging Configuration
# ──────────────────────────────────────────────────────────────────────────────

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────────────
# Notes
# ──────────────────────────────────────────────────────────────────────────────

# 1. Create a Telegram Bot:
#    - Open https://t.me/BotFather
#    - Send /newbot
#    - Follow instructions to get your BOT_TOKEN
#
# 2. Get Your User ID:
#    - Open https://t.me/userinfobot
#    - Send /start to get your ID
#    - Add it to TELEGRAM_ALLOWED_USERS
#
# 3. Port-Policy Compliance:
#    - opena4 must use ports in [12344, 12399]
#    - Port 8080 is FORBIDDEN (reserved for opena3)
#    - If violated, service will fail with sys.exit(1)
#
# 4. Safepoint Directory:
#    - All messages are stored as safepoints in archivp/YYYY/MM/DD/
#    - Index maintained in archivp/index.jsonl
#    - Location: $PORTIER_BASE_DIR/archivp/
#
# 5. Archive Format:
#    - Filename: SP<unix_ts>_src→dst_KIND.json
#    - Example: SP1730881234_opena4→opena2_CMD.json
#    - Safepoint contains: {timestamp, src, dst, kind, payload, strict}
