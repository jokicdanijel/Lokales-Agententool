# ═══════════════════════════════════════════════════════════════════════════════
# ELION OPENA21 - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# ⚠️ WARNUNG: Diese Datei enthält Platzhalter für sensible Daten.
# ⚠️ NIEMALS echte API-Keys oder Secrets in Git committen!
# ⚠️ Füge diese Datei zu .gitignore hinzu!
# ═══════════════════════════════════════════════════════════════════════════════

# Agent Configuration
AGENT_ID=opena21
AGENT_NAME=workflow
AGENT_PORT=12367
AGENT_ENV=development

# API Keys (PLATZHALTER - Ersetzen mit echten Werten!)
OPENAI_API_KEY=sk-REPLACE_ME_WITH_REAL_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
GITHUB_TOKEN=ghp_YOUR_GITHUB_TOKEN_HERE

# Database (falls benötigt)
DATABASE_URL=postgresql://user:password@localhost/dbname
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ELION System
ELION_DASHBOARD_URL=http://127.0.0.1:12349
ELION_PORTIER_URL=http://127.0.0.1:12344
ELION_PROFILE_SERVER=http://127.0.0.1:8888

# Integration Chat
INTEGRATION_ENABLED=true
INTEGRATION_CHAT_ENDPOINT=/integration/chat

# ═══════════════════════════════════════════════════════════════════════════════
# HINWEIS: Kopiere diese Datei nach .env.local für lokale Entwicklung
# und ersetze die Platzhalter mit echten Werten.
# ═══════════════════════════════════════════════════════════════════════════════
