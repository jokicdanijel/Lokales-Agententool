[Unit]
Description=ELION opena21 - Workflow Engine Agent
Documentation=https://github.com/elion/portier
After=network.target

[Service]
Type=simple
User=danijel-jd
Group=danijel-jd
WorkingDirectory=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/20.opena21_workflow
Environment="PATH=/home/danijel-jd/.local/bin:/usr/local/bin:/usr/bin"
Environment="BEARER_TOKEN=c899b90d-faf8-485b-afa4-078357cf5313"
Environment="OPENA21_PORT=12367"
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/20.opena21_workflow/logs/opena21.log
StandardError=append:/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/20.opena21_workflow/logs/opena21.error.log

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/20.opena21_workflow/logs
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/20.opena21_workflow/data

[Install]
WantedBy=multi-user.target
