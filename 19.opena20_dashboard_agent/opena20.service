[Unit]
Description=Opena20 Dashboard Agent (Portier System)
Documentation=https://github.com/jokicdanijel/Gesamtprojekt-start
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=danijel-jd
Group=danijel-jd
WorkingDirectory=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent

# Environment Variables
Environment="BEARER_TOKEN=c899b90d-faf8-485b-afa4-078357cf5313"
Environment="PORT=12349"
Environment="OPENA2_URL=http://127.0.0.1:12345"
Environment="PYTHONPATH=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/.venv/lib/python3.13/site-packages"

# Executable
ExecStart=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/.venv/bin/python main_dashboard_final.py
ExecReload=/bin/kill -HUP $MAINPID

# Restart Policy
Restart=on-failure
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=3

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent/logs
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent/data

# Process Management
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opena20

[Install]
WantedBy=multi-user.target
