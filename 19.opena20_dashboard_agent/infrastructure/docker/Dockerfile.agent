FROM python:3.11-slim

ARG AGENT_ID
ENV AGENT_ID=${AGENT_ID}

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy agent code (pattern-based)
# NOTE: Host-side globs may not always work in Docker builds; this is a best-effort scaffold.
COPY *${AGENT_ID}* ./agent/ 2>/dev/null || true

# Copy shared code
COPY src/pkg ./pkg/
COPY config ./config/
COPY artifacts ./artifacts/

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Run agent
CMD ["sh", "-c", "cd agent && python main.py"]
