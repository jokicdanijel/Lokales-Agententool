{
  "service": "opena4",
  "port": 12348,
  "role": "compute",
  "version": "3.1.0",
  "features": {
    "health_check": true,
    "metrics": true,
    "authentication": true,
    "request_tracking": true,
    "error_handling": true,
    "structured_logging": true,
    "rate_limiting": false,
    "sandbox": true,
    "api_auth": true
  },
  "bearer_token": "${OPENA4_BEARER_TOKEN:sk_opena4_compute_v3_production}",
  "max_workers": 4,
  "timeout": 30,
  "log_level": "INFO",
  "endpoints": {
    "health": {
      "path": "/health",
      "method": "GET",
      "auth_required": false,
      "description": "Health status and service information"
    },
    "metrics": {
      "path": "/metrics",
      "method": "GET",
      "auth_required": false,
      "description": "Performance metrics and statistics"
    },
    "compute": {
      "path": "/compute",
      "method": "POST",
      "auth_required": true,
      "description": "Execute computation tasks"
    }
  },
  "monitoring": {
    "track_response_times": true,
    "track_request_count": true,
    "track_error_rate": true,
    "max_metrics_history": 100
  },
  "security": {
    "cors_enabled": true,
    "bearer_token_required": true,
    "request_validation": true,
    "sanitize_input": true
  }
}
