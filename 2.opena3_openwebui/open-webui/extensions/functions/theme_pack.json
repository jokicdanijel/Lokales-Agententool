{
  "version": "1.0.0",
  "name": "Portier UI Theme Pack",
  "description": "Professional UI theme pack for Portier Dashboard",
  "author": "LocalAgentPro",
  "themes": {
    "botfactory": {
      "name": "Bot Factory (Neon Dark Purple)",
      "description": "High-tech neon aesthetic with dark purple base",
      "primary": "#8d3cff",
      "secondary": "#4c1d95",
      "background": "#12001a",
      "panel": "#1e0030",
      "glow": "#c084fc",
      "accent": "#f5d0fe",
      "text_primary": "#FFFFFF",
      "text_secondary": "#E9D5FF",
      "border": "#4c1d95",
      "success": "#34d399",
      "warning": "#fbbf24",
      "error": "#ef4444",
      "info": "#3b82f6"
    },
    "minimal": {
      "name": "Minimal (Grayscale)",
      "description": "Clean, minimal design with grayscale palette",
      "primary": "#222222",
      "secondary": "#333333",
      "background": "#f5f5f5",
      "panel": "#ffffff",
      "glow": "#e5e5e5",
      "accent": "#999999",
      "text_primary": "#1a1a1a",
      "text_secondary": "#666666",
      "border": "#dddddd",
      "success": "#059669",
      "warning": "#d97706",
      "error": "#dc2626",
      "info": "#0284c7"
    },
    "lucid": {
      "name": "Lucid (Light Modern)",
      "description": "Modern light theme with blue accents",
      "primary": "#2563EB",
      "secondary": "#3B82F6",
      "background": "#EFF6FF",
      "panel": "#FFFFFF",
      "glow": "#DBEAFE",
      "accent": "#93C5FD",
      "text_primary": "#1e293b",
      "text_secondary": "#64748b",
      "border": "#e2e8f0",
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#06b6d4"
    },
    "midnight": {
      "name": "Midnight (Dark Blue)",
      "description": "Deep dark theme with cool blue tones",
      "primary": "#0369a1",
      "secondary": "#0c4a6e",
      "background": "#001a33",
      "panel": "#003366",
      "glow": "#0ea5e9",
      "accent": "#38bdf8",
      "text_primary": "#f0f9ff",
      "text_secondary": "#bae6fd",
      "border": "#0c4a6e",
      "success": "#10b981",
      "warning": "#fbbf24",
      "error": "#f87171",
      "info": "#06b6d4"
    },
    "forest": {
      "name": "Forest (Green)",
      "description": "Natural green theme for calm, productive environment",
      "primary": "#059669",
      "secondary": "#047857",
      "background": "#ecfdf5",
      "panel": "#f0fdf4",
      "glow": "#a7f3d0",
      "accent": "#6ee7b7",
      "text_primary": "#064e3b",
      "text_secondary": "#047857",
      "border": "#d1fae5",
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#0284c7"
    }
  },
  "components": {
    "button": {
      "primary": {
        "background": "theme.primary",
        "text": "theme.text_primary",
        "border": "theme.primary",
        "hover": "darken(theme.primary, 10%)"
      },
      "secondary": {
        "background": "theme.panel",
        "text": "theme.text_primary",
        "border": "theme.secondary",
        "hover": "theme.secondary"
      },
      "danger": {
        "background": "theme.error",
        "text": "white",
        "border": "theme.error",
        "hover": "darken(theme.error, 10%)"
      }
    },
    "input": {
      "background": "theme.panel",
      "text": "theme.text_primary",
      "border": "theme.border",
      "placeholder": "theme.text_secondary",
      "focus_border": "theme.primary"
    },
    "card": {
      "background": "theme.panel",
      "border": "1px solid theme.border",
      "shadow": "0 4px 6px rgba(0, 0, 0, 0.1)"
    }
  },
  "variables": {
    "radius": "8px",
    "spacing_xs": "4px",
    "spacing_sm": "8px",
    "spacing_md": "16px",
    "spacing_lg": "24px",
    "spacing_xl": "32px",
    "shadow_sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
    "shadow_md": "0 4px 6px rgba(0, 0, 0, 0.1)",
    "shadow_lg": "0 10px 15px rgba(0, 0, 0, 0.1)",
    "transition": "all 0.3s ease"
  }
}
