{
  "name": "voice-input-copilot",
  "displayName": "Voice Input for Copilot",
  "description": "Real-time voice input integration for GitHub Copilot in VS Code",
  "version": "1.0.0",
  "publisher": "portier",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Productivity",
    "Other"
  ],
  "keywords": [
    "voice",
    "input",
    "copilot",
    "speech-to-text",
    "accessibility"
  ],
  "activationEvents": [
    "onCommand:voiceInput.toggle",
    "onCommand:voiceInput.start",
    "onCommand:voiceInput.stop"
  ],
  "main": "./out/extension-advanced.js",
  "contributes": {
    "commands": [
      {
        "command": "voiceInput.toggle",
        "title": "🎙️ Toggle Voice Recognition",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.start",
        "title": "🎤 Start Voice Recognition",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.stop",
        "title": "⏹️ Stop Voice Recognition",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.showOutput",
        "title": "📋 Show Voice Output",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.showSettings",
        "title": "⚙️ Voice Input Settings",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.switchLanguage",
        "title": "🌐 Switch Language",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.toggleContinuousMode",
        "title": "🔄 Toggle Continuous Mode",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.showAnalytics",
        "title": "📊 Show Analytics",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.exportAnalytics",
        "title": "💾 Export Analytics",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.clearHistory",
        "title": "🗑️ Clear History",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.showHelp",
        "title": "❓ Show Help",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.testMicrophone",
        "title": "🎙️ Test Microphone",
        "category": "Voice Input"
      },
      {
        "command": "voiceInput.resetSettings",
        "title": "🔄 Reset Settings",
        "category": "Voice Input"
      }
    ],
    "keybindings": [
      {
        "command": "voiceInput.toggle",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorFocus"
      },
      {
        "command": "voiceInput.switchLanguage",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorFocus"
      },
      {
        "command": "voiceInput.showAnalytics",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorFocus"
      },
      {
        "command": "voiceInput.exportAnalytics",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorFocus"
      }
    ],
    "configuration": {
      "title": "Voice Input",
      "properties": {
        "voiceInput.languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "de",
              "en",
              "fr",
              "es",
              "it",
              "pt",
              "nl",
              "ja"
            ]
          },
          "default": [
            "de",
            "en"
          ],
          "description": "Supported languages for voice recognition"
        },
        "voiceInput.defaultLanguage": {
          "type": "string",
          "enum": [
            "de",
            "en",
            "fr",
            "es",
            "it",
            "pt",
            "nl",
            "ja"
          ],
          "default": "de",
          "description": "Default language for speech recognition"
        },
        "voiceInput.silenceThreshold": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 10000,
          "description": "Silence threshold in milliseconds before auto-stop"
        },
        "voiceInput.maxDuration": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 300,
          "description": "Maximum recording duration in seconds"
        },
        "voiceInput.autoSend": {
          "type": "boolean",
          "default": false,
          "description": "Automatically send transcripts to Copilot Chat"
        },
        "voiceInput.detectCopilotCommands": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect Copilot commands in transcripts"
        },
        "voiceInput.autoFocusEditor": {
          "type": "boolean",
          "default": true,
          "description": "Auto-focus editor after transcript insertion"
        },
        "voiceInput.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show status bar with recording status"
        },
        "voiceInput.statusBarPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "description": "Status bar position"
        },
        "voiceInput.showOutput": {
          "type": "boolean",
          "default": true,
          "description": "Show output channel with logs"
        },
        "voiceInput.enableSounds": {
          "type": "boolean",
          "default": true,
          "description": "Enable audio feedback sounds"
        },
        "voiceInput.soundVolume": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Sound volume for feedback (0-1)"
        },
        "voiceInput.notifyOnEnd": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when recording ends"
        },
        "voiceInput.continuousMode": {
          "type": "boolean",
          "default": false,
          "description": "Keep listening between recordings"
        },
        "voiceInput.showInterimResults": {
          "type": "boolean",
          "default": true,
          "description": "Show partial transcripts while speaking"
        },
        "voiceInput.confidenceThreshold": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence threshold for accepting results"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {}
}
