# src/mcp_server/main.py
# MCP Server auf Basis FastMCP für ChatGPT &amp; Deep Research

import logging, os
from typing import Dict, List, Any
from fastmcp import FastMCP
from openai import OpenAI

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("mcp_server")

OPENAI_API_KEY = os.environ.get("OPENAI_API_KEY")
VECTOR_STORE_ID = os.environ.get("VECTOR_STORE_ID", "VST_REPLACE_ME")
openai_client = OpenAI()

mcp = FastMCP(
    name="Project MCP Server",
    instructions="Suche &amp; Dokumentabfrage aus privatem Vector Store."
)

@mcp.tool()
async def search(query: str) -&gt; Dict[str, List[Dict[str, Any]]]:
    if not query.strip(): return {"results": []}
    r = openai_client.vector_stores.search(vector_store_id=VECTOR_STORE_ID, query=query)
    results = []
    if hasattr(r, "data"):
        for i, item in enumerate(r.data):
            fid = getattr(item, "file_id", f"doc_{i}")
            title = getattr(item, "filename", f"Document {i+1}")
            snippet = getattr(item, "content", [{}])[0].get("text", "")[:200]
            results.append({
                "id": fid, "title": title, "text": snippet,
                "url": f"https://platform.openai.com/storage/files/{fid}"
            })
    return {"results": results}

@mcp.tool()
async def fetch(id: str) -&gt; Dict[str, Any]:
    if not id: raise ValueError("ID required")
    file_info = openai_client.vector_stores.files.retrieve(vector_store_id=VECTOR_STORE_ID, file_id=id)
    content = openai_client.vector_stores.files.content(vector_store_id=VECTOR_STORE_ID, file_id=id)
    full_text = "\\n".join(c.text for c in content.data if hasattr(c, "text"))
    return {
        "id": id,
        "title": getattr(file_info, "filename", id),
        "text": full_text,
        "url": f"https://platform.openai.com/storage/files/{id}",
        "metadata": getattr(file_info, "attributes", {})
    }

def main():
    port = int(os.environ.get("PORT", "12354"))
    logger.info(f"Starte MCP Server auf Port {port}")
    mcp.run(transport="sse", host="0.0.0.0", port=port)

if __name__ == "__main__":
    main()
"""</span>

