{
  "dashboard": {
    "title": "System Overview - ELION Hyper-Dashboard",
    "description": "Real-time system health and performance metrics",
    "tags": ["elion", "system", "overview"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "title": "Services Online",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [{"expr": "elion_services_online", "refId": "A"}],
        "options": {"colorMode": "background", "graphMode": "none"},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"hideFrom": {"tooltip": false, "viz": false, "legend": false}}, "mappings": [{"type": "value", "options": {"1": {"text": "Up", "color": "green"}, "0": {"text": "Down", "color": "red"}}}]}}
      },
      {
        "title": "Archive Size",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "targets": [{"expr": "elion_archive_size_bytes", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 536870912}, {"color": "red", "value": 1073741824}]}}}
      },
      {
        "title": "Archive Entries",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "targets": [{"expr": "elion_archive_entries_total", "refId": "A", "legendFormat": "{{kind}}"}],
        "options": {"displayLabels": ["name", "value"], "legend": {"displayMode": "table", "placement": "right"}}
      },
      {
        "title": "Error Rate %",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [{"expr": "elion_error_rate_percent", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5}]}}}
      },
      {
        "title": "Requests Per Second",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [{"expr": "rate(elion_service_requests_total[1m])", "refId": "A", "legendFormat": "{{service}}"}],
        "fieldConfig": {"defaults": {"custom": {"lineWidth": 2}}}
      },
      {
        "title": "Service Latency (p95)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [{"expr": "histogram_quantile(0.95, rate(elion_service_response_time_seconds_bucket[5m]))", "refId": "A", "legendFormat": "{{service}}"}],
        "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2}}}
      }
    ],
    "schemaVersion": 38,
    "version": 1
  },
  "overwrite": true
}
