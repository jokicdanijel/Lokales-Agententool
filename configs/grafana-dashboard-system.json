{
  "dashboard": {
    "title": "System Overview",
    "description": "ELION Hyper-Dashboard System Health",
    "tags": ["elion", "system", "overview"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Services Online",
        "type": "gauge",
        "targets": [
          {
            "expr": "elion_services_online",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "max": 20,
            "min": 0
          }
        },
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Requests Per Second",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(elion_service_requests_total[1m])",
            "refId": "A"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 }
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "elion_error_rate_percent",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "max": 1,
            "min": 0
          }
        },
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 }
      },
      {
        "id": 4,
        "title": "Archive Size",
        "type": "stat",
        "targets": [
          {
            "expr": "elion_archive_size_bytes",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        },
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 }
      }
    ],
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 0
  },
  "overwrite": true
}
