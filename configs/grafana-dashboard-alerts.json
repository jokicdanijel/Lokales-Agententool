{
  "dashboard": {
    "title": "Alerts & Thresholds - ELION",
    "description": "Active alerts, alert history, and threshold visualization",
    "tags": ["elion", "alerts", "monitoring"],
    "timezone": "browser",
    "refresh": "10s",
    "panels": [
      {
        "title": "Alert Status (Last Hour)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
        "targets": [
          { "expr": "count(ALERTS{alertstate=\"firing\"}) or 0", "refId": "A" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 3 }
              ]
            }
          }
        },
        "options": { "textMode": "value" }
      },
      {
        "title": "Most Triggered Alert",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
        "targets": [
          {
            "expr": "topk(1, sum by (alertname) (increase(ALERTS[1h])))",
            "refId": "A"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "short" } },
        "options": { "textMode": "value_and_name" }
      },
      {
        "title": "Total Alert Triggers (24h)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
        "targets": [{ "expr": "sum(increase(ALERTS[24h]))", "refId": "A" }],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "title": "Firing Alerts Table",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "ALERTS{alertstate=\"firing\"}",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "__name__": true, "job": true },
              "indexByName": {},
              "renameByName": {
                "alertname": "Alert",
                "severity": "Severity",
                "instance": "Instance"
              }
            }
          }
        ]
      },
      {
        "title": "Alert Frequency (24h)",
        "type": "barchart",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          {
            "expr": "sum by (alertname) (increase(ALERTS[24h]))",
            "refId": "A",
            "legendFormat": "{{alertname}}"
          }
        ],
        "options": { "orientation": "auto" },
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "title": "Alert Rates by Severity",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "sum by (severity) (rate(ALERTS[5m]))",
            "refId": "A",
            "legendFormat": "{{severity}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "lineWidth": 2, "fillOpacity": 10 }
          }
        }
      },
      {
        "title": "Service Availability %",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          {
            "expr": "(sum(elion_service_up) / count(elion_service_up)) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": { "lineWidth": 2 }
          },
          "overrides": [
            {
              "matcher": { "id": "byName" },
              "properties": [
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      { "color": "red", "value": null },
                      { "color": "yellow", "value": 95 },
                      { "color": "green", "value": 99 }
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    ],
    "schemaVersion": 38,
    "version": 1
  },
  "overwrite": true
}
