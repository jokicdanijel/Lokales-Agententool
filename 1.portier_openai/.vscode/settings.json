{
    // Terminal-Grundeinstellungen
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.profiles.linux": {
        "dashboard-env": {
            "path": "bash",
            "args": ["-l"],
            "icon": "terminal-bash"
        }
    },

    // Arbeitsverzeichnis
    "terminal.integrated.cwd": "${workspaceFolder}",
    
    // Umgebungsvariablen für das Projekt
    "terminal.integrated.env.linux": {
        "PROJECT_ROOT": "/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt",
        "PYTHONPATH": "${workspaceFolder}",
        "DASHBOARD_PORT": "12344",
        "VENV_PATH": "${workspaceFolder}/venv313"
    },

    // Vererbung der VS Code Umgebung
    "terminal.integrated.inheritEnv": true,

    // Automation-Profil für Tasks
    "terminal.integrated.automationProfile.linux": {
        "path": "bash",
        "args": ["-l"]
    },

    // Split-Terminal-Verhalten
    "terminal.integrated.splitCwd": "inherited",

    // Python-spezifische Einstellungen
    "python.defaultInterpreterPath": "${workspaceFolder}/venv313/bin/python3",
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],

    // Task-Runner-Einstellungen
    "task.allowAutomaticTasks": true,

    // Editor-Einstellungen für Python
    "[python]": {
        "editor.formatOnSave": true,
        "editor.rulers": [88],
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": true
        }
    },

    // Datei-Ausschlüsse
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/*.pyc": true,
        ".coverage": true,
        "htmlcov": true
    },

    // Workspace-spezifische Erweiterungen
    "recommendations": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "njpwerner.autodocstring"
    ]
}