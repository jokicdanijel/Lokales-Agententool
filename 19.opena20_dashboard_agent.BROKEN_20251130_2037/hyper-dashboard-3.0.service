[Unit]
Description=HYPER-DASHBOARD 3.0 - PORTIER Enterprise Agent
Documentation=https://github.com/jokicdanijel/Gesamtprojekt-start
After=network.target
Wants=network.target

[Service]
Type=simple
User=danijel-jd
Group=danijel-jd
WorkingDirectory=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent

# Main executable - HYPER-DASHBOARD 3.0
ExecStart=/usr/bin/python3 main_dashboard_final.py
ExecReload=/bin/kill -HUP $MAINPID

# Restart configuration
Restart=always
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=30

# Environment variables
Environment=PYTHONPATH=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hyper-dashboard-3.0

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent/data
ReadWritePaths=/home/danijel-jd/Dokumente/Workspace/Projekte/Gesamtprojekt/19.opena20_dashboard_agent/logs
ReadWritePaths=/tmp

# Network
BindPaths=/etc/ssl/certs
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=200%

# Health monitoring
WatchdogSec=30s
NotifyAccess=main

[Install]
WantedBy=multi-user.target
Alias=opena20.service
Alias=dashboard.service